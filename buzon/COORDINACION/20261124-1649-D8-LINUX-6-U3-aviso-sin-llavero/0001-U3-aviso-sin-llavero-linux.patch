@@ -0,0 +1,24 @@
+/* Copyright (c) 2026 The FlyWeb Authors. All rights reserved.
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_LINUX)
+// FlyWeb (U3 §2.1): on Linux the bar means there is no keyring, not a keychain
+// that needs a relaunch: say that passwords and sign-ins are not being saved.
+// The generated header is included first so its own definition is not
+// redefined below.
+#include "brave/grit/brave_generated_resources.h"
+#include "chrome/grit/generated_resources.h"
+#undef IDS_OSCRYPTASYNC_AVAILABILITY_INFOBAR_MESSAGE
+#define IDS_OSCRYPTASYNC_AVAILABILITY_INFOBAR_MESSAGE \
+  IDS_FLYWEB_KEYRING_UNAVAILABLE_INFOBAR_MESSAGE
+#endif
+
+#include "src/chrome/browser/ui/startup/oscryptasync_availability_infobar_delegate.cc"
+
+#if BUILDFLAG(IS_LINUX)
+#undef IDS_OSCRYPTASYNC_AVAILABILITY_INFOBAR_MESSAGE
+#endif
