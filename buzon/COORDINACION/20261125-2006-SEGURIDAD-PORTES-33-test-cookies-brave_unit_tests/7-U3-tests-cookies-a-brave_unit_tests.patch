+// FlyWeb's rules for undecryptable cookie rows in SQLitePersistentCookieStore
+// (patches/net-extras-sqlite-sqlite_persistent_cookie_store.cc.patch). They
+// lived in net_unittests, which does not build in a brave tree
+// (cookie_monster_unittest.cc vs. ChromiumCookieMonster), so they run here,
+// in brave_unit_tests, with a fixture of their own.
+
+#include <algorithm>
+#include <array>
+#include <memory>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/run_loop.h"
+#include "base/strings/strcat.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "base/test/bind.h"
+#include "base/test/task_environment.h"
+#include "base/time/time.h"
+#include "crypto/aes_cbc.h"
+#include "net/cookies/canonical_cookie.h"
+#include "net/cookies/cookie_constants.h"
+#include "net/extras/sqlite/cookie_crypto_delegate.h"
+#include "net/extras/sqlite/sqlite_persistent_cookie_store.h"
+#include "net/log/net_log_source_type.h"
+#include "net/log/net_log_with_source.h"
+#include "sql/database.h"
+#include "sql/statement.h"
+#include "sql/test/test_helpers.h"
+#include "testing/gmock/include/gmock/gmock.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace net {
+
+namespace {
+
+const base::FilePath::CharType kCookieFilename[] = FILE_PATH_LITERAL("Cookies");
+
+// Values starting with this fail as if their key were only temporarily
+// unavailable.
+constexpr std::string_view kTemporarilyUnavailablePrefix = "tmp-no-key";
+
+// While true, the cryptor cannot encrypt a non-empty string, as an Encryptor
+// without any key (U3: unreadable `fw1` key file on Linux).
+bool g_no_encryption_key = false;
+
+constexpr std::array<uint8_t, 32> kFixedKey{
+    'f', 'l', 'y', 'w', 'e', 'b', 'c', 'o', 'o', 'k', 'i',
+    'e', 's', 't', 'o', 'r', 'e', 't', 'e', 's', 't', 'k',
+    'e', 'y', '-', '3', '2', 'b', 'y', 't', 'e', 's',
+};
+constexpr std::array<uint8_t, 16> kFixedIv{
+    't', 'h', 'e', ' ', 'i', 'v', ':', ' ',
+    '1', '6', ' ', 'b', 'y', 't', 'e', 's',
+};
+
+// The same contract as upstream's test CookieCryptor (empty in, empty out),
+// plus FlyWeb's temporary failure.
+class TestCookieCryptor : public CookieCryptoDelegate {
+ public:
+  void Init(base::OnceClosure callback) override {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, std::move(callback));
+  }
+
+  bool EncryptString(const std::string& plaintext,
+                     std::string* ciphertext) override {
+    if (plaintext.empty()) {
+      ciphertext->clear();
+      return true;
+    }
+    if (g_no_encryption_key) {
+      return false;
+    }
+    auto result = crypto::aes_cbc::Encrypt(kFixedKey, kFixedIv,
+                                           base::as_byte_span(plaintext));
+    ciphertext->assign(result.begin(), result.end());
+    return true;
+  }
+
+  bool DecryptString(const std::string& ciphertext,
+                     std::string* plaintext) override {
+    if (ciphertext.empty()) {
+      plaintext->clear();
+      return true;
+    }
+    auto result = crypto::aes_cbc::Decrypt(kFixedKey, kFixedIv,
+                                           base::as_byte_span(ciphertext));
+    if (!result.has_value()) {
+      return false;
+    }
+    plaintext->assign(result->begin(), result->end());
+    return true;
+  }
+
+  bool DecryptStringWithTemporaryFailure(
+      const std::string& ciphertext,
+      std::string* plaintext,
+      bool* temporarily_unavailable) override {
+    *temporarily_unavailable = false;
+    if (ciphertext.starts_with(kTemporarilyUnavailablePrefix)) {
+      *temporarily_unavailable = true;
+      return false;
+    }
+    return DecryptString(ciphertext, plaintext);
+  }
+};
+
+using CanonicalCookieVector = std::vector<std::unique_ptr<CanonicalCookie>>;
+
+std::vector<std::string> Names(const CanonicalCookieVector& cookies) {
+  std::vector<std::string> result;
+  for (const auto& cookie : cookies) {
+    result.push_back(cookie->Name());
+  }
+  std::sort(result.begin(), result.end());
+  return result;
+}
+
+}  // namespace
+
+class FlyWebSQLiteCookieStoreTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(temp_dir_.CreateUniqueTempDir()); }
+
+  void TearDown() override {
+    g_no_encryption_key = false;
+    DestroyStore();
+  }
+
+  base::FilePath db_path() const {
+    return temp_dir_.GetPath().Append(kCookieFilename);
+  }
+
+  CanonicalCookieVector CreateAndLoad() {
+    store_ = base::MakeRefCounted<SQLitePersistentCookieStore>(
+        db_path(), client_task_runner_, background_task_runner_,
+        /*restore_old_session_cookies=*/false,
+        std::make_unique<TestCookieCryptor>(),
+        /*enable_exclusive_access=*/false);
+    base::RunLoop run_loop;
+    CanonicalCookieVector cookies;
+    store_->Load(base::BindLambdaForTesting([&](CanonicalCookieVector loaded) {
+                   cookies.swap(loaded);
+                   run_loop.Quit();
+                 }),
+                 NetLogWithSource::Make(NetLogSourceType::NONE));
+    run_loop.Run();
+    return cookies;
+  }
+
+  void DestroyStore() {
+    store_ = nullptr;
+    // Wait for the backend to close (and commit) on its sequence.
+    task_environment_.RunUntilIdle();
+  }
+
+  void AddCookie(const std::string& name,
+                 const std::string& value,
+                 const std::string& domain,
+                 base::Time creation) {
+    store_->AddCookie(*CanonicalCookie::CreateUnsafeCookieForTesting(
+        name, value, domain, "/", creation, /*expiration=*/creation,
+        /*last_access=*/base::Time(), /*last_update=*/base::Time(),
+        /*secure=*/false, /*httponly=*/false, CookieSameSite::NO_RESTRICTION,
+        COOKIE_PRIORITY_DEFAULT, CookieSourceType::kOther));
+  }
+
+  std::string ReadEncryptedValue(const char* name) {
+    sql::Database db(sql::test::kTestTag);
+    EXPECT_TRUE(db.Open(db_path()));
+    sql::Statement smt(db.GetUniqueStatement(
+        "SELECT encrypted_value FROM cookies WHERE name = ?"));
+    smt.BindString(0, name);
+    EXPECT_TRUE(smt.Step());
+    return smt.ColumnString(0);
+  }
+
+  void SetEncryptedValue(const char* name, std::string_view value) {
+    sql::Database db(sql::test::kTestTag);
+    ASSERT_TRUE(db.Open(db_path()));
+    sql::Statement smt(db.GetUniqueStatement(
+        "UPDATE cookies SET encrypted_value = ? WHERE name = ?"));
+    smt.BindBlob(0, base::as_byte_span(value));
+    smt.BindString(1, name);
+    ASSERT_TRUE(smt.Run());
+  }
+
+  int CountRows(const char* name = nullptr) {
+    sql::Database db(sql::test::kTestTag);
+    EXPECT_TRUE(db.Open(db_path()));
+    if (!name) {
+      sql::Statement smt(
+          db.GetUniqueStatement("SELECT COUNT(*) FROM cookies"));
+      EXPECT_TRUE(smt.Step());
+      return smt.ColumnInt(0);
+    }
+    sql::Statement smt(
+        db.GetUniqueStatement("SELECT COUNT(*) FROM cookies WHERE name = ?"));
+    smt.BindString(0, name);
+    EXPECT_TRUE(smt.Step());
+    return smt.ColumnInt(0);
+  }
+
+  std::string ValueOf(const CanonicalCookieVector& cookies,
+                      std::string_view name) {
+    for (const auto& cookie : cookies) {
+      if (cookie->Name() == name) {
+        return cookie->Value();
+      }
+    }
+    return std::string();
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  const scoped_refptr<base::SequencedTaskRunner> background_task_runner_ =
+      base::ThreadPool::CreateSequencedTaskRunner({base::MayBlock()});
+  const scoped_refptr<base::SequencedTaskRunner> client_task_runner_ =
+      base::ThreadPool::CreateSequencedTaskRunner({base::MayBlock()});
+  base::ScopedTempDir temp_dir_;
+  scoped_refptr<SQLitePersistentCookieStore> store_;
+};
+
+// An unreadable `fw1` value loses only its own row; an unreadable value of any
+// other format still drops the whole eTLD+1, as upstream.
+TEST_F(FlyWebSQLiteCookieStoreTest, UndecryptableFw1DropsOnlyItsRow) {
+  EXPECT_EQ(0U, CreateAndLoad().size());
+  AddCookie("fw1cookie", "value1", "foo.bar", base::Time::Now());
+  AddCookie("v10cookie", "value2", "foo.bar",
+            base::Time::Now() + base::Microseconds(10));
+  DestroyStore();
+
+  SetEncryptedValue("fw1cookie", "fw1-not-decryptable");
+  CanonicalCookieVector cookies = CreateAndLoad();
+  ASSERT_EQ(1U, cookies.size());
+  EXPECT_EQ("v10cookie", cookies[0]->Name());
+  EXPECT_EQ("value2", cookies[0]->Value());
+  cookies.clear();
+  DestroyStore();
+  EXPECT_EQ(1, CountRows());
+
+  SetEncryptedValue("v10cookie", "v10-not-decryptable");
+  cookies = CreateAndLoad();
+  EXPECT_EQ(0U, cookies.size());
+  DestroyStore();
+  EXPECT_EQ(0, CountRows());
+}
+
+// A value whose key is only temporarily unavailable is neither loaded nor
+// deleted, and does not drop its eTLD+1. Without a write for its host_key it
+// is read again on a later start with the key; the first write for its
+// host_key deletes it before the write, so the write is stored and the stale
+// value does not come back. With no key at all (nothing can be written), the
+// row is kept.
+TEST_F(FlyWebSQLiteCookieStoreTest, TemporarilyUndecryptableRowIsKept) {
+  EXPECT_EQ(0U, CreateAndLoad().size());
+  const base::Time t0 = base::Time::Now();
+  AddCookie("locked", "old", "foo.bar", t0);
+  AddCookie("readable", "value2", "foo.bar", t0 + base::Microseconds(10));
+  AddCookie("other", "value3", "www.foo.bar", t0 + base::Microseconds(20));
+  DestroyStore();
+
+  const std::string good_value = ReadEncryptedValue("locked");
+  const std::string locked_value =
+      base::StrCat({kTemporarilyUnavailablePrefix, good_value});
+
+  // 1. Key missing at load, no write: the row stays and nothing else of the
+  // eTLD+1 is lost.
+  SetEncryptedValue("locked", locked_value);
+  CanonicalCookieVector cookies = CreateAndLoad();
+  EXPECT_THAT(Names(cookies), testing::ElementsAre("other", "readable"));
+  cookies.clear();
+  DestroyStore();
+  EXPECT_EQ(1, CountRows("locked"));
+  EXPECT_EQ(1, CountRows("readable"));
+  EXPECT_EQ(1, CountRows("other"));
+
+  // 2. Key back on a later start: the cookie loads with its old value.
+  SetEncryptedValue("locked", good_value);
+  cookies = CreateAndLoad();
+  EXPECT_THAT(Names(cookies),
+              testing::ElementsAre("locked", "other", "readable"));
+  EXPECT_EQ("old", ValueOf(cookies, "locked"));
+  cookies.clear();
+  DestroyStore();
+
+  // 4 (run before 3, it needs the old value on disk). No encryption key at
+  // all this session and the site writes the same cookie: the row must stay,
+  // or it would be lost (U3, D8-LINUX-6 B.2 case 5). It loads again, with its
+  // old value, on a start with the key.
+  SetEncryptedValue("locked", locked_value);
+  g_no_encryption_key = true;
+  cookies = CreateAndLoad();
+  EXPECT_THAT(Names(cookies), testing::ElementsAre("other", "readable"));
+  cookies.clear();
+  AddCookie("locked", "unsaved", "foo.bar", t0 + base::Microseconds(25));
+  DestroyStore();
+  g_no_encryption_key = false;
+  EXPECT_EQ(1, CountRows("locked"));
+  SetEncryptedValue("locked", good_value);
+  cookies = CreateAndLoad();
+  EXPECT_THAT(Names(cookies),
+              testing::ElementsAre("locked", "other", "readable"));
+  EXPECT_EQ("old", ValueOf(cookies, "locked"));
+  cookies.clear();
+  DestroyStore();
+
+  // 3. Key missing again, and the site writes the same cookie: the stale row
+  // is deleted first, so the new value is stored (no unique-index clash).
+  SetEncryptedValue("locked", locked_value);
+  cookies = CreateAndLoad();
+  EXPECT_THAT(Names(cookies), testing::ElementsAre("other", "readable"));
+  cookies.clear();
+  AddCookie("locked", "new", "foo.bar", t0 + base::Microseconds(30));
+  DestroyStore();
+  EXPECT_EQ(1, CountRows("locked"));
+  cookies = CreateAndLoad();
+  EXPECT_THAT(Names(cookies),
+              testing::ElementsAre("locked", "other", "readable"));
+  EXPECT_EQ("new", ValueOf(cookies, "locked"));
+}
+
+}  // namespace net
