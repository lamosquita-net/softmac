+diff --git a/components/password_manager/core/browser/password_store/password_store_built_in_backend.cc b/components/password_manager/core/browser/password_store/password_store_built_in_backend.cc
+index 2aa2dfb47f73ce9ce13a9a809b58b454f0d62c8e..c3c46c9186046029c404d947663afb2a66078ebc 100644
+--- a/components/password_manager/core/browser/password_store/password_store_built_in_backend.cc
++++ b/components/password_manager/core/browser/password_store/password_store_built_in_backend.cc
+@@ -242,6 +242,16 @@ ActionableError PasswordStoreBuiltInBackend::GetError() {
+   if (!is_database_initialized_successfully_) {
+     return ActionableError::kInactionable;
+   }
++#if BUILDFLAG(IS_LINUX)
++  // FlyWeb (U3): without a keyring nothing can be encrypted, so LoginDatabase
++  // silently drops every save. Report it as a keychain error so that
++  // IsAbleToSavePasswords() is false: no "Save password?" bubble and no
++  // generated passwords that would be lost. Mac and Windows reach a similar
++  // state through LoginDatabaseAsyncHelper::Initialize() failing.
++  if (!is_encryption_available_) {
++    return ActionableError::kKeychainError;
++  }
++#endif
+   return sync_observation_.IsObserving()
+              ? SyncErrorToActionableError(
+                    sync_observation_.GetSource()->GetUserActionableError())
+@@ -580,6 +590,9 @@ void PasswordStoreBuiltInBackend::OnEncryptorReceived(
+     base::OnceCallback<void(bool)> completion,
+     scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+   DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
++#if BUILDFLAG(IS_LINUX)
++  is_encryption_available_ = encryptor->IsEncryptionAvailable();
++#endif
+ 
+   // Piggyback on |remote_form_changes_received| to record password deletion
+   // coming from sync.
