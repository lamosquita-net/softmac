+
+namespace os_crypt_async {
+
+namespace {
+
+using KeyResult = base::expected<Encryptor::Key, KeyProvider::KeyError>;
+
+std::vector<uint8_t> GoldenKey() {
+  std::vector<uint8_t> key(Encryptor::Key::kAES256GCMKeySize);
+  for (size_t i = 0; i < key.size(); ++i) {
+    key[i] = static_cast<uint8_t>(i * 7 + 1);
+  }
+  return key;
+}
+
+int Mode(const base::FilePath& path) {
+  struct stat st;
+  EXPECT_EQ(0, lstat(path.value().c_str(), &st));
+  return st.st_mode & 0777;
+}
+
+class Fw1FileKeyProviderTest : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(temp_dir_.CreateUniqueTempDir());
+    key_file_ = temp_dir_.GetPath().Append(Fw1FileKeyProvider::kKeyFileName);
+  }
+
+  KeyResult GetKey() {
+    Fw1FileKeyProvider provider(key_file_);
+    base::test::TestFuture<const std::string&, KeyResult> future;
+    static_cast<KeyProvider&>(provider).GetKey(future.GetCallback());
+    auto [tag, key] = future.Take();
+    EXPECT_EQ("fw1", tag);
+    return std::move(key);
+  }
+
+  // As browser_process_impl.cc registers them: `fw1` from the file, plus
+  // `v10` only with --password-store=basic.
+  scoped_refptr<Encryptor> GetEncryptor(bool with_v10) {
+    std::vector<std::pair<size_t, std::unique_ptr<KeyProvider>>> providers;
+    if (with_v10) {
+      providers.emplace_back(5u, std::make_unique<PosixKeyProvider>());
+    }
+    providers.emplace_back(Fw1FileKeyProvider::kPrecedence,
+                           std::make_unique<Fw1FileKeyProvider>(key_file_));
+    OSCryptAsync os_crypt_async(std::move(providers));
+    base::test::TestFuture<scoped_refptr<Encryptor>> future;
+    os_crypt_async.GetInstance(future.GetCallback());
+    return future.Take();
+  }
+
+  void WriteKeyFile(const std::string& contents) {
+    ASSERT_TRUE(base::WriteFile(key_file_, contents));
+    ASSERT_EQ(0, chmod(key_file_.value().c_str(), 0600));
+  }
+
+  std::string ReadKeyFile() {
+    std::string contents;
+    EXPECT_TRUE(base::ReadFileToString(key_file_, &contents));
+    return contents;
+  }
+
+  size_t CountFiles() {
+    size_t count = 0;
+    base::FileEnumerator files(temp_dir_.GetPath(), /*recursive=*/false,
+                               base::FileEnumerator::FILES);
+    for (base::FilePath path = files.Next(); !path.empty();
+         path = files.Next()) {
+      ++count;
+    }
+    return count;
+  }
+
+  base::test::TaskEnvironment task_environment_{
+      base::test::TaskEnvironment::MainThreadType::UI,
+      base::test::TaskEnvironment::ThreadPoolExecutionMode::ASYNC};
+  base::ScopedTempDir temp_dir_;
+  base::FilePath key_file_;
+};
+
+}  // namespace
+
+TEST_F(Fw1FileKeyProviderTest, CreatesKeyFileOnFirstUse) {
+  ASSERT_TRUE(GetKey().has_value());
+  EXPECT_EQ(0600, Mode(key_file_));
+  const std::string contents = ReadKeyFile();
+  EXPECT_EQ(44u, contents.size());
+  std::optional<std::vector<uint8_t>> raw = base::Base64Decode(contents);
+  ASSERT_TRUE(raw);
+  EXPECT_EQ(Encryptor::Key::kAES256GCMKeySize, raw->size());
+  // No temporary file left behind.
+  EXPECT_EQ(1u, CountFiles());
+}
+
+TEST_F(Fw1FileKeyProviderTest, ReusesKeyAndNeverReplacesIt) {
+  WriteKeyFile(base::Base64Encode(GoldenKey()));
+  const std::string stored = ReadKeyFile();
+  ASSERT_TRUE(GetKey().has_value());
+  ASSERT_TRUE(GetKey().has_value());
+  EXPECT_EQ(stored, ReadKeyFile());
+}
+
+// One key across restarts: what one start encrypts, the next one reads.
+TEST_F(Fw1FileKeyProviderTest, SameKeyAcrossStarts) {
+  std::string ciphertext;
+  ASSERT_TRUE(GetEncryptor(false)->EncryptString("secret", &ciphertext));
+  ASSERT_EQ(0u, ciphertext.find("fw1"));
+  std::string plaintext;
+  Encryptor::DecryptFlags flags;
+  ASSERT_TRUE(
+      GetEncryptor(false)->DecryptString(ciphertext, &plaintext, &flags));
+  EXPECT_EQ("secret", plaintext);
+  EXPECT_FALSE(flags.should_reencrypt);
+}
+
+// Same format as the Mac `fw1` provider: "fw1" + 12-byte nonce +
+// AES-256-GCM with the raw key from the file.
+TEST_F(Fw1FileKeyProviderTest, SameFormatAsMac) {
+  WriteKeyFile(base::Base64Encode(GoldenKey()));
+  std::string ciphertext;
+  ASSERT_TRUE(GetEncryptor(false)->EncryptString("secret", &ciphertext));
+  ASSERT_EQ(0u, ciphertext.find("fw1"));
+  auto data = base::as_byte_span(ciphertext).subspan(3u);
+  auto opened = crypto::aead::Open(crypto::aead::AES_256_GCM, GoldenKey(),
+                                   data.subspan(12u), data.first(12u),
+                                   /*associated_data=*/{});
+  ASSERT_TRUE(opened);
+  EXPECT_EQ("secret", std::string(opened->begin(), opened->end()));
+}
+
+// A corrupt file must not crash, must not be replaced, and must not let
+// anything be encrypted under another key.
+TEST_F(Fw1FileKeyProviderTest, BadFileIsTemporaryAndKept) {
+  for (const std::string& bad :
+       {base::Base64Encode(std::string(16, 'x')), std::string("my_password"),
+        base::Base64Encode(std::string(33, 'x')), std::string(),
+        base::Base64Encode(GoldenKey()) + "\n\n"}) {
+    WriteKeyFile(bad);
+    KeyResult key = GetKey();
+    ASSERT_FALSE(key.has_value());
+    EXPECT_EQ(KeyProvider::KeyError::kTemporarilyUnavailable, key.error());
+    EXPECT_EQ(bad, ReadKeyFile());
+  }
+}
+
+TEST_F(Fw1FileKeyProviderTest, OneTrailingNewlineIsAccepted) {
+  WriteKeyFile(base::Base64Encode(GoldenKey()) + "\n");
+  EXPECT_TRUE(GetKey().has_value());
+}
+
+TEST_F(Fw1FileKeyProviderTest, WidePermissionsAreNarrowed) {
+  WriteKeyFile(base::Base64Encode(GoldenKey()));
+  ASSERT_EQ(0, chmod(key_file_.value().c_str(), 0644));
+  EXPECT_TRUE(GetKey().has_value());
+  EXPECT_EQ(0600, Mode(key_file_));
+}
+
+TEST_F(Fw1FileKeyProviderTest, SymlinkIsRefused) {
+  const base::FilePath target = temp_dir_.GetPath().Append("elsewhere");
+  ASSERT_TRUE(base::WriteFile(target, base::Base64Encode(GoldenKey())));
+  ASSERT_TRUE(base::CreateSymbolicLink(target, key_file_));
+  KeyResult key = GetKey();
+  ASSERT_FALSE(key.has_value());
+  EXPECT_EQ(KeyProvider::KeyError::kTemporarilyUnavailable, key.error());
+  EXPECT_TRUE(base::IsLink(key_file_));
+}
+
+TEST_F(Fw1FileKeyProviderTest, UnwritableDirectoryIsTemporary) {
+  if (geteuid() == 0) {
+    GTEST_SKIP() << "root ignores directory permissions";
+  }
+  ASSERT_EQ(0, chmod(temp_dir_.GetPath().value().c_str(), 0500));
+  KeyResult key = GetKey();
+  ASSERT_EQ(0, chmod(temp_dir_.GetPath().value().c_str(), 0700));
+  ASSERT_FALSE(key.has_value());
+  EXPECT_EQ(KeyProvider::KeyError::kTemporarilyUnavailable, key.error());
+  EXPECT_FALSE(base::PathExists(key_file_));
+}
+
+// --password-store=basic: `v10` written by a test build stays readable and
+// is marked for re-encryption; new data is `fw1`, never `v10`.
+TEST_F(Fw1FileKeyProviderTest, ReadsV10AndEncryptsFw1) {
+  std::string v10;
+  {
+    std::vector<std::pair<size_t, std::unique_ptr<KeyProvider>>> providers;
+    providers.emplace_back(5u, std::make_unique<PosixKeyProvider>());
+    OSCryptAsync os_crypt_async(std::move(providers));
+    base::test::TestFuture<scoped_refptr<Encryptor>> future;
+    os_crypt_async.GetInstance(future.GetCallback());
+    ASSERT_TRUE(future.Take()->EncryptString("old", &v10));
+    ASSERT_EQ(0u, v10.find("v10"));
+  }
+  scoped_refptr<Encryptor> encryptor = GetEncryptor(true);
+  std::string plaintext;
+  Encryptor::DecryptFlags flags;
+  ASSERT_TRUE(encryptor->DecryptString(v10, &plaintext, &flags));
+  EXPECT_EQ("old", plaintext);
+  EXPECT_TRUE(flags.should_reencrypt);
+  std::string rewritten;
+  ASSERT_TRUE(encryptor->EncryptString(plaintext, &rewritten));
+  EXPECT_EQ(0u, rewritten.find("fw1"));
+}
+
+}  // namespace os_crypt_async
