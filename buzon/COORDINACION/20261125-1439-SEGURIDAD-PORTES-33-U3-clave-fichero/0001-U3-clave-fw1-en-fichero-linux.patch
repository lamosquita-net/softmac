diff --git a/components/flyweb_os_crypt/fw1_file_key_provider_linux.cc b/components/flyweb_os_crypt/fw1_file_key_provider_linux.cc
new file mode 100644
index 00000000..66fa6f8b
--- /dev/null
+++ b/components/flyweb_os_crypt/fw1_file_key_provider_linux.cc
@@ -0,0 +1,267 @@
+/* Copyright (c) 2026 lamosquita. All rights reserved.
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+#include "brave/components/flyweb_os_crypt/fw1_file_key_provider_linux.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <array>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/base64.h"
+#include "base/containers/span.h"
+#include "base/files/file.h"
+#include "base/files/scoped_file.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/task/thread_pool.h"
+#include "components/os_crypt/async/common/algorithm.mojom.h"
+#include "crypto/random.h"
+#include "third_party/boringssl/src/include/openssl/mem.h"
+
+namespace os_crypt_async {
+
+namespace {
+
+// Base64 of 32 bytes: 44 characters, the last one '='.
+constexpr size_t kEncodedKeySize = 44u;
+// A key file of ours is never longer; do not read further than this.
+constexpr size_t kMaxFileSize = 64u;
+
+enum class FileResult {
+  kOk,
+  kNotFound,  // ReadKeyFile: no file yet.
+  kExists,    // CreateKeyFile: another writer created it first.
+  kFailed,
+};
+
+void Cleanse(std::string& s) {
+  OPENSSL_cleanse(s.data(), s.size());
+}
+
+void Cleanse(std::vector<uint8_t>& v) {
+  OPENSSL_cleanse(v.data(), v.size());
+}
+
+base::unexpected<KeyProvider::KeyError> Unavailable() {
+  // Never kPermanentlyUnavailable: the file may be readable on the next start
+  // and callers may delete data they think is lost for good.
+  return base::unexpected(KeyProvider::KeyError::kTemporarilyUnavailable);
+}
+
+// Reads `path` into `encoded`. The file must be a regular file of this user,
+// reached without following a symlink. Wider permissions than 0600 are
+// narrowed back, not refused: the key is still ours and refusing it would
+// leave the user without passwords.
+FileResult ReadKeyFile(const base::FilePath& path, std::string& encoded) {
+  base::ScopedFD fd(HANDLE_EINTR(
+      open(path.value().c_str(), O_RDONLY | O_NOFOLLOW | O_CLOEXEC | O_NOCTTY)));
+  if (!fd.is_valid()) {
+    if (errno == ENOENT) {
+      return FileResult::kNotFound;
+    }
+    PLOG(ERROR) << "fw1: cannot open the key file";
+    return FileResult::kFailed;
+  }
+  struct stat st;
+  if (fstat(fd.get(), &st) != 0) {
+    PLOG(ERROR) << "fw1: cannot stat the key file";
+    return FileResult::kFailed;
+  }
+  if (!S_ISREG(st.st_mode) || st.st_uid != geteuid()) {
+    LOG(ERROR) << "fw1: the key file is not a regular file of this user";
+    return FileResult::kFailed;
+  }
+  if ((st.st_mode & (S_IRWXG | S_IRWXO)) != 0) {
+    if (fchmod(fd.get(), S_IRUSR | S_IWUSR) == 0) {
+      LOG(WARNING) << "fw1: key file permissions were wider than 0600; fixed";
+    } else {
+      PLOG(WARNING) << "fw1: cannot restrict the key file to 0600";
+    }
+  }
+
+  base::File file(std::move(fd));
+  std::array<uint8_t, kMaxFileSize + 1> buffer;
+  size_t total = 0;
+  while (total < buffer.size()) {
+    std::optional<size_t> read =
+        file.ReadAtCurrentPos(base::span(buffer).subspan(total));
+    if (!read) {
+      PLOG(ERROR) << "fw1: cannot read the key file";
+      OPENSSL_cleanse(buffer.data(), buffer.size());
+      return FileResult::kFailed;
+    }
+    if (*read == 0) {
+      break;
+    }
+    total += *read;
+  }
+  encoded.assign(buffer.begin(), buffer.begin() + total);
+  OPENSSL_cleanse(buffer.data(), buffer.size());
+  return FileResult::kOk;
+}
+
+// Fallback for file systems without hard links: creates `path` itself with
+// O_EXCL. A crash in the middle could leave a short file, which is then
+// refused (never replaced) rather than misread.
+FileResult CreateKeyFileInPlace(const base::FilePath& path,
+                                const std::string& encoded) {
+  base::ScopedFD fd(HANDLE_EINTR(
+      open(path.value().c_str(),
+           O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC | O_NOCTTY,
+           S_IRUSR | S_IWUSR)));
+  if (!fd.is_valid()) {
+    if (errno == EEXIST) {
+      return FileResult::kExists;
+    }
+    PLOG(ERROR) << "fw1: cannot create the key file";
+    return FileResult::kFailed;
+  }
+  base::File file(std::move(fd));
+  if (!file.WriteAtCurrentPosAndCheck(base::as_byte_span(encoded)) ||
+      !file.Flush()) {
+    PLOG(ERROR) << "fw1: cannot write the key file";
+    file.Close();
+    // Ours, just created and never used: safe to remove.
+    unlink(path.value().c_str());
+    return FileResult::kFailed;
+  }
+  return FileResult::kOk;
+}
+
+// Writes `encoded` to a 0600 temporary file next to `path` and links it to
+// `path`, which fails if `path` exists: an existing key file is never
+// replaced, and a crash never leaves a half-written key file behind.
+FileResult CreateKeyFile(const base::FilePath& path,
+                         const std::string& encoded) {
+  const base::FilePath temp = path.AddExtensionASCII(
+      "tmp-" + base::HexEncode(crypto::RandBytesAsVector(8)));
+  base::ScopedFD fd(HANDLE_EINTR(
+      open(temp.value().c_str(),
+           O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC | O_NOCTTY,
+           S_IRUSR | S_IWUSR)));
+  if (!fd.is_valid()) {
+    PLOG(ERROR) << "fw1: cannot create the key file";
+    return FileResult::kFailed;
+  }
+  base::File file(std::move(fd));
+  const bool written =
+      file.WriteAtCurrentPosAndCheck(base::as_byte_span(encoded)) &&
+      file.Flush();
+  file.Close();
+  if (!written) {
+    PLOG(ERROR) << "fw1: cannot write the key file";
+    unlink(temp.value().c_str());
+    return FileResult::kFailed;
+  }
+
+  const int linked = link(temp.value().c_str(), path.value().c_str());
+  const int link_errno = errno;
+  unlink(temp.value().c_str());
+  if (linked != 0) {
+    if (link_errno == EEXIST) {
+      return FileResult::kExists;
+    }
+    if (link_errno == EPERM || link_errno == EOPNOTSUPP ||
+        link_errno == ENOSYS) {
+      return CreateKeyFileInPlace(path, encoded);
+    }
+    errno = link_errno;
+    PLOG(ERROR) << "fw1: cannot put the key file in place";
+    return FileResult::kFailed;
+  }
+
+  // Make the new directory entry durable before anything is encrypted with
+  // the key. A failure here is logged only: the file is already in place.
+  base::ScopedFD dir(HANDLE_EINTR(open(path.DirName().value().c_str(),
+                                       O_RDONLY | O_DIRECTORY | O_CLOEXEC)));
+  if (!dir.is_valid() || HANDLE_EINTR(fsync(dir.get())) != 0) {
+    PLOG(WARNING) << "fw1: cannot sync the user data directory";
+  }
+  return FileResult::kOk;
+}
+
+}  // namespace
+
+Fw1FileKeyProvider::Fw1FileKeyProvider(const base::FilePath& key_file)
+    : key_file_(key_file) {}
+
+Fw1FileKeyProvider::~Fw1FileKeyProvider() = default;
+
+// static
+base::expected<Encryptor::Key, KeyProvider::KeyError>
+Fw1FileKeyProvider::GetOrCreateKey(const base::FilePath& key_file) {
+  std::string encoded;
+  switch (ReadKeyFile(key_file, encoded)) {
+    case FileResult::kOk:
+      break;
+    case FileResult::kNotFound: {
+      std::vector<uint8_t> raw =
+          crypto::RandBytesAsVector(Encryptor::Key::kAES256GCMKeySize);
+      encoded = base::Base64Encode(raw);
+      Cleanse(raw);
+      const FileResult created = CreateKeyFile(key_file, encoded);
+      if (created == FileResult::kExists) {
+        // Someone else wrote it first: theirs is the key.
+        Cleanse(encoded);
+        if (ReadKeyFile(key_file, encoded) != FileResult::kOk) {
+          Cleanse(encoded);
+          return Unavailable();
+        }
+      } else if (created != FileResult::kOk) {
+        Cleanse(encoded);
+        return Unavailable();
+      }
+      break;
+    }
+    case FileResult::kExists:
+    case FileResult::kFailed:
+      return Unavailable();
+  }
+
+  // Tolerate one trailing newline, in case the file was restored by hand.
+  if (encoded.size() == kEncodedKeySize + 1 && encoded.back() == '\n') {
+    encoded.pop_back();
+  }
+  std::optional<std::vector<uint8_t>> raw;
+  if (encoded.size() == kEncodedKeySize) {
+    raw = base::Base64Decode(encoded);
+  }
+  Cleanse(encoded);
+  if (!raw || raw->size() != Encryptor::Key::kAES256GCMKeySize) {
+    // Never build a Key with another length: Encryptor::Key CHECKs it. The
+    // file is left alone; replacing it would lose whatever it encrypted.
+    LOG(ERROR) << "fw1: the key file is not a 256-bit Base64 key";
+    if (raw) {
+      Cleanse(*raw);
+    }
+    return Unavailable();
+  }
+
+  Encryptor::Key key(*raw, mojom::Algorithm::kAES256GCM);
+  Cleanse(*raw);
+  return key;
+}
+
+void Fw1FileKeyProvider::GetKey(KeyCallback callback) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce(&Fw1FileKeyProvider::GetOrCreateKey, key_file_),
+      base::BindOnce(std::move(callback), std::string(kKeyTag)));
+}
+
+bool Fw1FileKeyProvider::UseForEncryption() {
+  return true;
+}
+
+}  // namespace os_crypt_async
diff --git a/components/flyweb_os_crypt/fw1_file_key_provider_linux.h b/components/flyweb_os_crypt/fw1_file_key_provider_linux.h
