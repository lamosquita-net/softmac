--- /dev/null
+++ b/components/flyweb_os_crypt/fw1_file_key_provider_linux.h
@@ -0,0 +1,66 @@
+/* Copyright (c) 2026 lamosquita. All rights reserved.
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+#ifndef BRAVE_COMPONENTS_FLYWEB_OS_CRYPT_FW1_FILE_KEY_PROVIDER_LINUX_H_
+#define BRAVE_COMPONENTS_FLYWEB_OS_CRYPT_FW1_FILE_KEY_PROVIDER_LINUX_H_
+
+#include <cstddef>
+
+#include "base/files/file_path.h"
+#include "base/types/expected.h"
+#include "components/os_crypt/async/browser/key_provider.h"
+
+namespace os_crypt_async {
+
+// FlyWeb `fw1` key provider for Linux (U3, Titín 25-11): the same AES-256-GCM
+// key and format as on Mac (Base64 of 32 random bytes, used as is), kept in a
+// 0600 file of the user data dir instead of a keyring. The keyring is never
+// asked, so there is no "Unlock Login Keyring" dialog from FlyWeb, no wait on
+// D-Bus at startup, and one key in one place: a key in the keyring next to a
+// key in the file would both be tagged `fw1` and each would make the other's
+// data unreadable.
+//
+// Threat model accepted by Titín: the key protects data copied without the
+// profile (a synced or backed up Cookies or Login Data file), not a stolen
+// computer without disk encryption, nor another process of the same user
+// (Secret Service does not stop those either).
+//
+// Every failure is kTemporarilyUnavailable: callers may delete data on a
+// permanent failure. An existing file is never replaced.
+class Fw1FileKeyProvider : public KeyProvider {
+ public:
+  static constexpr char kKeyTag[] = "fw1";
+  // Above the 5 of upstream's PosixKeyProvider (`v10`), which FlyWeb only
+  // registers with --password-store=basic, to read what it wrote.
+  static constexpr size_t kPrecedence = 20u;
+  static constexpr base::FilePath::CharType kKeyFileName[] =
+      FILE_PATH_LITERAL("FlyWeb Safe Storage");
+
+  // `key_file` is normally <user data dir>/kKeyFileName.
+  explicit Fw1FileKeyProvider(const base::FilePath& key_file);
+
+  Fw1FileKeyProvider(const Fw1FileKeyProvider&) = delete;
+  Fw1FileKeyProvider& operator=(const Fw1FileKeyProvider&) = delete;
+
+  ~Fw1FileKeyProvider() override;
+
+  // Reads the key from `key_file`, creating the file on first use. Blocking.
+  // Never builds a Key from a file of the wrong length (Encryptor::Key CHECKs
+  // the size), never follows a symlink, never reads a file owned by another
+  // user, and never replaces an existing file.
+  static base::expected<Encryptor::Key, KeyError> GetOrCreateKey(
+      const base::FilePath& key_file);
+
+ private:
+  // KeyProvider:
+  void GetKey(KeyCallback callback) override;
+  bool UseForEncryption() override;
+
+  const base::FilePath key_file_;
+};
+
+}  // namespace os_crypt_async
+
+#endif  // BRAVE_COMPONENTS_FLYWEB_OS_CRYPT_FW1_FILE_KEY_PROVIDER_LINUX_H_
