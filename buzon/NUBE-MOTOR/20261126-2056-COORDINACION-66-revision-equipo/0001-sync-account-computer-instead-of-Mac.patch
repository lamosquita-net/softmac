+// A short file of /sys or /proc, trimmed; empty if it cannot be read.
+std::string ReadSmallFile(const char* path, size_t limit) {
+  std::string text;
+  const int fd = HANDLE_EINTR(open(path, O_RDONLY | O_CLOEXEC));
+  if (fd < 0) {
+    return text;
+  }
+  text.resize(limit);
+  size_t used = 0;
+  while (used < limit) {
+    const ssize_t n = HANDLE_EINTR(read(fd, text.data() + used, limit - used));
+    if (n <= 0) {
+      break;
+    }
+    used += static_cast<size_t>(n);
+  }
+  IGNORE_EINTR(close(fd));
+  text.resize(used);
+  return std::string(base::TrimWhitespaceASCII(text, base::TRIM_ALL));
+}
+
+std::string Dmi(const char* field) {
+  return ReadSmallFile(
+      (std::string("/sys/class/dmi/id/") + field).c_str(), 128);
+}
+
+// Board makers' fillers: «System Product Name», «Default string», «x.x»...
+bool IsPlaceholder(std::string_view value) {
+  static constexpr std::string_view kPlaceholders[] = {
+      "System Product Name", "System manufacturer", "System Name",
+      "To be filled by O.E.M.", "Default string", "Not Applicable",
+      "Not Specified", "None", "O.E.M.", "OEM", "Type1ProductConfigId",
+      "Type2 - Board Product Name1", "All Series", "Unknown"};
+  if (value.empty() ||
+      value.find_first_not_of("xX.0 -_") == std::string_view::npos) {
+    return true;
+  }
+  for (std::string_view placeholder : kPlaceholders) {
+    if (base::EqualsCaseInsensitiveASCII(value, placeholder)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// «Micro-Star International Co., Ltd.» → «MSI»; others lose «Co., Ltd.»,
+// «Inc.», «Corporation».
+std::string ShortVendor(std::string vendor) {
+  static constexpr std::pair<std::string_view, std::string_view> kVendors[] = {
+      {"Micro-Star", "MSI"},     {"ASUSTeK", "ASUS"},
+      {"Gigabyte", "Gigabyte"},  {"LENOVO", "Lenovo"},
+      {"Dell", "Dell"},          {"Hewlett-Packard", "HP"},
+      {"HP", "HP"},              {"ASRock", "ASRock"}};
+  if (IsPlaceholder(vendor)) {
+    return std::string();
+  }
+  for (const auto& [prefix, name] : kVendors) {
+    if (base::StartsWith(vendor, prefix,
+                         base::CompareCase::INSENSITIVE_ASCII)) {
+      return std::string(name);
+    }
+  }
+  static constexpr std::string_view kSuffixes[] = {
+      ",", ".", " Co", " Ltd", " Inc", " Corporation", " Corp", " LLC",
+      " GmbH"};
+  for (bool trimmed = true; trimmed;) {
+    trimmed = false;
+    for (std::string_view suffix : kSuffixes) {
+      if (base::EndsWith(vendor, suffix,
+                         base::CompareCase::INSENSITIVE_ASCII)) {
+        vendor.resize(vendor.size() - suffix.size());
+        vendor = std::string(base::TrimWhitespaceASCII(vendor, base::TRIM_ALL));
+        trimmed = true;
+      }
+    }
+  }
+  return vendor;
+}
+
+std::string Join(const std::string& vendor, const std::string& model) {
+  if (vendor.empty() ||
+      base::StartsWith(model, vendor, base::CompareCase::INSENSITIVE_ASCII)) {
+    return model;
+  }
+  return vendor + " " + model;
+}
+
+// Never serial numbers, UUIDs or the machine name: only what names the
+// model, as «MacPro6,1» does on a Mac.
+std::string LinuxModel() {
+  const std::string vendor = ShortVendor(Dmi("sys_vendor"));
+  std::string product = Dmi("product_name");
+  std::string board = Dmi("board_name");
+  if (IsPlaceholder(product)) {
+    product.clear();
+  }
+  if (IsPlaceholder(board)) {
+    board.clear();
+  }
+  if (!product.empty()) {
+    // A bare code that is part of the board's name (MSI «MS-7D98» in
+    // «B760 GAMING PLUS WIFI (MS-7D98)»): the board says more.
+    if (!board.empty() && board != product &&
+        board.find(product) != std::string::npos) {
+      const std::string board_vendor = ShortVendor(Dmi("board_vendor"));
+      return Join(board_vendor.empty() ? vendor : board_vendor, board);
+    }
+    // Lenovo keeps a code in product_name and the model in product_version.
+    const std::string version = Dmi("product_version");
+    if (vendor == "Lenovo" && !IsPlaceholder(version)) {
+      product = version;
+    }
+    return Join(vendor, product);
+  }
+  if (!board.empty()) {
+    return Join(ShortVendor(Dmi("board_vendor")), board);
+  }
+  // No DMI worth showing (some virtual machines): the CPU model.
+  const std::string cpuinfo = ReadSmallFile("/proc/cpuinfo", 4096);
+  for (std::string_view line : base::SplitStringPiece(
+           cpuinfo, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    if (!base::StartsWith(line, "model name")) {
+      continue;
+    }
+    const size_t colon = line.find(':');
+    if (colon == std::string_view::npos) {
+      break;
+    }
+    std::string cpu(base::TrimWhitespaceASCII(line.substr(colon + 1),
+                                              base::TRIM_ALL));
+    for (std::string_view noise : {"(R)", "(TM)", " CPU"}) {
+      base::ReplaceSubstringsAfterOffset(&cpu, 0, noise, "");
+    }
+    if (const size_t at = cpu.find(" @ "); at != std::string::npos) {
+      cpu.resize(at);
+    }
+    return std::string(base::CollapseWhitespaceASCII(cpu, true));
+  }
+  return std::string();
+}
