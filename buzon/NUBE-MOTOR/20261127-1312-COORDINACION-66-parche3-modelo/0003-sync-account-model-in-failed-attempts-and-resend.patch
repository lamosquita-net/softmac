+            spec.body.Set("modelo", DeviceModel());
             self->Call(
                 std::move(spec),
                 base::BindOnce(
@@ -2283,6 +2287,7 @@ void AccountService::ListDevices(AccountCallback callback) {
              if (self && r.ok) {
                if (const base::ListValue* list = r.data.FindList("aparatos")) {
                  self->devices_ = list->Clone();
+                 self->UpdateModelIfChanged();
                }
                self->NotifyStatus();
              }
@@ -2291,6 +2296,39 @@ void AccountService::ListDevices(AccountCallback callback) {
            weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
 }
 
+// The server keeps the model this computer sent when it joined (3.2.2-50 on
+// Linux sent «Mac»). If the list says another one, send DeviceModel() once per
+// run; a server without aparatos/modelo answers 404 and nothing else happens.
+void AccountService::UpdateModelIfChanged() {
+  if (model_update_sent_ || token_.empty()) {
+    return;
+  }
+  const std::string model = DeviceModel();
+  for (const base::Value& v : devices_) {
+    if (!v.is_dict() || !v.GetDict().FindBool("este").value_or(false)) {
+      continue;
+    }
+    if (GetStr(v.GetDict(), "modelo") == model) {
+      return;
+    }
+    model_update_sent_ = true;
+    CallSpec spec;
+    spec.route = "aparatos/modelo";
+    spec.op = "aparatos-modelo";
+    spec.auth = Auth::kToken;
+    spec.body.Set("modelo", model);
+    Call(std::move(spec),
+         base::BindOnce(
+             [](base::WeakPtr<AccountService> self, AccountResult r) {
+               if (self && r.ok) {
+                 self->ListDevices(base::DoNothing());
+               }
+             },
+             weak_ptr_factory_.GetWeakPtr()));
+    return;
+  }
+}
