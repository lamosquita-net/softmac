From 924f04fc2695b1371f48e73d0f091c0d29efe385 Mon Sep 17 00:00:00 2001
From: lamosquita <developer@lamosquita.com>
Date: Wed, 4 Nov 2026 19:52:16 +0100
Subject: [PATCH 3/5] FlyWeb B1d: ANGLE Metal on macOS 10.14 (Metal 2.1)

Added on 156 code, nothing reverted: @available guards with fallbacks for
supportsPullModelInterpolation, supports32BitFloatFiltering and
supportsBCTextureCompression (11), preserveInvariance (11), hasUnifiedMemory
(10.15, isLowPower proxy), renderTargetWidth/Height (10.15); texture swizzle
and render passes without attachments off below 10.15 (ANGLE emulates).
Family checks use supportsFeatureSet: (b404ef0). Guide: metal-mojave.md 3.1.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/libANGLE/renderer/metal/DisplayMtl.mm     | 39 +++++++++++++++++--
 .../renderer/metal/mtl_context_device.mm      |  6 ++-
 .../renderer/metal/mtl_state_cache.mm         |  7 ++++
 src/libANGLE/renderer/metal/mtl_utils.mm      |  5 ++-
 4 files changed, 51 insertions(+), 6 deletions(-)

diff --git a/src/libANGLE/renderer/metal/DisplayMtl.mm b/src/libANGLE/renderer/metal/DisplayMtl.mm
index b309c96..d09b074 100644
--- a/src/libANGLE/renderer/metal/DisplayMtl.mm
+++ b/src/libANGLE/renderer/metal/DisplayMtl.mm
@@ -1019,7 +1019,13 @@ void DisplayMtl::initializeExtensions() const
 
     mNativeExtensions.sampleVariablesOES = true;
 
-    if ([mMetalDevice supportsPullModelInterpolation])
+    // FlyWeb B1d: -supportsPullModelInterpolation is macOS 11+.
+    bool supportsPullModel = false;
+    if (@available(macOS 11.0, macCatalyst 14.0, iOS 14.0, *))
+    {
+        supportsPullModel = [mMetalDevice supportsPullModelInterpolation];
+    }
+    if (supportsPullModel)
     {
         mNativeExtensions.shaderMultisampleInterpolationOES = true;
         mNativeCaps.subPixelInterpolationOffsetBits         = 4;
@@ -1235,8 +1241,19 @@ void DisplayMtl::initializeFeatures()
     // Stencil blit shader is not compiled on Intel & NVIDIA, need investigation.
     ANGLE_FEATURE_CONDITION((&mFeatures), hasShaderStencilOutput, !isIntel() && !isNVIDIA());
 
+    // FlyWeb B1d: MTLTextureSwizzleChannels is macOS 10.15+; ANGLE emulates it otherwise.
+    bool osHasTextureSwizzle = true;
+#if TARGET_OS_OSX
+    if (@available(macOS 10.15, *))
+    {
+    }
+    else
+    {
+        osHasTextureSwizzle = false;
+    }
+#endif
     ANGLE_FEATURE_CONDITION((&mFeatures), hasTextureSwizzle,
-                            supportsEitherGPUFamily(3, 2) && !isSimulator);
+                            supportsEitherGPUFamily(3, 2) && !isSimulator && osHasTextureSwizzle);
 
     ANGLE_FEATURE_CONDITION((&mFeatures), avoidStencilTextureSwizzle, isIntel());
 
@@ -1288,8 +1305,9 @@ void DisplayMtl::initializeFeatures()
     ANGLE_FEATURE_CONDITION((&mFeatures), uploadDataToIosurfacesWithStagingBuffers, isAMD());
 
     // Render passes can be rendered without attachments on Apple4 , mac2 hardware.
+    // FlyWeb B1d: renderTargetWidth/Height and defaultRasterSampleCount are macOS 10.15+.
     ANGLE_FEATURE_CONDITION(&(mFeatures), allowRenderpassWithoutAttachment,
-                            supportsEitherGPUFamily(4, 2));
+                            supportsEitherGPUFamily(4, 2) && osHasTextureSwizzle);
 
     ANGLE_FEATURE_CONDITION((&mFeatures), enableInMemoryMtlLibraryCache, true);
     ANGLE_FEATURE_CONDITION((&mFeatures), enableParallelMtlLibraryCompilation, true);
@@ -1377,7 +1395,11 @@ bool DisplayMtl::supportsEitherGPUFamily(uint8_t iOSFamily, uint8_t macFamily) c
 bool DisplayMtl::supports32BitFloatFiltering() const
 {
 #if !TARGET_OS_WATCH
-    return [mMetalDevice supports32BitFloatFiltering];
+    if (@available(macOS 11.0, macCatalyst 14.0, iOS 14.0, *))
+    {
+        return [mMetalDevice supports32BitFloatFiltering];
+    }
+    return true;  // FlyWeb B1d: macOS 10.14, Mac GPUs filter 32-bit float.
 #else
     return false;
 #endif
@@ -1385,6 +1407,15 @@ bool DisplayMtl::supports32BitFloatFiltering() const
 
 bool DisplayMtl::supportsBCTextureCompression() const
 {
+#if TARGET_OS_OSX
+    if (@available(macOS 11.0, *))
+    {
+    }
+    else
+    {
+        return true;  // FlyWeb B1d: macOS 10.14, BC is native on Mac GPUs.
+    }
+#endif
     if (@available(macCatalyst 16.4, iOS 16.4, *))
     {
         return [mMetalDevice supportsBCTextureCompression];
diff --git a/src/libANGLE/renderer/metal/mtl_context_device.mm b/src/libANGLE/renderer/metal/mtl_context_device.mm
index 6aa02c0..1b42a09 100644
--- a/src/libANGLE/renderer/metal/mtl_context_device.mm
+++ b/src/libANGLE/renderer/metal/mtl_context_device.mm
@@ -134,7 +134,11 @@ void ContextDevice::setOwnerWithIdentity(id<MTLResource> resource) const
 
 bool ContextDevice::hasUnifiedMemory() const
 {
-    return [get() hasUnifiedMemory];
+    if (@available(macOS 10.15, macCatalyst 13.1, iOS 13.0, *))
+    {
+        return [get() hasUnifiedMemory];
+    }
+    return [get() isLowPower];  // FlyWeb B1d: macOS 10.14 proxy (integrated GPU).
 }
 
 }  // namespace mtl
diff --git a/src/libANGLE/renderer/metal/mtl_state_cache.mm b/src/libANGLE/renderer/metal/mtl_state_cache.mm
index ec81f97..d559d1f 100644
--- a/src/libANGLE/renderer/metal/mtl_state_cache.mm
+++ b/src/libANGLE/renderer/metal/mtl_state_cache.mm
@@ -627,6 +627,13 @@ void RenderPassDesc::convertToMetalDesc(MTLRenderPassDescriptor *objCDesc,
     ToObjC(depthAttachment, objCDesc.depthAttachment);
     ToObjC(stencilAttachment, objCDesc.stencilAttachment);
 
+    if (@available(macOS 10.15, macCatalyst 13.1, iOS 12.0, *))
+    {
+    }
+    else
+    {
+        return;  // FlyWeb B1d: renderTargetWidth/Height are macOS 10.15+.
+    }
     if ((defaultWidth | defaultHeight) != 0)
     {
         objCDesc.renderTargetWidth        = defaultWidth;
diff --git a/src/libANGLE/renderer/metal/mtl_utils.mm b/src/libANGLE/renderer/metal/mtl_utils.mm
index 7f516f5..3afa403 100644
--- a/src/libANGLE/renderer/metal/mtl_utils.mm
+++ b/src/libANGLE/renderer/metal/mtl_utils.mm
@@ -907,7 +907,10 @@ angle::ObjCPtr<id<MTLLibrary>> CreateShaderLibrary(
         angle::ObjCPtr options  = angle::adoptObjCPtr([[MTLCompileOptions alloc] init]);
 
         // Mark all positions in VS with attribute invariant as non-optimizable
-        options.get().preserveInvariance = usesInvariance;
+        if (@available(macOS 11.0, macCatalyst 14.0, iOS 14.0, *))
+        {
+            options.get().preserveInvariance = usesInvariance;
+        }  // FlyWeb B1d: macOS 10.14 has no preserveInvariance.
 
 // mathMode and mathFloatingPointFunctions are only available with macOS 15+ and iPhoneOS 18+
 #if __MAC_OS_X_VERSION_MAX_ALLOWED >= 150000 || __IPHONE_OS_VERSION_MAX_ALLOWED >= 180000 || \
-- 
