<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Políticas de FlyWeb:
  - V8 sin JIT por defecto (DefaultJavaScriptJitSetting = 2) y sitios que sí pueden usarlo (JavaScriptJitAllowedForSites).
  - Safe Browsing estándar (SafeBrowsingProtectionLevel = 1), por el proxy propio de ns2: Google ve la IP del servidor,
    no la del usuario, y nada pasa por Brave (decisión del HUMANO, 03/10). Antes estaba apagado (0) porque consultaba
    servidores de Brave/Google. **Instalar esta versión solo cuando** el proxy esté en producción
    (FlyWeb/servidor/e0, «Propuesta: proxy») y el navegador lleve el paso 35 de integracion.md (nube/proxies-propios)
    y build.sh con safebrowsing_api_endpoint; con un navegador anterior iría directo a Google.
  - Brave Wallet y Brave Rewards desactivados (BraveWalletDisabled, BraveRewardsDisabled).
  Instalar: doble clic y aceptar en Preferencias del Sistema > Perfiles. Ver brave://policy.
  La granularidad es el sitio (eTLD+1): "[*.]google.com" cubre mail.google.com y docs.google.com.
  Edita la lista según las mediciones de F3A.2 (docs/TAREAS.md).
  Chromium lee las políticas del dominio del bundle id: net.lamosquita.flyweb (Release) y
  net.lamosquita.flyweb.development (builds Static/Component, marca de desarrollo).
  **Un bloque (payload) por dominio:** Mojave solo aplica el primer dominio si van dos en el mismo bloque
  (comprobado por LOCAL en la MacPro6,1 el 01/10). Los dos bloques deben ser iguales salvo el dominio, el
  identificador y el UUID: al cambiar uno, copiarlo al otro.
-->
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadType</key>
			<string>com.apple.ManagedClient.preferences</string>
			<key>PayloadIdentifier</key>
			<string>net.lamosquita.flyweb.policy.jit</string>
			<key>PayloadUUID</key>
			<string>ACD9E45D-F91A-42EA-A58B-15C875D9953D</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadDisplayName</key>
			<string>FlyWeb: JIT, Safe Browsing y servicios de Brave</string>
			<key>PayloadContent</key>
			<dict>
				<key>net.lamosquita.flyweb</key>
				<dict>
					<key>Forced</key>
					<array>
						<dict>
							<key>mcx_preference_settings</key>
							<dict>
								<key>DefaultJavaScriptJitSetting</key>
								<integer>2</integer>
								<key>SafeBrowsingProtectionLevel</key>
								<integer>1</integer>
								<key>BraveWalletDisabled</key>
								<true/>
								<key>BraveRewardsDisabled</key>
								<true/>
								<key>JavaScriptJitAllowedForSites</key>
								<array>
									<string>[*.]claude.ai</string>
									<string>[*.]google.com</string>
								</array>
							</dict>
						</dict>
					</array>
				</dict>
			</dict>
		</dict>
		<dict>
			<key>PayloadType</key>
			<string>com.apple.ManagedClient.preferences</string>
			<key>PayloadIdentifier</key>
			<string>net.lamosquita.flyweb.development.policy.jit</string>
			<key>PayloadUUID</key>
			<string>5B7E2C91-3F4A-4D6E-9B1C-7A2D8E4F6C03</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadDisplayName</key>
			<string>FlyWeb (desarrollo): JIT, Safe Browsing y servicios de Brave</string>
			<key>PayloadContent</key>
			<dict>
				<key>net.lamosquita.flyweb.development</key>
				<dict>
					<key>Forced</key>
					<array>
						<dict>
							<key>mcx_preference_settings</key>
							<dict>
								<key>DefaultJavaScriptJitSetting</key>
								<integer>2</integer>
								<key>SafeBrowsingProtectionLevel</key>
								<integer>1</integer>
								<key>BraveWalletDisabled</key>
								<true/>
								<key>BraveRewardsDisabled</key>
								<true/>
								<key>JavaScriptJitAllowedForSites</key>
								<array>
									<string>[*.]claude.ai</string>
									<string>[*.]google.com</string>
								</array>
							</dict>
						</dict>
					</array>
				</dict>
			</dict>
		</dict>
	</array>
	<key>PayloadDisplayName</key>
	<string>FlyWeb: políticas</string>
	<key>PayloadIdentifier</key>
	<string>net.lamosquita.flyweb.policy</string>
	<key>PayloadOrganization</key>
	<string>lamosquita</string>
	<key>PayloadScope</key>
	<string>User</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>8D376FE6-4309-4D0B-AF85-9123E9D03221</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>
