# Destino en ns1: /etc/sudoers.d/flyweb-servidor (root:root 0440). Lo instala SOLO el HUMANO (sudo visudo -cf sudoers-ns1).
# Solo la zona lamosquita.net (registros de *.flyweb). Cambiar /etc/bind/zones/lamosquita.net.hosts por la ruta real del fichero de zona.
Cmnd_Alias FW_DNS = sudoedit /etc/bind/zones/lamosquita.net.hosts, /usr/bin/named-checkzone lamosquita.net /etc/bind/zones/lamosquita.net.hosts, /usr/sbin/rndc reload lamosquita.net
Defaults:servidor !visiblepw, log_subcmds
servidor ALL=(root) NOPASSWD: FW_DNS
