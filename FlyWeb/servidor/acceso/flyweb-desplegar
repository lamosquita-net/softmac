#!/bin/bash
# Destino en ns2: /usr/local/sbin/flyweb-desplegar (root:root 0755). Lo instala y lo cambia SOLO el HUMANO, a mano:
# no se actualiza desde el repo, así que un repo comprometido no puede ampliar lo que SERVIDOR hace como root.
# Única vía de SERVIDOR (usuario «servidor», sudoers-ns2) para poner ficheros como root. Cada orden comprueba su
# SHA-256 antes de tocar nada y deja una línea en /var/log/flyweb-deploy/desplegar.log.
#
#   flyweb-desplegar binario components|sync <sha256>        binario de la release del repo -> /opt/flyweb-<x>/, reinicia
#   flyweb-desplegar dmg FlyWeb-<versión>.dmg <sha256>        /var/www/FlyWeb/updates/ -> descargas/ de la web (nunca sustituye)
#   flyweb-desplegar web <commit> <fichero> <sha256>   FlyWeb/web/<fichero> de ese commit -> la web; <fichero>: las páginas
#                        (index, privacidad, cifras, novedades, ayuda, ayuda/sincronizar), estilo.css, img/circulo.svg, img/mosca.svg y
#                        fuentes/JetBrainsMono.woff2 + su OFL. NUNCA JavaScript (js/ lo instala el HUMANO, root:root)
#   flyweb-desplegar borrar updates|descargas FlyWeb-<versión>.dmg   solo si quedan más de 10 DMG en esa carpeta, no está
#                        en el appcast y no es FlyWeb-1.0.dmg (decisiones del HUMANO, 05/06-10)
#   flyweb-desplegar cifras   ~servidor/.local/state/flyweb-cifras/cifras.csv -> la web, solo si cada línea es una cifra
#   flyweb-desplegar imagen <nombre>.png <sha256>   ~servidor/privado/<nombre>.png -> img/ de la web, para lo que no puede estar
#                        en el repo público (p. ej. el NIF del aviso legal). Solo PNG de hasta 20 KB y 400x100 px; sustituye con copia
set -euo pipefail
umask 022
PATH=/usr/sbin:/usr/bin:/sbin:/bin
REL=https://github.com/lamosquita-net/softmac/releases/download
RAW=https://raw.githubusercontent.com/lamosquita-net/softmac
WEB=/var/www/flyweb.lamosquita.net
UPD=/var/www/FlyWeb/updates
MAX_DMG=10
DUENO=supermosquita:lamosquita
REG=/var/log/flyweb-deploy/desplegar.log
install -d -m 0750 -o root -g adm /var/log/flyweb-deploy
registrar () { echo "$(date -u +%FT%TZ) ${SUDO_USER:-root} $*" >> "$REG"; }
uso () { sed -n '7,16p' "$0" >&2; exit 2; }
sha_ok () { [[ $1 =~ ^[0-9a-f]{64}$ ]]; }
# Imagen privada: PNG pequeño. Firma, IHDR, bytes y píxeles; nada más puede ser «una imagen» para este modo.
imagen_ok () {
  local f=$1 w h; local -a p
  (( $(stat -c %s "$f") <= 20480 )) || { echo "imagen: más de 20 KB" >&2; return 1; }
  [[ $(head -c 8 "$f" | od -An -tx1 | tr -d ' \n') == 89504e470d0a1a0a ]] || { echo "imagen: no es un PNG" >&2; return 1; }
  [[ $(od -An -tx1 -j12 -N4 "$f" | tr -d ' \n') == 49484452 ]] || { echo "imagen: PNG sin IHDR" >&2; return 1; }
  read -r -a p < <(od -An -tu1 -j16 -N8 "$f")
  w=$(( p[0]*16777216 + p[1]*65536 + p[2]*256 + p[3] )); h=$(( p[4]*16777216 + p[5]*65536 + p[6]*256 + p[7] ))
  (( w >= 1 && w <= 400 && h >= 1 && h <= 100 )) || { echo "imagen: ${w}x${h} px (máximo 400x100)" >&2; return 1; }
}
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

case ${1:-} in
binario)
  [[ $# -eq 3 ]] && sha_ok "$3" || uso
  case $2 in components) rel=go-update; bin=flyweb-components ;; sync) rel=flyweb-sync; bin=flyweb-sync ;; *) uso ;; esac
  curl -fsSL --proto =https -o "$tmp/$bin" "$REL/$rel/$bin"
  echo "$3  $tmp/$bin" | sha256sum -c --quiet
  dest=/opt/$bin/$bin
  [[ -f $dest ]] && cp -p "$dest" "$dest.anterior"
  install -D -m 0755 -o root -g root "$tmp/$bin" "$dest"
  systemctl restart "$bin"; sleep 3
  if ! systemctl is-active --quiet "$bin"; then
    [[ -f $dest.anterior ]] && cp -p "$dest.anterior" "$dest" && systemctl restart "$bin"
    registrar "FALLO binario $2 $3 (vuelta al anterior)"; exit 1
  fi
  registrar "ok binario $2 $3" ;;
dmg)
  [[ $# -eq 3 ]] && sha_ok "$3" && [[ $2 =~ ^FlyWeb-[0-9]+(\.[0-9]+){1,3}\.dmg$ ]] || uso
  orig=/var/www/FlyWeb/updates/$2; dest=$WEB/descargas/$2
  if [[ -e $dest ]]; then echo "ya existe $dest: no se sustituye (cada DMG nuevo = versión nueva)" >&2; exit 1; fi
  echo "$3  $orig" | sha256sum -c --quiet
  install -m 0644 -o "${DUENO%:*}" -g "${DUENO#*:}" "$orig" "$dest"
  registrar "ok dmg $2 $3" ;;
web)
  [[ $# -eq 4 ]] && sha_ok "$4" && [[ $2 =~ ^[0-9a-f]{40}$ ]] || uso
  # Nunca JS: los instala el HUMANO a mano en js/ (root:root), ver web-auto/README.md.
  case $3 in index.html|privacidad.html|estilo.css|cifras.html|novedades.html|ayuda/index.html|ayuda/sincronizar/index.html|img/circulo.svg|img/mosca.svg|fuentes/JetBrainsMono.woff2|fuentes/OFL-JetBrainsMono.txt) ;; *) uso ;; esac
  f=${3//\//_}
  curl -fsSL --proto =https -o "$tmp/$f" "$RAW/$2/FlyWeb/web/$3"
  echo "$4  $tmp/$f" | sha256sum -c --quiet
  [[ -f $WEB/$3 ]] && cp -p "$WEB/$3" "/var/backups/flyweb-web-$f.$(date -u +%Y%m%d%H%M%S)"
  d=$(dirname "$WEB/$3"); [[ -d $d ]] || install -d -m 0755 -o "${DUENO%:*}" -g "${DUENO#*:}" "$d"
  install -m 0644 -o "${DUENO%:*}" -g "${DUENO#*:}" "$tmp/$f" "$WEB/$3"
  registrar "ok web $2 $3 $4" ;;
borrar)
  [[ $# -eq 3 ]] && [[ $2 == updates || $2 == descargas ]] && [[ $3 =~ ^FlyWeb-[0-9]+(\.[0-9]+){1,3}\.dmg$ ]] || uso
  case $2 in updates) dir=$UPD ;; descargas) dir=$WEB/descargas ;; esac
  [[ $3 == FlyWeb-1.0.dmg ]] && { echo "FlyWeb-1.0.dmg no se borra (decisión del HUMANO)" >&2; exit 1; }
  grep -qF "/$3\"" "$UPD/stable/appcast.xml" && { echo "$3 está en el appcast: no se borra" >&2; exit 1; }
  [[ -f $dir/$3 && ! -L $dir/$3 ]] || { echo "no existe $dir/$3" >&2; exit 1; }
  n=$(find "$dir" -maxdepth 1 -type f -name 'FlyWeb-*.dmg' | wc -l)
  (( n > MAX_DMG )) || { echo "en $dir hay $n DMG (máximo $MAX_DMG): no se borra nada" >&2; exit 1; }
  s=$(sha256sum "$dir/$3" | cut -d' ' -f1)
  rm -f -- "$dir/$3"
  registrar "ok borrar $2 $3 $s" ;;
cifras)
  [[ $# -eq 1 ]] || uso
  f=/home/servidor/.local/state/flyweb-cifras/cifras.csv
  # Se lee COMO «servidor» (no como root), con tiempo y bytes limitados: un enlace en la ruta, un FIFO o /dev/zero no dan
  # a root nada que servidor no pueda leer ni cuelgan el script (mismo arreglo que el modo imagen).
  timeout 10 runuser -u servidor -- head -c 1048577 -- "$f" > "$tmp/cifras.csv" || { echo "no se puede leer $f" >&2; exit 1; }
  (( $(stat -c %s "$tmp/cifras.csv") <= 1048576 )) || { echo "$f es demasiado grande" >&2; exit 1; }
  # Solo cifras: cabecera fija y «fecha,tipo,dmg,número». Nada que el navegador pueda interpretar.
  [[ $(head -1 "$tmp/cifras.csv") == fecha,tipo,dmg,descargas ]] \
    && ! tail -n +2 "$tmp/cifras.csv" | grep -qvE '^[0-9]{4}-[0-9]{2}-[0-9]{2},(web,FlyWeb-[0-9]+(\.[0-9]+){1,3}\.dmg|act,FlyWeb-[0-9]+(\.[0-9]+){1,3}\.dmg|ninguna,-),[0-9]{1,9}$' \
    || { echo "cifras.csv con líneas que no son cifras: no se publica" >&2; exit 1; }
  install -m 0644 -o "${DUENO%:*}" -g "${DUENO#*:}" "$tmp/cifras.csv" "$WEB/cifras.csv"
  registrar "ok cifras $(sha256sum "$tmp/cifras.csv" | cut -d' ' -f1)" ;;
imagen)
  [[ $# -eq 3 ]] && sha_ok "$3" && [[ $2 =~ ^[a-z0-9][a-z0-9-]{0,31}\.png$ ]] || uso
  src=/home/servidor/privado/$2
  # Se lee COMO «servidor» (no como root), con tiempo y bytes limitados: un enlace en la ruta, un FIFO o /dev/zero no dan
  # a root nada que servidor no pueda leer ni cuelgan el script. Se valida e instala la COPIA (lo comprobado es lo publicado).
  timeout 10 runuser -u servidor -- head -c 20481 -- "$src" > "$tmp/$2" || { echo "no se puede leer $src" >&2; exit 1; }
  imagen_ok "$tmp/$2" || exit 1
  echo "$3  $tmp/$2" | sha256sum -c --quiet
  dest=$WEB/img/$2
  [[ -f $dest ]] && cp -p "$dest" "/var/backups/flyweb-web-img_$2.$(date -u +%Y%m%d%H%M%S)"
  install -m 0644 -o "${DUENO%:*}" -g "${DUENO#*:}" "$tmp/$2" "$dest"
  registrar "ok imagen $2 $3" ;;
*) uso ;;
esac
