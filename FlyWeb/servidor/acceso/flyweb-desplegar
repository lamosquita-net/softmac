#!/bin/bash
# Destino en ns2: /usr/local/sbin/flyweb-desplegar (root:root 0755). Lo instala y lo cambia SOLO el HUMANO, a mano:
# no se actualiza desde el repo, así que un repo comprometido no puede ampliar lo que SERVIDOR hace como root.
# Única vía de SERVIDOR (usuario «servidor», sudoers-ns2) para poner ficheros como root. Cada orden comprueba su
# SHA-256 antes de tocar nada y deja una línea en /var/log/flyweb-deploy/desplegar.log.
#
#   flyweb-desplegar binario components|sync <sha256>        binario de la release del repo -> /opt/flyweb-<x>/, reinicia
#   flyweb-desplegar dmg FlyWeb-<versión>.dmg <sha256>        /var/www/FlyWeb/updates/ -> descargas/ de la web (nunca sustituye)
#   flyweb-desplegar web <commit> <fichero> <sha256>   FlyWeb/web/<fichero> de ese commit -> la web; <fichero>: index.html,
#                        privacidad.html, estilo.css, ayuda/index.html o ayuda/sincronizar/index.html
#   flyweb-desplegar borrar updates|descargas FlyWeb-<versión>.dmg   solo si quedan más de 10 DMG en esa carpeta, no está
#                        en el appcast y no es FlyWeb-1.0.dmg (decisiones del HUMANO, 05/06-10)
set -euo pipefail
umask 022
PATH=/usr/sbin:/usr/bin:/sbin:/bin
REL=https://github.com/lamosquita-net/softmac/releases/download
RAW=https://raw.githubusercontent.com/lamosquita-net/softmac
WEB=/var/www/flyweb.lamosquita.net
UPD=/var/www/FlyWeb/updates
MAX_DMG=10
DUENO=supermosquita:lamosquita
REG=/var/log/flyweb-deploy/desplegar.log
install -d -m 0750 -o root -g adm /var/log/flyweb-deploy
registrar () { echo "$(date -u +%FT%TZ) ${SUDO_USER:-root} $*" >> "$REG"; }
uso () { sed -n '7,12p' "$0" >&2; exit 2; }
sha_ok () { [[ $1 =~ ^[0-9a-f]{64}$ ]]; }
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

case ${1:-} in
binario)
  [[ $# -eq 3 ]] && sha_ok "$3" || uso
  case $2 in components) rel=go-update; bin=flyweb-components ;; sync) rel=flyweb-sync; bin=flyweb-sync ;; *) uso ;; esac
  curl -fsSL --proto =https -o "$tmp/$bin" "$REL/$rel/$bin"
  echo "$3  $tmp/$bin" | sha256sum -c --quiet
  dest=/opt/$bin/$bin
  [[ -f $dest ]] && cp -p "$dest" "$dest.anterior"
  install -D -m 0755 -o root -g root "$tmp/$bin" "$dest"
  systemctl restart "$bin"; sleep 3
  if ! systemctl is-active --quiet "$bin"; then
    [[ -f $dest.anterior ]] && cp -p "$dest.anterior" "$dest" && systemctl restart "$bin"
    registrar "FALLO binario $2 $3 (vuelta al anterior)"; exit 1
  fi
  registrar "ok binario $2 $3" ;;
dmg)
  [[ $# -eq 3 ]] && sha_ok "$3" && [[ $2 =~ ^FlyWeb-[0-9]+(\.[0-9]+){1,3}\.dmg$ ]] || uso
  orig=/var/www/FlyWeb/updates/$2; dest=$WEB/descargas/$2
  if [[ -e $dest ]]; then echo "ya existe $dest: no se sustituye (cada DMG nuevo = versión nueva)" >&2; exit 1; fi
  echo "$3  $orig" | sha256sum -c --quiet
  install -m 0644 -o "${DUENO%:*}" -g "${DUENO#*:}" "$orig" "$dest"
  registrar "ok dmg $2 $3" ;;
web)
  [[ $# -eq 4 ]] && sha_ok "$4" && [[ $2 =~ ^[0-9a-f]{40}$ ]] || uso
  case $3 in index.html|privacidad.html|estilo.css|ayuda/index.html|ayuda/sincronizar/index.html) ;; *) uso ;; esac
  f=${3//\//_}
  curl -fsSL --proto =https -o "$tmp/$f" "$RAW/$2/FlyWeb/web/$3"
  echo "$4  $tmp/$f" | sha256sum -c --quiet
  [[ -f $WEB/$3 ]] && cp -p "$WEB/$3" "/var/backups/flyweb-web-$f.$(date -u +%Y%m%d%H%M%S)"
  d=$(dirname "$WEB/$3"); [[ -d $d ]] || install -d -m 0755 -o "${DUENO%:*}" -g "${DUENO#*:}" "$d"
  install -m 0644 -o "${DUENO%:*}" -g "${DUENO#*:}" "$tmp/$f" "$WEB/$3"
  registrar "ok web $2 $3 $4" ;;
borrar)
  [[ $# -eq 3 ]] && [[ $2 == updates || $2 == descargas ]] && [[ $3 =~ ^FlyWeb-[0-9]+(\.[0-9]+){1,3}\.dmg$ ]] || uso
  case $2 in updates) dir=$UPD ;; descargas) dir=$WEB/descargas ;; esac
  [[ $3 == FlyWeb-1.0.dmg ]] && { echo "FlyWeb-1.0.dmg no se borra (decisión del HUMANO)" >&2; exit 1; }
  grep -qF "/$3\"" "$UPD/stable/appcast.xml" && { echo "$3 está en el appcast: no se borra" >&2; exit 1; }
  [[ -f $dir/$3 && ! -L $dir/$3 ]] || { echo "no existe $dir/$3" >&2; exit 1; }
  n=$(find "$dir" -maxdepth 1 -type f -name 'FlyWeb-*.dmg' | wc -l)
  (( n > MAX_DMG )) || { echo "en $dir hay $n DMG (máximo $MAX_DMG): no se borra nada" >&2; exit 1; }
  s=$(sha256sum "$dir/$3" | cut -d' ' -f1)
  rm -f -- "$dir/$3"
  registrar "ok borrar $2 $3 $s" ;;
*) uso ;;
esac
