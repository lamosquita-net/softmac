#!/bin/bash
# SV.6 (SERVIDOR-LOCAL, 05-10-2026): publica sola en flyweb.lamosquita.net la versión que el HUMANO aprueba en bak.
# Corre en ns2 como el usuario «servidor», con un temporizador de systemd de usuario (flyweb-web-auto.timer, cada
# 10 min). Clase de cambio autorizada en E3 por el HUMANO (docs/SERVIDOR.md §3).
#
# Publica solo si TODO cuadra; si no, no toca nada y avisa:
#   1. La versión más alta del appcast (lo escribe bak al firmar) es la de FlyWeb/web/VERSION en main.
#   2. El DMG de updates/ mide lo que dice el appcast, su SHA-256 es el de VERSION y la firma EdDSA del appcast
#      valida con la clave pública FIJADA aquí (no se lee del repo).
#   3. La portada de main enlaza ese DMG y muestra ese SHA-256.
# Entonces: DMG a descargas/ (flyweb-desplegar dmg, nunca sustituye) y cada página de main que haya cambiado
# (flyweb-desplegar web <commit> <fichero> <sha256>). Así también llegan los cambios de la ayuda.
#
#   flyweb-web-auto comprobar     dice qué haría, sin publicar ni avisar
#   flyweb-web-auto ejecutar      lo que lanza el temporizador
# Registro: ~/.local/state/flyweb-web-auto/registro.log y journal (journalctl --user -u flyweb-web-auto).
set -euo pipefail
umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
MODO=${1:-comprobar}
REPO=https://github.com/lamosquita-net/softmac
RAW=https://raw.githubusercontent.com/lamosquita-net/softmac
APPCAST=/var/www/FlyWeb/updates/stable/appcast.xml
UPD=/var/www/FlyWeb/updates
WEB=/var/www/flyweb.lamosquita.net
FICHEROS="index.html privacidad.html estilo.css ayuda/index.html ayuda/sincronizar/index.html"
CLAVE_ED25519=I+N32uIF9KsQFRt2rt+qcYZKjEqMOyZ0PbUtam80xkw=      # FlyWeb/servidor/actualizaciones/clave-publica.txt
AVISO=admin@lamosquita.net                                     # vacío = sin correo
case $MODO in comprobar|ejecutar) ;; *) echo "uso: flyweb-web-auto comprobar|ejecutar" >&2; exit 2 ;; esac
CLAVE="" V_CORTA="?"
EST=$HOME/.local/state/flyweb-web-auto; mkdir -p "$EST"
REG=$EST/registro.log
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
exec 9>"$EST/cerrojo"; flock -n 9 || exit 0

log () { echo "$(date -Is) $*" | tee -a "$REG"; }
avisar () {  # avisar <clave única> <asunto> <cuerpo>: un correo por clave, no en cada pasada
  [[ $MODO == ejecutar && -n $AVISO ]] || return 0
  grep -qxF "$1" "$EST/avisados" 2>/dev/null && return 0
  printf 'To: %s\nSubject: [FlyWeb web] %s\nContent-Type: text/plain; charset=utf-8\n\n%s\n\n-- flyweb-web-auto en ns2 (SV.6)\n' \
    "$AVISO" "$2" "$3" | /usr/sbin/sendmail -t && echo "$1" >> "$EST/avisados"
}
parar () { log "PARADO: $1"; avisar "parado:$CLAVE:$1" "no se publica $V_CORTA" "$1"; exit 1; }

# 1. Versión más alta del appcast
read -r V_CORTA V_LARGA DMG LONG FIRMA < <(python3 - "$APPCAST" <<'PY'
import sys, os, xml.etree.ElementTree as ET
S='{http://www.andymatuschak.org/xml-namespaces/sparkle}'
it=[e for e in ET.parse(sys.argv[1]).iter('enclosure')]
k=lambda e: tuple(int(x) for x in e.get(S+'version').split('.'))
e=max(it, key=k)
print(e.get(S+'shortVersionString'), e.get(S+'version'), os.path.basename(e.get('url')), e.get('length'), e.get(S+'edSignature'))
PY
)
[[ $DMG =~ ^FlyWeb-[0-9]+(\.[0-9]+){1,3}\.dmg$ ]] || { log "appcast raro: $DMG"; exit 1; }

# 2. Commit de main (una petición a GitHub por pasada) y si algo ha cambiado desde la última
C=$(timeout 30 git ls-remote "$REPO" refs/heads/main | cut -f1) || { log "sin respuesta de GitHub"; exit 0; }
[[ $C =~ ^[0-9a-f]{40}$ ]] || { log "commit raro: $C"; exit 1; }
CLAVE="$C $V_LARGA"
[[ $MODO == ejecutar ]] && grep -qxF "$CLAVE" "$EST/hecho" 2>/dev/null && exit 0

# 3. VERSION de main = versión aprobada
curl -fsSL --proto =https -o "$tmp/VERSION" "$RAW/$C/FlyWeb/web/VERSION" || parar "main no tiene FlyWeb/web/VERSION"
read -r W_CORTA W_LARGA W_DMG W_SHA < "$tmp/VERSION"
if [[ $W_LARGA != "$V_LARGA" || $W_CORTA != "$V_CORTA" || $W_DMG != "$DMG" ]]; then
  log "esperando: appcast $V_CORTA ($V_LARGA), main describe $W_CORTA ($W_LARGA); no se publica nada"
  avisar "espera:$CLAVE" "la web aún no tiene el texto de la $V_CORTA" \
    "El appcast anuncia $V_CORTA ($V_LARGA), pero FlyWeb/web/VERSION de main ($C) es $W_CORTA ($W_LARGA). Se publicará sola cuando se fusione el PR de la web de la $V_CORTA."
  [[ $MODO == ejecutar ]] && echo "$CLAVE" >> "$EST/hecho"
  exit 0
fi
[[ $W_SHA =~ ^[0-9a-f]{64}$ ]] || parar "SHA-256 raro en VERSION"

# 4. DMG: tamaño, SHA-256 y firma EdDSA
[[ -f $UPD/$DMG ]] || parar "no está $UPD/$DMG"
[[ $(stat -c %s "$UPD/$DMG") == "$LONG" ]] || parar "$DMG no mide lo que dice el appcast ($LONG)"
SHA=$(sha256sum "$UPD/$DMG" | cut -d' ' -f1)
[[ $SHA == "$W_SHA" ]] || parar "SHA-256 de $DMG ($SHA) distinto del de VERSION ($W_SHA)"
{ printf '\x30\x2a\x30\x05\x06\x03\x2b\x65\x70\x03\x21\x00'; echo "$CLAVE_ED25519" | base64 -d; } > "$tmp/clave.der"
echo "$FIRMA" | base64 -d > "$tmp/firma.bin"
openssl pkeyutl -verify -pubin -keyform DER -inkey "$tmp/clave.der" -rawin -in "$UPD/$DMG" -sigfile "$tmp/firma.bin" >/dev/null 2>&1 \
  || parar "la firma EdDSA de $DMG NO valida con la clave pública fijada"

# 5. Páginas de main: bajar, comprobar la portada y ver cuáles cambian
CAMBIAN=""
for f in $FICHEROS; do
  n=${f//\//_}
  curl -fsSL --proto =https -o "$tmp/$n" "$RAW/$C/FlyWeb/web/$f" || parar "no se pudo bajar $f de $C"
  s=$(sha256sum "$tmp/$n" | cut -d' ' -f1)
  [[ -f $WEB/$f && $(sha256sum "$WEB/$f" | cut -d' ' -f1) == "$s" ]] || CAMBIAN+="$f:$s "
done
grep -qF "descargas/$DMG" "$tmp/index.html" && grep -qF "$SHA" "$tmp/index.html" \
  || parar "la portada de $C no enlaza $DMG con su SHA-256"
NUEVO_DMG=no; [[ -f $WEB/descargas/$DMG ]] || NUEVO_DMG=si
if [[ -f $WEB/descargas/$DMG && $(sha256sum "$WEB/descargas/$DMG" | cut -d' ' -f1) != "$SHA" ]]; then
  parar "descargas/$DMG ya existe con otro contenido (cada DMG nuevo = versión nueva)"
fi

if [[ $MODO == comprobar ]]; then
  echo "appcast: $V_CORTA ($V_LARGA) $DMG; main $C describe la misma; firma EdDSA y SHA-256 OK"
  echo "DMG nuevo en descargas/: $NUEVO_DMG"; echo "páginas que cambiarían: ${CAMBIAN:-ninguna}"
  exit 0
fi
[[ $NUEVO_DMG == no && -z $CAMBIAN ]] && { echo "$CLAVE" >> "$EST/hecho"; exit 0; }

# 6. Publicar
HECHO=""
if [[ $NUEVO_DMG == si ]]; then
  sudo -n /usr/local/sbin/flyweb-desplegar dmg "$DMG" "$SHA"; HECHO+="descargas/$DMG "
fi
for x in $CAMBIAN; do
  sudo -n /usr/local/sbin/flyweb-desplegar web "$C" "${x%%:*}" "${x#*:}"; HECHO+="${x%%:*} "
done

# 7. Comprobar desde el propio ns2
r () { curl -sk -o /dev/null -w '%{http_code}' --resolve flyweb.lamosquita.net:443:127.0.0.1 "https://flyweb.lamosquita.net$1"; }
P=$(r /); D=$(r "/descargas/$DMG"); A=$(r /ayuda/)
curl -sk --resolve flyweb.lamosquita.net:443:127.0.0.1 https://flyweb.lamosquita.net/ | grep -qF "descargas/$DMG" && E=si || E=no
log "PUBLICADO $V_CORTA ($V_LARGA) desde $C: $HECHO| portada $P, DMG $D, ayuda $A, portada enlaza el DMG: $E"
echo "$CLAVE" >> "$EST/hecho"
avisar "publicado:$CLAVE" "publicada la $V_CORTA en flyweb.lamosquita.net" \
  "Versión: $V_CORTA ($V_LARGA), DMG $DMG, SHA-256 $SHA (firma EdDSA comprobada).
Commit de la web: $C
Publicado: $HECHO
Comprobación en ns2: portada $P, DMG $D, ayuda $A, la portada enlaza el DMG: $E.
Registro: /var/log/flyweb-deploy/desplegar.log. SERVIDOR-LOCAL lo anotará en CAMBIOS.md."
[[ $P == 200 && $D == 200 && $E == si ]] || exit 1
