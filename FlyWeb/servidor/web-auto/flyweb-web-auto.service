# Destino en ns2: ~servidor/.config/systemd/user/flyweb-web-auto.service (unidad de USUARIO de «servidor»; SV.6)
[Unit]
Description=FlyWeb: publicar en la web la versión aprobada (SV.6)
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/bin/flyweb-web-auto ejecutar
# Sin NoNewPrivileges: el script usa «sudo flyweb-desplegar» (lo único que puede hacer como root).
PrivateTmp=no
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=idle
