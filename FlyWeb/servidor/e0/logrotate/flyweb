# Destino: /etc/logrotate.d/flyweb
# 7 días de registros (sin IP ni User-Agent); después se borran.
/var/log/flyweb/*.log {
    daily
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    create 640 root adm
    sharedscripts
    postrotate
        if invoke-rc.d apache2 status > /dev/null 2>&1; then
            invoke-rc.d apache2 reload > /dev/null 2>&1
        fi
    endscript
}
