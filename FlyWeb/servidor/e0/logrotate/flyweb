# Destino: /etc/logrotate.d/flyweb  (si el logrotate de Apache del HUMANO no cubre ya /var/log/flyweb)
# 7 días; updates. y components. no llevan IP, flyweb.lamosquita.net sí (decisión del HUMANO).
/var/log/flyweb/*/*.log {
    daily
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    create 640 root adm
    sharedscripts
    postrotate
        if invoke-rc.d apache2 status > /dev/null 2>&1; then
            invoke-rc.d apache2 reload > /dev/null 2>&1
        fi
    endscript
}
