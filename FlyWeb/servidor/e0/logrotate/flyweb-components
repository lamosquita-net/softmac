# Destino: /etc/logrotate.d/flyweb-components
# 7 días de registros con IP (los necesita CrowdSec); después se borran.
/var/log/flyweb-components/*.log {
    daily
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    create 640 root adm
    sharedscripts
    postrotate
        if invoke-rc.d apache2 status > /dev/null 2>&1; then
            invoke-rc.d apache2 reload > /dev/null 2>&1
        fi
    endscript
}
