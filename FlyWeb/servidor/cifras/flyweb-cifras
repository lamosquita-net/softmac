#!/bin/bash
# Cifras de FlyWeb (SERVIDOR-NUBE, 06-10-2026; decisión del HUMANO): cuántas veces se descarga cada versión, sin
# guardar quién. Corre en ns2 como «servidor» (grupo adm: lee los registros), con un temporizador de usuario cada hora (desde el 07-10).
#   web: descargas completas de descargas/FlyWeb-*.dmg en la web (registro con IP, 14 días; aquí solo se cuenta).
#   act: descargas completas de FlyWeb-*.dmg en updates. (registro sin IP): cada Mac baja cada versión una vez al
#        actualizarse, así que es la mejor aproximación a cuántos FlyWeb están en uso.
# Guarda solo «fecha,tipo,dmg,descargas» (cifras.csv), lo publica en la web (flyweb-desplegar cifras, que valida que
# solo haya cifras) y los lunes manda un resumen por correo.
#   flyweb-cifras diario     lo que lanza el temporizador (cuenta los días que falten y vuelve a contar ayer y hoy, publica
#                            y, el lunes, el correo)
#   flyweb-cifras ver        resumen en pantalla, sin publicar ni mandar nada
set -euo pipefail
umask 077
export LC_ALL=C
PATH=/usr/sbin:/usr/bin:/sbin:/bin
MODO=${1:-ver}
case $MODO in diario|ver) ;; *) echo "uso: flyweb-cifras diario|ver" >&2; exit 2 ;; esac
EST=$HOME/.local/state/flyweb-cifras; mkdir -p "$EST"
CSV=$EST/cifras.csv
WEBLOG=/var/log/flyweb/flyweb.lamosquita.net/apache_access.log
UPDLOG=/var/log/flyweb/updates/apache_access.log
APPCAST=/var/www/FlyWeb/updates/stable/appcast.xml
AVISO=admin@lamosquita.net
# Solo en ns2, nunca en el repo: la oficina no cuenta en la web. OFI = fichero local con UN nombre de host (0600, lo pone el HUMANO);
# HIST = «segundos IP» cada hora, 14 días, nunca publicado; IPCSV = números por día y versión, nunca publicado: IP distintas (webip),
# descargas incompletas (webinc, actinc) y contadas sin poder comprobar (websin, actsin).
OFI=$HOME/.config/flyweb-cifras/oficina
HIST=$EST/oficina.hist
IPCSV=$EST/ip.csv
exec 9>"$EST/cerrojo"; flock -n 9 || exit 0
[[ -f $CSV ]] || echo "fecha,tipo,dmg,descargas" > "$CSV"
[[ -f $IPCSV ]] || echo "fecha,tipo,dmg,ips" > "$IPCSV"

# Los rotados de ns2 son .1 … .5 sin comprimir (y .gz si los hubiera): zcat -f lee los dos.
leer () { local f; for f in "$1" "$1".{1..9} "$1".{1..9}.gz; do [[ -f $f ]] && zcat -f -- "$f"; done; return 0; }

# Solo cuentan las descargas COMPLETAS: GET con 200 y «%b» (bytes servidos) >= tamaño del DMG en disco. Apache también registra
# 200 cuando el cliente corta a mitad (y entonces %b es menor). Los 206 (reanudaciones) no cuentan, como antes. Si el DMG ya no
# está en disco, la petición cuenta como antes y se marca (tipo «sin»). Por versión se imprime «C n ips dmg» (completas, con las
# IP distintas solo en la web), «I n 0 dmg» (incompletas: no cuentan) y «S n 0 dmg» (contadas sin poder comprobar).
# Web: además sin robots (por el UA) y sin las líneas de la IP de la oficina en las horas en que lo era (±90 min de una
# anotación de HIST). Las IP se cuentan en memoria y se descartan: no se imprime ni se guarda ninguna.
FILTRO=$(cat <<'PY'
import sys, re, os, glob, collections, datetime
modo = sys.argv[1]
tam = {}
for d in ('/var/www/flyweb.lamosquita.net/descargas', '/var/www/FlyWeb/updates'):
    for f in glob.glob(d + '/FlyWeb-*.dmg'):
        m = re.search(r'FlyWeb-([0-9]+(?:\.[0-9]+){1,3})\.dmg$', f)
        if m: tam.setdefault(m.group(1), os.path.getsize(f))
hist = collections.defaultdict(list)
if modo == 'web':
    try:
        for l in open(sys.argv[2]):
            p = l.split()
            if len(p) == 2: hist[p[1]].append(int(p[0]))
    except (OSError, ValueError):
        pass
if modo == 'web':
    RE = re.compile(r'^(\S+) \S+ \S+ \[([^\]]+)\] "GET /descargas/(FlyWeb-([0-9]+(?:\.[0-9]+){1,3})\.dmg) HTTP/[0-9.]+" 200 (\d+|-)')
else:
    RE = re.compile(r'^()\[([^\]]+)\] "GET /(FlyWeb-([0-9]+(?:\.[0-9]+){1,3})\.dmg) HTTP/[0-9.]+" 200 (\d+|-)')
ROB = re.compile(r'bot|crawl|spider|curl|wget|python', re.I)
C = collections.Counter(); I = collections.Counter(); S = collections.Counter(); ips = collections.defaultdict(set)
for l in sys.stdin:
    if modo == 'web' and ROB.search(l): continue
    m = RE.match(l)
    if not m: continue
    ip, ts, dmg, ver, b = m.groups()
    if ip and ip in hist:
        t = datetime.datetime.strptime(ts, '%d/%b/%Y:%H:%M:%S %z').timestamp()
        if any(abs(t - x) <= 5400 for x in hist[ip]): continue
    size = tam.get(ver); b = 0 if b == '-' else int(b)
    if size is None: C[dmg] += 1; S[dmg] += 1; ips[dmg].add(ip)
    elif b >= size: C[dmg] += 1; ips[dmg].add(ip)
    else: I[dmg] += 1
for d in sorted(C): print('C', C[d], len(ips[d]) if modo == 'web' else 0, d)
for d in sorted(I): print('I', I[d], 0, d)
for d in sorted(S): print('S', S[d], 0, d)
PY
)
contar_web () { leer "$WEBLOG" | grep -F "[$1:" | python3 -I -c "$FILTRO" web "$HIST" || true; }
contar_upd () { leer "$UPDLOG" | grep -F "[$1:" | python3 -I -c "$FILTRO" upd || true; }

# IP de la oficina: resuelve el host de OFI (si existe) y anota «segundos IP»; 14 días; 0600; nunca se publica.
anotar_oficina () {
  [[ -r $OFI ]] || return 0
  local host ip ahora; ahora=$(date +%s)
  host=$(grep -vE '^[[:space:]]*(#|$)' "$OFI" | head -1 | tr -d '[:space:]')
  [[ $host =~ ^[A-Za-z0-9.-]{1,253}$ ]] || return 0
  for ip in $(getent ahosts "$host" 2>/dev/null | awk '{print $1}' | sort -u | head -4); do
    [[ $ip =~ ^[0-9A-Fa-f:.]{3,45}$ ]] && echo "$ahora $ip" >> "$HIST"
  done
  [[ -f $HIST ]] && { awk -v lim=$(( ahora - 14*86400 )) '$1 >= lim' "$HIST" > "$HIST.nuevo" || true; mv "$HIST.nuevo" "$HIST"; }
  return 0
}

contar_dia () {  # contar_dia <aaaa-mm-dd>: añade sus líneas si no estaban
  local d=$1 ap k n i f hay=0
  grep -q "^$d," "$CSV" && return 0
  ap=$(date -d "$d" +%d/%b/%Y)
  while read -r k n i f; do case $k in
    C) echo "$d,web,$f,$n" >> "$CSV"; echo "$d,webip,$f,$i" >> "$IPCSV"; hay=1 ;;
    I) echo "$d,webinc,$f,$n" >> "$IPCSV" ;;
    S) echo "$d,websin,$f,$n" >> "$IPCSV" ;;
  esac; done < <(contar_web "$ap")
  while read -r k n i f; do case $k in
    C) echo "$d,act,$f,$n" >> "$CSV"; hay=1 ;;
    I) echo "$d,actinc,$f,$n" >> "$IPCSV" ;;
    S) echo "$d,actsin,$f,$n" >> "$IPCSV" ;;
  esac; done < <(contar_upd "$ap")
  (( hay )) || echo "$d,ninguna,-,0" >> "$CSV"
}

resumen () {  # funciona con mawk (el awk de Ubuntu)
  local actual desde tabla
  actual=$(grep -oE 'FlyWeb-[0-9.]+[0-9]\.dmg' "$APPCAST" 2>/dev/null | sort -V | tail -1)
  desde=$(date -d '7 days ago' +%F)
  tabla=$(awk -F, -v desde="$desde" 'NR > 1 && $2 != "ninguna" {
      k = $3; v[k] = 1; t[$2 SUBSEP k] += $4; if ($1 >= desde) s[$2 SUBSEP k] += $4 }
    END { for (k in v) printf "%s %d %d %d %d\n", k, s["web" SUBSEP k], t["web" SUBSEP k], s["act" SUBSEP k], t["act" SUBSEP k] }' "$CSV" | sort -V -r)
  printf 'Versión actual: %s\n\n%-20s %21s %21s\n' "${actual:-?}" "" "web (7 días / total)" "actualiz. (7 d / total)"
  [[ -n $tabla ]] && printf '%-20s %10d / %-8d %10d / %-8d\n' $tabla
  printf '%s\n' "$tabla" | awk -v actual="${actual:-?}" '
    NF { sw += $2; tw += $3; sa += $4; ta += $5; if ($1 == actual) en_uso = $3 + $5 }
    END { printf "%-20s %10d / %-8d %10d / %-8d\n\n", "Total", sw, tw, sa, ta
          printf "FlyWeb en uso con la versión actual (aprox.): %d\n", en_uso
          printf "(actualizaciones a %s más descargas de %s desde la web; cuenta descargas, no personas)\n", actual, actual }'
  if [[ $(grep -c . "$IPCSV" 2>/dev/null || echo 0) -gt 1 ]]; then
    printf '\nIP distintas en la web (suma de las de cada día, últimos 7 días; solo el número):\n'
    awk -F, -v desde="$desde" 'NR > 1 && $2 == "webip" && $1 >= desde { s[$3] += $4 } END { for (k in s) printf "  %-20s %d\n", k, s[k] }' "$IPCSV" | sort -V -r
  fi
  local inc
  inc=$(awk -F, -v desde="$desde" 'NR > 1 && $1 >= desde && ($2 == "webinc" || $2 == "actinc") { k = $3; if ($2 == "webinc") w[k] += $4; else a[k] += $4; v[k] = 1 }
    END { for (k in v) printf "  %-20s web %d | actualiz. %d\n", k, w[k], a[k] }' "$IPCSV" | sort -V -r)
  [[ -n $inc ]] && printf '\nDescargas INCOMPLETAS de los últimos 7 días (el cliente cortó; no cuentan arriba):\n%s\n' "$inc"
  inc=$(awk -F, -v desde="$desde" 'NR > 1 && $1 >= desde && ($2 == "websin" || $2 == "actsin") { k = $3; if ($2 == "websin") w[k] += $4; else a[k] += $4; v[k] = 1 }
    END { for (k in v) printf "  %-20s web %d | actualiz. %d\n", k, w[k], a[k] }' "$IPCSV" | sort -V -r)
  [[ -n $inc ]] && printf '\nContadas SIN poder comprobar si terminaron (el DMG ya no está en disco), últimos 7 días:\n%s\n' "$inc"
  [[ -s $HIST ]] && printf '\nNota: «web» no cuenta las descargas de la oficina (solo desde que hay historial de su IP).\n'
  printf 'Nota: «actualizaciones» incluye los Macs de la oficina (sin IP en updates., no se pueden descontar).\n'
}

if [[ $MODO == ver ]]; then resumen; exit 0; fi

# Días que falten, hasta 13 atrás (la web guarda 14 días; updates., 7: más atrás, solo lo que quede). Ayer y hoy se
# vuelven a contar en cada pasada (cada hora): hoy va incompleto hasta medianoche y ayer se cierra con la rotación.
anotar_oficina
for d in "$(date -d yesterday +%F)" "$(date +%F)"; do
  grep -v "^$d," "$CSV" > "$CSV.nuevo" || true; mv "$CSV.nuevo" "$CSV"
  grep -v "^$d," "$IPCSV" > "$IPCSV.nuevo" || true; mv "$IPCSV.nuevo" "$IPCSV"
done
for i in $(seq 13 -1 0); do contar_dia "$(date -d "$i days ago" +%F)"; done
sudo -n /usr/local/sbin/flyweb-desplegar cifras
if [[ $(date +%u) == 1 && -n $AVISO ]] && ! grep -qxF "$(date +%G-%V)" "$EST/semanas" 2>/dev/null; then
  { printf 'To: %s\nSubject: [FlyWeb] cifras de la semana %s\nContent-Type: text/plain; charset=utf-8\n\n' "$AVISO" "$(date +%G-%V)"
    resumen; printf '\nPágina pública: https://flyweb.lamosquita.net/cifras.html\n\n-- flyweb-cifras en ns2\n'; } \
    | /usr/sbin/sendmail -t && date +%G-%V >> "$EST/semanas"
fi
