diff --git a/components/cosmetic_filters/resources/data/content_cosmetic.ts b/components/cosmetic_filters/resources/data/content_cosmetic.ts
index bcfe59b..2f83b5f 100644
--- a/components/cosmetic_filters/resources/data/content_cosmetic.ts
