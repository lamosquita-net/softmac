+index 7be0b6fe1ef41668009647536d32ec09932437a2..122b80e2219385eaa25c07d1c4b15fe4af87a3ff 100644
+--- a/content/public/browser/web_ui_browser_interface_broker_registry.h
++++ b/content/public/browser/web_ui_browser_interface_broker_registry.h
+@@ -114,6 +114,7 @@ class CONTENT_EXPORT WebUIBrowserInterfaceBrokerRegistry {
+     // class declaration.
+     WebUIController::Type type = &ControllerType::kWebUIControllerType;
+ 
++    BRAVE_WEBUI_BROWSER_INTERFACE_BROKER_REGISTRY_FOR_WEBUI
+     DCHECK(binder_initializers_.count(type) == 0)
+         << "Interfaces for a WebUI should be registered together.";
