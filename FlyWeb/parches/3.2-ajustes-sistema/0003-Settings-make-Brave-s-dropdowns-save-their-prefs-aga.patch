From 3511434056aea4bb663ad9879ffe3ffeb20093a4 Mon Sep 17 00:00:00 2001
From: "MOTOR-46 (Claude)" <noreply@anthropic.com>
Date: Thu, 19 Nov 2026 22:22:02 +0000
Subject: [PATCH 3/3] Settings: make Brave's dropdowns save their prefs again

In Chromium 156 settings-dropdown-menu is a Lit element that only writes
the pref when it has pref-key (settings_dropdown_menu.ts, onChange_ and
sendPrefChange); it no longer reads the key from a Polymer-bound pref.
Brave's six dropdowns passed only pref="{{...}}", so they showed the
value but every change was dropped: tab hover mode, default font size,
what the new tab page shows, WebRTC IP handling policy, Request OTR and
the private windows' search engine. Add pref-key to each.

The tab hover mode dropdown was also empty: tabTooltipModes_ was a class
field, which with the ESNext target hides the accessor Polymer creates
for the binding. Declare it as a Polymer property instead.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01MwmK2juPkbC58kEi4QFeyU
---
 .../settings/brave_appearance_page/tabs.html  |  1 +
 .../settings/brave_appearance_page/tabs.ts    | 32 ++++++++++++++-----
 .../settings/brave_content_page/content.html  |  1 +
 .../brave_new_tab_page.html                   |  1 +
 .../brave_personalization_options.html        |  2 ++
 .../brave_search_engines_page.html            |  1 +
 6 files changed, 30 insertions(+), 8 deletions(-)

diff --git a/browser/resources/settings/brave_appearance_page/tabs.html b/browser/resources/settings/brave_appearance_page/tabs.html
index d6802a65d0ed04391b59dc142d5bd0ca6add009f..bd850c6ee0c384d1dcb672b0ca958e85f0cda004 100644
--- a/browser/resources/settings/brave_appearance_page/tabs.html
+++ b/browser/resources/settings/brave_appearance_page/tabs.html
@@ -14,6 +14,7 @@
     <div class="label">$i18n{appearanceSettingsTabHoverMode}</div>
   </div>
   <settings-dropdown-menu
+    pref-key="brave.tabs.hover_mode"
     pref="{{prefs.brave.tabs.hover_mode}}"
     menu-options="[[tabTooltipModes_]]">
   </settings-dropdown-menu>
diff --git a/browser/resources/settings/brave_appearance_page/tabs.ts b/browser/resources/settings/brave_appearance_page/tabs.ts
index 92088b56f93515d2ef38049760f17fdbe84b9505..619f844456cdfc2c697f60b8b727fe06a8e2b834 100644
--- a/browser/resources/settings/brave_appearance_page/tabs.ts
+++ b/browser/resources/settings/brave_appearance_page/tabs.ts
@@ -29,14 +29,30 @@ export class SettingsBraveAppearanceTabsElement extends SettingsBraveAppearanceT
     return getTemplate()
   }
 
-  private tabTooltipModes_ = [
-    { value: 1, name: this.i18n('appearanceSettingsTabHoverModeCard') },
-    {
-      value: 2,
-      name: this.i18n('appearanceSettingsTabHoverModeCardWithPreview')
-    },
-    { value: 0, name: this.i18n('appearanceSettingsTabHoverModeTooltip') }
-  ]
+  // FlyWeb: declared as a Polymer property. Since the 156 port TypeScript
+  // targets ESNext, so a class field initializer is defined on the instance
+  // and hides the accessor Polymer creates for [[tabTooltipModes_]]: the
+  // dropdown got no options. The value function runs per instance, after
+  // I18nMixin is ready.
+  static get properties() {
+    return {
+      tabTooltipModes_: {
+        type: Array,
+        value(this: SettingsBraveAppearanceTabsElement) {
+          return [
+            {value: 1, name: this.i18n('appearanceSettingsTabHoverModeCard')},
+            {
+              value: 2,
+              name: this.i18n('appearanceSettingsTabHoverModeCardWithPreview'),
+            },
+            {value: 0, name: this.i18n('appearanceSettingsTabHoverModeTooltip')},
+          ]
+        },
+      },
+    }
+  }
+
+  private declare tabTooltipModes_: Array<{value: number, name: string}>
 
 }
 
