+// --- HTTP ---
+
+std::string AccountService::RoutePath(const std::string& route) const {
+  return std::string(kPathPrefix) + route;
+}
+
+GURL AccountService::RouteURL(const std::string& route) const {
+  return base_url_.Resolve(route);
+}
+
+void AccountService::Call(CallSpec spec, AccountCallback callback) {
+  if (!base_url_.is_valid()) {
+    std::move(callback).Run(AccountResult::Error("servidor"));
+    return;
+  }
+  if (spec.auth == Auth::kTokenOrProof) {
+    spec.auth = token_.empty() ? Auth::kProof : Auth::kToken;
+  }
+  if (spec.auth == Auth::kProof) {
+    if (!spec.proof_keys) {
+      if (chain_keys_.empty()) {
+        std::move(callback).Run(AccountResult::Error("sin-cadena"));
+        return;
+      }
+      // A copy: the seed may change while the nonce is on its way.
+      spec.owned_keys =
+          std::make_unique<account::ChainKeys>(chain_keys_.Clone());
+      spec.proof_keys = spec.owned_keys.get();
+    }
+    CallSpec nonce;
+    nonce.route = "nonce";
+    Call(std::move(nonce),
+         base::BindOnce(&AccountService::CallWithNonce,
+                        weak_ptr_factory_.GetWeakPtr(), std::move(spec),
+                        std::move(callback)));
+    return;
+  }
+  std::string body;
+  base::JSONWriter::Write(spec.body, &body);
+  std::vector<std::pair<std::string, std::string>> headers;
+  if ((spec.auth == Auth::kToken || spec.attach_token) && !token_.empty()) {
+    headers.emplace_back("Authorization", "Bearer " + token_);
+  }
+  Send(std::move(spec), std::move(body), std::move(headers),
+       std::move(callback));
+}
+
+void AccountService::CallWithNonce(CallSpec spec,
+                                   AccountCallback callback,
+                                   AccountResult nonce_result) {
+  if (!nonce_result.ok) {
+    std::move(callback).Run(std::move(nonce_result));
+    return;
+  }
+  const std::string nonce_b64 = GetStr(nonce_result.data, "nonce");
+  std::string nonce;
+  if (!base::Base64UrlDecode(nonce_b64,
+                             base::Base64UrlDecodePolicy::IGNORE_PADDING,
+                             &nonce)) {
+    std::move(callback).Run(AccountResult::Error("servidor"));
+    return;
+  }
+  std::string body;
+  base::JSONWriter::Write(spec.body, &body);
+  const std::string path = RoutePath(spec.route);
+  const std::string account_id =
+      spec.empty_account_in_proof
+          ? std::string()
+          : (spec.account_id_for_proof.empty() ? account_id_
+                                               : spec.account_id_for_proof);
+  std::vector<std::pair<std::string, std::string>> headers;
+  headers.emplace_back("X-FlyWeb-Nonce", nonce_b64);
+  // The token goes along so the server can name this Mac as the author of the
+  // event (S3); with both, the proof is what authenticates.
+  if (!token_.empty()) {
+    headers.emplace_back("Authorization", "Bearer " + token_);
+  }
+  headers.emplace_back("X-FlyWeb-Cadena", spec.proof_keys->ChainId());
+  headers.emplace_back(
+      "X-FlyWeb-Prueba",
+      B64(spec.proof_keys->SignProof("POST", path, spec.op, account_id,
+                                     base::as_byte_span(nonce), body)));
+  if (spec.new_chain_keys) {
+    // cadena/cambiar: the new chain signs the same message, same nonce.
+    headers.emplace_back("X-FlyWeb-Cadena-Nueva",
+                         spec.new_chain_keys->ChainId());
+    headers.emplace_back(
+        "X-FlyWeb-Prueba-Nueva",
+        B64(spec.new_chain_keys->SignProof("POST", path, spec.op, account_id,
+                                           base::as_byte_span(nonce), body)));
+  }
+  spec.proof_keys = nullptr;
+  spec.new_chain_keys = nullptr;
+  spec.owned_keys.reset();
+  Send(std::move(spec), std::move(body), std::move(headers),
+       std::move(callback));
+}
+
+void AccountService::Send(
+    CallSpec spec,
+    std::string body,
+    std::vector<std::pair<std::string, std::string>> headers,
+    AccountCallback callback) {
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = RouteURL(spec.route);
+  request->method = "POST";
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->load_flags = net::LOAD_DISABLE_CACHE | net::LOAD_BYPASS_CACHE;
+  for (auto& [name, value] : headers) {
+    request->headers.SetHeader(name, value);
+  }
+  auto loader = network::SimpleURLLoader::Create(std::move(request),
+                                                 kTrafficAnnotation);
+  loader->AttachStringForUpload(body, "application/json");
+  loader->SetTimeoutDuration(kCallTimeout);
+  loader->SetAllowHttpErrorResults(true);
+  network::SimpleURLLoader* raw = loader.get();
+  raw->DownloadToString(
+      url_loader_factory_.get(),
+      base::BindOnce(&AccountService::OnResponse,
+                     weak_ptr_factory_.GetWeakPtr(), std::move(loader),
+                     std::move(callback)),
+      kMaxResponseSize);
+}
+
+void AccountService::OnResponse(
+    std::unique_ptr<network::SimpleURLLoader> loader,
+    AccountCallback callback,
+    std::optional<std::string> body) {
+  int code = 0;
+  if (loader->ResponseInfo() && loader->ResponseInfo()->headers) {
+    code = loader->ResponseInfo()->headers->response_code();
+  }
+  if (!body || code == 0) {
+    // No answer, or not in 30 s (§9: «sin red», «servidor no responde»).
+    offline_ = true;
+    NotifyStatus();
+    std::move(callback).Run(AccountResult::Error("red"));
+    return;
+  }
+  offline_ = false;
+  last_contact_ = base::Time::Now();
+  std::optional<base::DictValue> dict =
+      base::JSONReader::ReadDict(*body, base::JSON_PARSE_RFC);
+  if (!dict) {
+    std::move(callback).Run(AccountResult::Error("servidor"));
+    return;
+  }
+  if (code >= 200 && code < 300) {
+    AccountResult r = AccountResult::Ok();
+    r.data = std::move(*dict);
+    std::move(callback).Run(std::move(r));
+    return;
+  }
+  std::string error = GetStr(*dict, "error");
+  if (error.empty() || code == 415) {
+    error = "servidor";
+  }
+  std::move(callback).Run(AccountResult::Error(error, GetInt(*dict, "hasta")));
+}
+
+// --- events (§6.2, §11) ---
+
+void AccountService::Refresh(AccountCallback callback) {
+  if (!HasChain()) {
+    UpdateState();
+    NotifyStatus();
+    std::move(callback).Run(AccountResult::Ok());
+    return;
+  }
+  Poll(std::move(callback));
+}
+
+void AccountService::SchedulePoll(bool failed) {
+  if (!HasChain()) {
+    poll_timer_.Stop();
+    return;
+  }
+  if (failed) {
+    poll_backoff_ = std::min(
+        poll_backoff_.is_zero() ? kPollInterval * 2 : poll_backoff_ * 2,
+        kMaxPollBackoff);
+  } else {
+    poll_backoff_ = base::TimeDelta();
+  }
+  poll_timer_.Start(
+      FROM_HERE, failed ? poll_backoff_ : kPollInterval,
+      base::BindOnce(&AccountService::Poll, weak_ptr_factory_.GetWeakPtr(),
+                     base::DoNothing()));
+}
+
+void AccountService::Poll(AccountCallback callback) {
+  if (polling_ || !HasChain()) {
+    // One request at a time (never in a loop against ns2).
+    std::move(callback).Run(AccountResult::Ok());
+    return;
+  }
+  polling_ = true;
+  poll_timer_.Stop();
+  CallSpec spec;
+  spec.route = "eventos";
+  spec.op = "eventos";
+  // The email comes only with the chain proof (S2 of §10.1): ask with it
+  // until it is known; then the token is enough.
+  const bool used_proof = token_.empty() || email_.empty();
+  spec.auth = used_proof ? Auth::kProof : Auth::kToken;
+  spec.body.Set("desde", static_cast<double>(last_event_));
+  Call(std::move(spec),
+       base::BindOnce(&AccountService::OnEvents, weak_ptr_factory_.GetWeakPtr(),
+                      std::move(callback), used_proof));
+}
+
+void AccountService::OnEvents(AccountCallback callback,
+                              bool used_proof,
+                              AccountResult result) {
+  polling_ = false;
+  if (!result.ok) {
+    if (!used_proof && result.error == "token") {
+      // Token invalidated (password or key changed, «No he sido yo»): the
+      // chain proof still reads events and gets a new token (§6.2).
+      token_.clear();
+      RenewToken(base::BindOnce(
+          [](base::WeakPtr<AccountService> self, AccountCallback callback,
+             AccountResult r) {
+            if (!self) {
+              return;
+            }
+            self->Poll(std::move(callback));
+          },
+          weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+      return;
+    }
+    last_error_ = result.error;
+    SchedulePoll(true);
+    NotifyStatus();
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+
+  last_error_.clear();
+  const std::string state = GetStr(result.data, "estado");
+  server_state_ = state;
+  deletion_date_ = GetInt(result.data, "borrado");
+
+  if (state == "cadena-sustituida") {
+    // The key was changed from another Mac (§6.3). The sync service will get
+    // DISABLED_BY_ADMIN and clear the seed; this Mac logs in again.
+    ForgetAccount(/*keep_email=*/true);
+    SetNotice("cadena-cambiada");
+    brave_sync::Prefs(profile_->GetPrefs())
+        .SetSyncAccountDeletedNoticePending(false);
+    UpdateState();
+    NotifyStatus();
+    std::move(callback).Run(AccountResult::Ok());
+    return;
+  }
+  if (state == "sin-cuenta") {
+    if (!account_id_.empty()) {
+      // The account went away while this chain lives on.
+      ForgetAccount(/*keep_email=*/true);
+      SetNotice("cuenta-borrada");
+    }
+    UpdateState();
+    SchedulePoll(false);
+    NotifyStatus();
+    std::move(callback).Run(AccountResult::Ok());
+    return;
+  }
+
+  // activa or borrado-programado. A Mac that joined with the words learns the
+  // account here and registers itself (decision 11 of §10.1).
+  const std::string account_id = GetStr(result.data, "cuenta");
+  if (account_id_.empty() && !account_id.empty()) {
+    account_id_ = account_id;
+    StoreString(kPrefAccountId, account_id_);
+    baseline_pending_ = true;
+  }
+  const std::string email = GetStr(result.data, "email");
+  if (!email.empty() && email != email_) {
+    email_ = email;
+    StoreString(kPrefEmail, email_);
+  }
+  if (!account_id_.empty() && token_.empty() && device_id_.empty() &&
+      !registering_) {
+    RegisterThisMac(base::DoNothing());
+  }
+
+  std::vector<AccountEvent> fresh;
+  const base::ListValue* events = result.data.FindList("eventos");
+  const size_t count = events ? events->size() : 0;
+  if (events) {
+    for (const base::Value& v : *events) {
+      if (!v.is_dict()) {
+        continue;
+      }
+      const base::DictValue& d = v.GetDict();
+      AccountEvent e;
+      e.n = GetInt(d, "n");
+      e.type = GetStr(d, "tipo");
+      e.date = GetInt(d, "fecha");
+      if (const base::DictValue* data = d.FindDict("datos")) {
+        e.mac = GetStr(*data, "mac");
+        e.model = GetStr(*data, "modelo");
+        e.count = GetInt(*data, "n");
+        e.since = GetInt(*data, "desde");
+        e.when = GetInt(*data, "fecha");
+        e.device = GetStr(*data, "aparato");
+      }
+      if (e.n <= last_event_) {
+        continue;
+      }
+      last_event_ = e.n;
+      if (baseline_pending_ || !IsWarningType(e.type)) {
+        continue;
+      }
+      if (!e.device.empty() && e.device == device_id_) {
+        // Done by this Mac: the server names the author only when it is
+        // verified (S3 of §10.1); without it, the warning is shown.
+        continue;
+      }
+      fresh.push_back(std::move(e));
+    }
+  }
+  StoreString(kPrefLastEvent, base::NumberToString(last_event_));
+  if (count >= kEventsPage) {
+    // More pages: keep reading now.
+    Poll(std::move(callback));
+    return;
+  }
+  baseline_pending_ = false;
+
+  UpdateState();
+  SchedulePoll(false);
+  if (!fresh.empty()) {
+    warnings_.insert(warnings_.end(), fresh.begin(), fresh.end());
+    for (Observer& o : observers_) {
+      o.OnAccountWarnings(fresh);
+    }
+  }
+  NotifyStatus();
+  std::move(callback).Run(AccountResult::Ok());
+}
+
+void AccountService::RenewToken(AccountCallback callback) {
+  if (device_id_.empty()) {
+    RegisterThisMac(std::move(callback));
+    return;
+  }
+  CallSpec spec;
+  spec.route = "aparatos/renovar";
+  spec.op = "aparatos-renovar";
+  spec.auth = Auth::kProof;
+  spec.body.Set("aparato", device_id_);
+  Call(std::move(spec),
+       base::BindOnce(
+           [](base::WeakPtr<AccountService> self, AccountCallback callback,
+              AccountResult r) {
+             if (!self) {
+               return;
+             }
+             if (r.ok) {
+               self->StoreToken(GetStr(r.data, "aparato"),
+                                GetStr(r.data, "token"));
+             } else if (r.error == "aparato") {
+               // Removed from the list by another Mac: register again only
+               // if the user asks (the page offers it); events still work
+               // with the chain proof.
+               self->device_id_.clear();
+               self->StoreString(kPrefDevice, std::string());
+             }
+             std::move(callback).Run(std::move(r));
+           },
+           weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void AccountService::RegisterThisMac(AccountCallback callback) {
+  registering_ = true;
+  CallSpec spec;
+  spec.route = "aparatos/renovar";
+  spec.op = "aparatos-renovar";
+  spec.auth = Auth::kProof;
+  spec.body.Set("modelo", DeviceModel());
+  spec.body.Set("nombre", DeviceModel());
+  Call(std::move(spec),
+       base::BindOnce(
+           [](base::WeakPtr<AccountService> self, AccountCallback callback,
+              AccountResult r) {
+             if (!self) {
+               return;
+             }
+             self->registering_ = false;
+             if (r.ok) {
+               if (self->account_id_.empty()) {
+                 self->account_id_ = GetStr(r.data, "cuenta");
+                 self->StoreString(kPrefAccountId, self->account_id_);
+               }
+               self->StoreToken(GetStr(r.data, "aparato"),
+                                GetStr(r.data, "token"));
+               self->UpdateState();
+               self->NotifyStatus();
+             }
+             std::move(callback).Run(std::move(r));
+           },
+           weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+// --- operations: common pieces ---
+
+bool AccountService::BeginOperation(AccountCallback& callback) {
+  if (busy_) {
+    std::move(callback).Run(AccountResult::Error("ocupado-local"));
+    return false;
+  }
+  // With unreadable keys only «volver a unir» makes sense (entrar or the
+  // words), and the page only offers that; both overwrite what is unreadable.
+  if (!encryptor_) {
+    std::move(callback).Run(AccountResult::Error("llavero"));
+    return false;
+  }
+  busy_ = true;
+  NotifyStatus();
+  return true;
+}
+
+AccountCallback AccountService::EndOperation(AccountCallback callback) {
+  return base::BindOnce(
+      [](base::WeakPtr<AccountService> self, AccountCallback callback,
+         AccountResult r) {
+        if (self) {
+          self->busy_ = false;
+          if (!r.ok) {
+            self->last_error_ = r.error;
+          }
+          self->UpdateState();
+          self->NotifyStatus();
+        }
+        std::move(callback).Run(std::move(r));
+      },
+      weak_ptr_factory_.GetWeakPtr(), std::move(callback));
+}
+
+// The ~1 s, 128 MiB step (§11): off the UI thread, one at a time (busy_).
+// The password is moved into the task and wiped there.
+void AccountService::DeriveKeys(
+    std::string password,
+    std::string email,
+    base::OnceCallback<void(std::optional<account::AccountKeys>)> callback) {
+  auto secret = std::make_unique<std::string>(std::move(password));
+  account::WipeString(password);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce(
+          [](std::unique_ptr<std::string> secret, std::string email) {
+            std::string normalized = account::NormalizePassword(*secret);
+            account::WipeString(*secret);
+            auto keys = account::DeriveAccountKeys(normalized, email);
+            account::WipeString(normalized);
+            return keys;
+          },
+          std::move(secret), std::move(email)),
+      std::move(callback));
+}
+
+void AccountService::JoinChain(const account::SecretKey& seed,
+                               AccountCallback callback) {
+  syncer::BraveSyncServiceImpl* sync = GetSyncService();
+  if (!sync) {
+    std::move(callback).Run(AccountResult::Error("llavero"));
+    return;
+  }
+  std::string words = brave_sync::crypto::PassphraseFromBytes32(
+      std::vector<uint8_t>(seed.bytes().begin(), seed.bytes().end()));
+  // The seed pref changes synchronously inside SetSyncCode: that change is
+  // ours, not a chain disabled by the server.
+  own_chain_change_ = true;
+  const bool ok = sync->SetSyncCode(words);
+  own_chain_change_ = false;
+  account::WipeString(words);
+  if (!ok) {
+    std::move(callback).Run(AccountResult::Error("llavero"));
+    return;
+  }
+  // As BraveSyncHandler::HandleSetSyncCode: the result comes when this Mac
+  // shows up in the chain, or false if the chain was deleted.
+  sync->SetJoinChainResultCallback(base::BindOnce(
+      [](base::WeakPtr<AccountService> self, AccountCallback callback,
+         bool joined) {
+        if (self && joined) {
+          self->Poll(base::DoNothing());
+        }
+        std::move(callback).Run(
+            joined ? AccountResult::Ok()
+                   : AccountResult::Error("cadena-borrada"));
+      },
+      weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+  sync->GetUserSettings()->SetInitialSyncFeatureSetupComplete();
+}
+
+void AccountService::LeaveChainThen(base::OnceClosure then) {
+  syncer::BraveSyncServiceImpl* sync = GetSyncService();
+  if (!sync || !HasChain()) {
+    std::move(then).Run();
+    return;
+  }
+  own_chain_change_ = true;
+  brave_sync::ResetSync(
+      sync, DeviceInfoSyncServiceFactory::GetForProfile(profile_),
+      base::BindOnce(
+          [](base::WeakPtr<AccountService> self, base::OnceClosure then) {
+            if (self) {
+              self->own_chain_change_ = false;
+            }
+            std::move(then).Run();
+          },
+          weak_ptr_factory_.GetWeakPtr(), std::move(then)));
+}
+
+void AccountService::CancelFlow() {
+  flow_timer_.Stop();
+  flow_.reset();  // SecretKey wipes the kept keys.
+  NotifyStatus();
+}
+
+void AccountService::ResendCode(AccountCallback callback) {
+  if (!flow_) {
+    std::move(callback).Run(AccountResult::Error("sin-flujo"));
+    return;
+  }
+  CallSpec spec;
+  switch (flow_->kind) {
+    case Flow::Kind::kCreate:
+      spec.route = "alta";
+      spec.body.Set("email", flow_->email);
+      break;
+    case Flow::Kind::kLogin:
+      spec.route = "entrar/empezar";
+      spec.body.Set("email", flow_->email);
+      spec.body.Set("kl", B64(flow_->keys->login_key.bytes()));
+      break;
+    case Flow::Kind::kPasswordChange:
+      spec.route = "contrasena/codigo";
+      spec.op = "contrasena-codigo";
+      spec.auth = Auth::kProof;
+      break;
+    case Flow::Kind::kEmailChange:
+      spec.route = "email/cambiar/empezar";
+      spec.op = "email-empezar";
+      spec.auth = Auth::kProof;
+      spec.body.Set("email", flow_->email);
+      spec.body.Set("kl", B64(flow_->current_login_key->bytes()));
+      break;
+    case Flow::Kind::kMailboxDelete:
+      spec.route = "cuenta/borrar-por-email";
+      spec.body.Set("email", flow_->email);
+      break;
+    case Flow::Kind::kStartOver:
+      spec.route = "cuenta/empezar-de-cero";
+      spec.body.Set("email", flow_->email);
+      break;
+  }
+  if (!BeginOperation(callback)) {
+    return;
+  }
+  Call(std::move(spec),
+       EndOperation(base::BindOnce(
+           [](base::WeakPtr<AccountService> self, AccountCallback callback,
+              AccountResult r) {
+             if (self && self->flow_) {
+               if (r.ok) {
+                 self->flow_->request_id = GetStr(r.data, "solicitud");
+                 self->flow_timer_.Start(
+                     FROM_HERE, kFlowLifetime,
+                     base::BindOnce(&AccountService::CancelFlow, self));
+               } else if (self->flow_->request_id.empty()) {
+                 // No code went out: no «falta el código» state.
+                 self->CancelFlow();
+               }
+             }
+             std::move(callback).Run(std::move(r));
+           },
+           weak_ptr_factory_.GetWeakPtr(), std::move(callback))));
+}
+
+// --- create (§8) ---
+
+void AccountService::CreateAccountStart(const std::string& email,
+                                        AccountCallback callback) {
+  const auto normalized = account::NormalizeEmail(email);
+  if (!normalized) {
+    std::move(callback).Run(AccountResult::Error("email"));
+    return;
+  }
+  CancelFlow();
+  flow_ = std::make_unique<Flow>();
+  flow_->kind = Flow::Kind::kCreate;
+  flow_->email = *normalized;
+  ResendCode(std::move(callback));
+}
+
+void AccountService::CreateAccountFinish(const std::string& code,
+                                         std::string password,
+                                         const std::string& device_name,
+                                         AccountCallback callback) {
+  if (!flow_ || flow_->kind != Flow::Kind::kCreate ||
+      flow_->request_id.empty()) {
+    account::WipeString(password);
+    std::move(callback).Run(AccountResult::Error("sin-flujo"));
+    return;
+  }
+  if (account::CountCodePoints(account::NormalizePassword(password)) <
+      account::kMinPasswordLength) {
+    account::WipeString(password);
+    std::move(callback).Run(AccountResult::Error("contrasena-corta"));
+    return;
+  }
+  const std::string name = device_name.empty() ? DeviceModel() : device_name;
+  if (!IsValidName(name)) {
+    account::WipeString(password);
+    std::move(callback).Run(AccountResult::Error("peticion"));
+    return;
+  }
+  if (!BeginOperation(callback)) {
+    account::WipeString(password);
+    return;
+  }
+  callback = EndOperation(std::move(callback));
+  const std::string email = flow_->email;
+  DeriveKeys(
+      std::move(password), email,
+      base::BindOnce(
+          [](base::WeakPtr<AccountService> self, std::string code,
+             std::string name, std::string email, AccountCallback callback,
+             std::optional<account::AccountKeys> keys) {
+            if (!self) {
+              return;
+            }
+            if (!keys || !self->flow_) {
+              std::move(callback).Run(
+                  AccountResult::Error(keys ? "sin-flujo" : "interno"));
+              return;
+            }
+            // The chain to link: this Mac's, or a new one (§8).
+            std::array<uint8_t, account::kSeedSize> seed_bytes;
+            const bool new_chain = !self->ReadSeed(&seed_bytes);
+            if (new_chain) {
+              const std::vector<uint8_t> fresh =
+                  brave_sync::crypto::GetSeed();
+              std::ranges::copy(fresh, seed_bytes.begin());
+            }
+            auto seed = std::make_unique<account::SecretKey>(seed_bytes);
+            std::ranges::fill(seed_bytes, 0);
+            // §4.6, first safeguard: the new wrap must open before it is sent.
+            std::vector<uint8_t> wrapped =
+                account::WrapSeed(keys->wrap_key, seed->bytes(), email);
+            if (!account::UnwrapSeed(keys->wrap_key, wrapped, email)) {
+              std::move(callback).Run(AccountResult::Error("interno"));
+              return;
+            }
+            auto chain = std::make_unique<account::ChainKeys>(
+                account::ChainKeys::FromSeed(seed->bytes()));
+            CallSpec spec;
+            spec.route = "alta/confirmar";
+            spec.op = "alta";
+            spec.auth = Auth::kProof;
+            spec.empty_account_in_proof = true;
+            spec.proof_keys = chain.get();
+            spec.body.Set("solicitud", self->flow_->request_id);
+            spec.body.Set("codigo", code);
+            spec.body.Set("kl", B64(keys->login_key.bytes()));
+            spec.body.Set("envoltura", B64(wrapped));
+            spec.body.Set("modelo", DeviceModel());
+            spec.body.Set("nombre", name);
+            self->Call(
+                std::move(spec),
+                base::BindOnce(
+                    [](base::WeakPtr<AccountService> self, std::string email,
+                       bool new_chain,
+                       std::unique_ptr<account::SecretKey> seed,
+                       std::unique_ptr<account::ChainKeys> chain,
+                       AccountCallback callback, AccountResult r) {
+                      if (!self) {
+                        return;
+                      }
+                      if (!r.ok) {
+                        std::move(callback).Run(std::move(r));
+                        return;
+                      }
+                      self->CancelFlow();
+                      self->StoreAccount(GetStr(r.data, "cuenta"), email,
+                                         GetStr(r.data, "aparato"),
+                                         GetStr(r.data, "token"));
+                      if (!new_chain) {
+                        self->Poll(base::DoNothing());
+                        std::move(callback).Run(AccountResult::Ok());
+                        return;
+                      }
+                      // A new chain: start syncing it and show the recovery
+                      // key, which the page asks to confirm as saved (§8).
+                      AccountResult ok = AccountResult::Ok();
+                      ok.data.Set("recoveryWords",
+                                  brave_sync::crypto::PassphraseFromBytes32(
+                                      std::vector<uint8_t>(
+                                          seed->bytes().begin(),
+                                          seed->bytes().end())));
+                      self->JoinChain(
+                          *seed, base::BindOnce(
+                                     [](AccountResult ok, AccountResult r) {
+                                       // The account exists already; a join
+                                       // error is shown, the words too.
+                                       if (!r.ok) {
+                                         ok.ok = false;
+                                         ok.error = r.error;
+                                       }
+                                       return ok;
+                                     },
+                                     std::move(ok))
+                                     .Then(std::move(callback)));
+                    },
+                    self, email, new_chain, std::move(seed), std::move(chain),
+                    std::move(callback)));
+          },
+          weak_ptr_factory_.GetWeakPtr(), code, name, email,
+          std::move(callback)));
+}
+
+// --- log in from a new Mac (§5.1) ---
+
+void AccountService::LoginStart(const std::string& email,
+                                std::string password,
+                                AccountCallback callback) {
+  const auto normalized = account::NormalizeEmail(email);
+  if (!normalized) {
+    account::WipeString(password);
+    std::move(callback).Run(AccountResult::Error("email"));
+    return;
+  }
+  if (!BeginOperation(callback)) {
+    account::WipeString(password);
+    return;
+  }
+  callback = EndOperation(std::move(callback));
+  CancelFlow();
+  DeriveKeys(
+      std::move(password), *normalized,
+      base::BindOnce(
+          [](base::WeakPtr<AccountService> self, std::string email,
+             AccountCallback callback,
+             std::optional<account::AccountKeys> keys) {
+            if (!self) {
+              return;
+            }
+            if (!keys) {
+              std::move(callback).Run(AccountResult::Error("interno"));
+              return;
+            }
+            self->flow_ = std::make_unique<Flow>();
+            self->flow_->kind = Flow::Kind::kLogin;
+            self->flow_->email = email;
+            self->flow_->keys = std::move(keys);
+            CallSpec spec;
+            spec.route = "entrar/empezar";
+            spec.body.Set("email", email);
+            spec.body.Set("kl", B64(self->flow_->keys->login_key.bytes()));
+            self->Call(
+                std::move(spec),
+                base::BindOnce(
+                    [](base::WeakPtr<AccountService> self,
+                       AccountCallback callback, AccountResult r) {
+                      if (!self) {
+                        return;
+                      }
+                      if (!r.ok) {
+                        // «espera»: no keys kept to retry by itself (§10).
+                        self->CancelFlow();
+                      } else if (self->flow_) {
+                        self->flow_->request_id = GetStr(r.data, "solicitud");
+                        self->flow_timer_.Start(
+                            FROM_HERE, kFlowLifetime,
+                            base::BindOnce(&AccountService::CancelFlow, self));
+                      }
+                      std::move(callback).Run(std::move(r));
+                    },
+                    self, std::move(callback)));
+          },
+          weak_ptr_factory_.GetWeakPtr(), *normalized, std::move(callback)));
+}
+
+void AccountService::LoginFinish(const std::string& code,
+                                 const std::string& device_name,
+                                 AccountCallback callback) {
+  if (!flow_ || flow_->kind != Flow::Kind::kLogin ||
+      flow_->request_id.empty()) {
+    std::move(callback).Run(AccountResult::Error("sin-flujo"));
+    return;
+  }
+  const std::string name = device_name.empty() ? DeviceModel() : device_name;
+  if (!IsValidName(name)) {
+    std::move(callback).Run(AccountResult::Error("peticion"));
+    return;
+  }
+  if (!BeginOperation(callback)) {
+    return;
+  }
+  callback = EndOperation(std::move(callback));
+  CallSpec spec;
+  spec.route = "entrar/terminar";
+  spec.body.Set("solicitud", flow_->request_id);
+  spec.body.Set("codigo", code);
+  spec.body.Set("kl", B64(flow_->keys->login_key.bytes()));
+  spec.body.Set("modelo", DeviceModel());
+  spec.body.Set("nombre", name);
+  Call(
+      std::move(spec),
+      base::BindOnce(
+          [](base::WeakPtr<AccountService> self, AccountCallback callback,
+             AccountResult r) {
+            if (!self) {
+              return;
+            }
+            if (!r.ok) {
+              // One error for password and code (O9); the flow stays for
+              // another code until it expires.
+              std::move(callback).Run(std::move(r));
+              return;
+            }
+            if (!self->flow_) {
+              std::move(callback).Run(AccountResult::Error("sin-flujo"));
+              return;
+            }
+            std::string wrapped_b64 = GetStr(r.data, "envoltura");
+            std::string wrapped;
+            std::optional<account::SecretKey> seed;
+            if (base::Base64Decode(wrapped_b64, &wrapped)) {
+              seed = account::UnwrapSeed(self->flow_->keys->wrap_key,
+                                         base::as_byte_span(wrapped),
+                                         self->flow_->email);
+            }
+            if (!seed) {
+              // §5.1 step 5 and P15: «La clave recibida no es válida. No se
+              // ha activado nada.»
+              self->CancelFlow();
+              std::move(callback).Run(AccountResult::Error("envoltura"));
+              return;
+            }
+            const std::string email = self->flow_->email;
+            self->CancelFlow();  // KL and KU are wiped here.
+            auto seed_ptr =
+                std::make_unique<account::SecretKey>(std::move(*seed));
+            const std::string account_id = GetStr(r.data, "cuenta");
+            const std::string device_id = GetStr(r.data, "aparato");
+            const std::string token = GetStr(r.data, "token");
+            auto join = base::BindOnce(
+                [](base::WeakPtr<AccountService> self,
+                   std::unique_ptr<account::SecretKey> seed,
+                   std::string account_id, std::string email,
+                   std::string device_id, std::string token,
+                   AccountCallback callback) {
+                  if (!self) {
+                    return;
+                  }
+                  self->StoreAccount(account_id, email, device_id, token);
+                  account::ChainKeys keys =
+                      account::ChainKeys::FromSeed(seed->bytes());
+                  if (!self->chain_keys_.empty() &&
+                      self->chain_keys_.ChainId() == keys.ChainId()) {
+                    // Same chain (keychain changed, «volver a unir»).
+                    std::move(callback).Run(AccountResult::Ok());
+                    return;
+                  }
+                  self->JoinChain(*seed, std::move(callback));
+                },
+                self, std::move(seed_ptr), account_id, email, device_id, token,
+                std::move(callback));
+            // Another chain here: leave it first; its data stays in the
+            // profile and is combined on joining (§9, «Combinar»).
+            std::array<uint8_t, account::kSeedSize> current;
+            if (self->ReadSeed(&current)) {
+              std::ranges::fill(current, 0);
+              self->LeaveChainThen(std::move(join));
+            } else {
+              std::move(join).Run();
+            }
+          },
+          weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+// --- the 24 words (§6.6) ---
+
+void AccountService::JoinWithRecoveryKey(const std::string& words,
+                                         AccountCallback callback) {
+  std::string pure;
+  const std::vector<std::string> list = base::SplitString(
+      words, " \n\t", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  if (list.size() == 24) {
+    pure = base::JoinString(list, " ");
+    if (!brave_sync::crypto::IsPassphraseValid(pure)) {
+      pure.clear();
+    }
+  } else if (list.size() == 25) {
+    // The 25 with a date of a 2.7.x or 3.0.x (§6.6), still valid.
+    auto parsed = brave_sync::TimeLimitedWords::Parse(words);
+    if (parsed.has_value()) {
+      pure = parsed.value();
+    }
+  }
+  if (pure.empty()) {
+    std::move(callback).Run(AccountResult::Error("palabras"));
+    return;
+  }
+  std::vector<uint8_t> bytes;
+  brave_sync::crypto::PassphraseToBytes32(pure, &bytes);
+  account::WipeString(pure);
+  std::array<uint8_t, account::kSeedSize> raw;
+  std::ranges::copy(bytes, raw.begin());
+  std::ranges::fill(bytes, 0);
+  auto seed = std::make_unique<account::SecretKey>(raw);
+  std::ranges::fill(raw, 0);
+  if (!BeginOperation(callback)) {
+    return;
+  }
+  callback = EndOperation(std::move(callback));
+  ForgetAccount(/*keep_email=*/!keys_unreadable_);
+  if (keys_unreadable_) {
+    profile_->GetPrefs()->ClearPref(kPrefEmail);
+    keys_unreadable_ = false;  // the seed is replaced by the words now
+  }
+  SetNotice(std::string());
+  auto join = base::BindOnce(
+      [](base::WeakPtr<AccountService> self,
+         std::unique_ptr<account::SecretKey> seed, AccountCallback callback) {
+        if (!self) {
+          return;
+        }
+        // The first poll on the new chain finds the account, if any, and
+        // registers this Mac (decision 11).
+        self->JoinChain(*seed, std::move(callback));
+      },
+      weak_ptr_factory_.GetWeakPtr(), std::move(seed), std::move(callback));
+  if (HasChain()) {
+    LeaveChainThen(std::move(join));
+  } else {
+    std::move(join).Run();
+  }
+}
+
+// --- change the password, or set a new one if forgotten (§4.6, §6.1) ---
+
+void AccountService::PasswordChangeStart(AccountCallback callback) {
+  if (account_id_.empty() || !HasChain()) {
+    std::move(callback).Run(AccountResult::Error("sin-cuenta"));
+    return;
+  }
+  CancelFlow();
+  flow_ = std::make_unique<Flow>();
+  flow_->kind = Flow::Kind::kPasswordChange;
+  flow_->email = email_;
+  ResendCode(std::move(callback));
+}
+
+void AccountService::PasswordChangeFinish(const std::string& code,
+                                          std::string new_password,
+                                          AccountCallback callback) {
+  if (!flow_ || flow_->kind != Flow::Kind::kPasswordChange ||
+      flow_->request_id.empty()) {
+    account::WipeString(new_password);
+    std::move(callback).Run(AccountResult::Error("sin-flujo"));
+    return;
+  }
+  if (account::CountCodePoints(account::NormalizePassword(new_password)) <
+      account::kMinPasswordLength) {
+    account::WipeString(new_password);
+    std::move(callback).Run(AccountResult::Error("contrasena-corta"));
+    return;
+  }
+  if (email_.empty()) {
+    // A Mac that joined with the words and never learnt the email (S2).
+    account::WipeString(new_password);
+    std::move(callback).Run(AccountResult::Error("email"));
+    return;
+  }
+  if (!BeginOperation(callback)) {
+    account::WipeString(new_password);
+    return;
+  }
+  callback = EndOperation(std::move(callback));
+  DeriveKeys(
+      std::move(new_password), email_,
+      base::BindOnce(
+          [](base::WeakPtr<AccountService> self, std::string code,
+             AccountCallback callback,
+             std::optional<account::AccountKeys> keys) {
+            if (!self) {
+              return;
+            }
+            if (!self->flow_) {
+              std::move(callback).Run(AccountResult::Error("sin-flujo"));
+              return;
+            }
+            std::array<uint8_t, account::kSeedSize> seed;
+            if (!keys || !self->ReadSeed(&seed)) {
+              std::move(callback).Run(
+                  AccountResult::Error(keys ? "llavero" : "interno"));
+              return;
+            }
+            std::vector<uint8_t> wrapped =
+                account::WrapSeed(keys->wrap_key, seed, self->email_);
+            const bool opens =
+                account::UnwrapSeed(keys->wrap_key, wrapped, self->email_)
+                    .has_value();
+            std::ranges::fill(seed, 0);
+            if (!opens) {
+              std::move(callback).Run(AccountResult::Error("interno"));
+              return;
+            }
+            CallSpec spec;
+            spec.route = "contrasena/cambiar";
+            spec.op = "contrasena-cambiar";
+            spec.auth = Auth::kProof;
+            spec.body.Set("solicitud", self->flow_->request_id);
+            spec.body.Set("codigo", code);
+            spec.body.Set("kl", B64(keys->login_key.bytes()));
+            spec.body.Set("envoltura", B64(wrapped));
+            if (!self->device_id_.empty()) {
+              spec.body.Set("aparato", self->device_id_);
+            }
+            // §4.6, third safeguard: if the answer is lost, the page offers
+            // Reintentar; the server answers the same to the same kl and
+            // wrap, but this repeats the derivation with a new random nonce
+            // in the wrap, so a retry is a new change, which is harmless.
+            self->Call(
+                std::move(spec),
+                base::BindOnce(
+                    [](base::WeakPtr<AccountService> self,
+                       AccountCallback callback, AccountResult r) {
+                      if (!self) {
+                        return;
+                      }
+                      if (r.ok) {
+                        self->CancelFlow();
+                        const std::string token = GetStr(r.data, "token");
+                        if (!token.empty()) {
+                          self->StoreToken(GetStr(r.data, "aparato"), token);
+                        }
+                        self->Poll(base::DoNothing());
+                      }
+                      std::move(callback).Run(std::move(r));
+                    },
+                    self, std::move(callback)));
+          },
+          weak_ptr_factory_.GetWeakPtr(), code, std::move(callback)));
+}
+
+// --- change the email (§6.5) ---
+
+void AccountService::EmailChangeStart(std::string password,
+                                      const std::string& new_email,
+                                      AccountCallback callback) {
+  const auto normalized = account::NormalizeEmail(new_email);
+  if (!normalized || email_.empty()) {
+    account::WipeString(password);
+    std::move(callback).Run(AccountResult::Error("email"));
+    return;
+  }
+  if (account_id_.empty() || !HasChain()) {
+    account::WipeString(password);
+    std::move(callback).Run(AccountResult::Error("sin-cuenta"));
+    return;
+  }
+  if (!BeginOperation(callback)) {
+    account::WipeString(password);
+    return;
+  }
+  callback = EndOperation(std::move(callback));
+  CancelFlow();
+  // Two stretchings: KL of the current email (it proves the password) and
+  // KL/KU of the new one (the wrap moves to it). Two seconds or so.
+  std::string copy = password;
+  DeriveKeys(
+      std::move(password), email_,
+      base::BindOnce(
+          [](base::WeakPtr<AccountService> self, std::string copy,
+             std::string new_email, AccountCallback callback,
+             std::optional<account::AccountKeys> current) {
+            if (!self) {
+              account::WipeString(copy);
+              return;
+            }
+            if (!current) {
+              account::WipeString(copy);
+              std::move(callback).Run(AccountResult::Error("interno"));
+              return;
+            }
+            self->DeriveKeys(
+                std::move(copy), new_email,
+                base::BindOnce(
+                    [](base::WeakPtr<AccountService> self,
+                       std::string new_email,
+                       std::optional<account::AccountKeys> current,
+                       AccountCallback callback,
+                       std::optional<account::AccountKeys> next) {
+                      if (!self) {
+                        return;
+                      }
+                      if (!next) {
+                        std::move(callback).Run(
+                            AccountResult::Error("interno"));
+                        return;
+                      }
+                      self->flow_ = std::make_unique<Flow>();
+                      self->flow_->kind = Flow::Kind::kEmailChange;
+                      self->flow_->email = new_email;
+                      self->flow_->keys = std::move(next);
+                      self->flow_->current_login_key =
+                          std::move(current->login_key);
+                      CallSpec spec;
+                      spec.route = "email/cambiar/empezar";
+                      spec.op = "email-empezar";
+                      spec.auth = Auth::kProof;
+                      spec.body.Set("email", new_email);
+                      spec.body.Set(
+                          "kl",
+                          B64(self->flow_->current_login_key->bytes()));
+                      self->Call(
+                          std::move(spec),
+                          base::BindOnce(
+                              [](base::WeakPtr<AccountService> self,
+                                 AccountCallback callback, AccountResult r) {
+                                if (!self) {
+                                  return;
+                                }
+                                if (!r.ok) {
+                                  self->CancelFlow();
+                                } else if (self->flow_) {
+                                  self->flow_->request_id =
+                                      GetStr(r.data, "solicitud");
+                                  self->flow_timer_.Start(
+                                      FROM_HERE, kFlowLifetime,
+                                      base::BindOnce(
+                                          &AccountService::CancelFlow, self));
+                                }
+                                std::move(callback).Run(std::move(r));
+                              },
+                              self, std::move(callback)));
+                    },
+                    self, new_email, std::move(current), std::move(callback)));
+          },
+          weak_ptr_factory_.GetWeakPtr(), std::move(copy), *normalized,
+          std::move(callback)));
+}
+
+void AccountService::EmailChangeFinish(const std::string& code,
+                                       AccountCallback callback) {
+  if (!flow_ || flow_->kind != Flow::Kind::kEmailChange ||
+      flow_->request_id.empty()) {
+    std::move(callback).Run(AccountResult::Error("sin-flujo"));
+    return;
+  }
+  std::array<uint8_t, account::kSeedSize> seed;
+  if (!ReadSeed(&seed)) {
+    std::move(callback).Run(AccountResult::Error("llavero"));
+    return;
+  }
+  std::vector<uint8_t> wrapped =
+      account::WrapSeed(flow_->keys->wrap_key, seed, flow_->email);
+  const bool opens =
+      account::UnwrapSeed(flow_->keys->wrap_key, wrapped, flow_->email)
+          .has_value();
+  std::ranges::fill(seed, 0);
+  if (!opens) {
+    std::move(callback).Run(AccountResult::Error("interno"));
+    return;
+  }
+  if (!BeginOperation(callback)) {
+    return;
+  }
+  callback = EndOperation(std::move(callback));
+  CallSpec spec;
+  spec.route = "email/cambiar/terminar";
+  spec.attach_token = true;  // author of «email-cambiado» (S3)
+  spec.body.Set("solicitud", flow_->request_id);
+  spec.body.Set("codigo", code);
+  spec.body.Set("kl", B64(flow_->keys->login_key.bytes()));
+  spec.body.Set("envoltura", B64(wrapped));
+  Call(std::move(spec),
+       base::BindOnce(
+           [](base::WeakPtr<AccountService> self, AccountCallback callback,
+              AccountResult r) {
+             if (!self) {
+               return;
+             }
+             if (r.ok && self->flow_) {
+               self->email_ = self->flow_->email;
+               self->StoreString(kPrefEmail, self->email_);
+               self->CancelFlow();
+               self->Poll(base::DoNothing());
+             }
+             std::move(callback).Run(std::move(r));
+           },
+           weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+// --- change the sync key (§6.3) ---
+
+void AccountService::ChainChange(std::string password,
+                                 AccountCallback callback) {
+  if (account_id_.empty() || !HasChain() || email_.empty()) {
+    account::WipeString(password);
+    std::move(callback).Run(AccountResult::Error("sin-cuenta"));
+    return;
+  }
+  if (!BeginOperation(callback)) {
+    account::WipeString(password);
+    return;
+  }
+  callback = EndOperation(std::move(callback));
+  CancelFlow();
+  DeriveKeys(
+      std::move(password), email_,
+      base::BindOnce(
+          [](base::WeakPtr<AccountService> self, AccountCallback callback,
+             std::optional<account::AccountKeys> keys) {
+            if (!self) {
+              return;
+            }
+            if (!keys) {
+              std::move(callback).Run(AccountResult::Error("interno"));
+              return;
+            }
+            const std::vector<uint8_t> fresh = brave_sync::crypto::GetSeed();
+            std::array<uint8_t, account::kSeedSize> raw;
+            std::ranges::copy(fresh, raw.begin());
+            auto seed = std::make_unique<account::SecretKey>(raw);
+            std::ranges::fill(raw, 0);
+            std::vector<uint8_t> wrapped =
+                account::WrapSeed(keys->wrap_key, seed->bytes(), self->email_);
+            if (!account::UnwrapSeed(keys->wrap_key, wrapped, self->email_)) {
+              std::move(callback).Run(AccountResult::Error("interno"));
+              return;
+            }
+            auto new_keys = std::make_unique<account::ChainKeys>(
+                account::ChainKeys::FromSeed(seed->bytes()));
+            CallSpec spec;
+            spec.route = "cadena/cambiar";
+            spec.op = "cadena-cambiar";
+            spec.auth = Auth::kProof;
+            spec.new_chain_keys = new_keys.get();
+            spec.body.Set("kl", B64(keys->login_key.bytes()));
+            spec.body.Set("envoltura", B64(wrapped));
+            if (!self->device_id_.empty()) {
+              spec.body.Set("aparato", self->device_id_);
+            }
+            // From here this Mac switches chains itself: the old chain's
+            // DISABLED_BY_ADMIN is not «cuenta borrada».
+            self->own_chain_change_ = true;
+            self->Call(
+                std::move(spec),
+                base::BindOnce(
+                    [](base::WeakPtr<AccountService> self,
+                       std::unique_ptr<account::SecretKey> seed,
+                       std::unique_ptr<account::ChainKeys> new_keys,
+                       AccountCallback callback, AccountResult r) {
+                      if (!self) {
+                        return;
+                      }
+                      if (!r.ok) {
+                        self->own_chain_change_ = false;
+                        std::move(callback).Run(std::move(r));
+                        return;
+                      }
+                      // The account is on the new chain and the old one is
+                      // deleted on the server. Leave it here and join the
+                      // new one: the local data goes up again, encrypted
+                      // with the new key. If FlyWeb stops right here, the
+                      // user logs in again with email, password and code:
+                      // the new wrap is on the server.
+                      const std::string token = GetStr(r.data, "token");
+                      if (!token.empty()) {
+                        self->StoreToken(GetStr(r.data, "aparato"), token);
+                      }
+                      self->last_event_ = 0;
+                      self->baseline_pending_ = true;
+                      AccountResult ok = AccountResult::Ok();
+                      ok.data.Set("recoveryWords",
+                                  brave_sync::crypto::PassphraseFromBytes32(
+                                      std::vector<uint8_t>(
+                                          seed->bytes().begin(),
+                                          seed->bytes().end())));
+                      self->LeaveChainThen(base::BindOnce(
+                          [](base::WeakPtr<AccountService> self,
+                             std::unique_ptr<account::SecretKey> seed,
+                             AccountResult ok, AccountCallback callback) {
+                            if (!self) {
+                              return;
+                            }
+                            self->JoinChain(
+                                *seed,
+                                base::BindOnce(
+                                    [](AccountResult ok, AccountResult r) {
+                                      if (!r.ok) {
+                                        ok.ok = false;
+                                        ok.error = r.error;
+                                      }
+                                      return ok;
+                                    },
+                                    std::move(ok))
+                                    .Then(std::move(callback)));
+                          },
+                          self, std::move(seed), std::move(ok),
+                          std::move(callback)));
+                    },
+                    self, std::move(seed), std::move(new_keys),
+                    std::move(callback)));
+          },
+          weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+// --- devices ---
+
+void AccountService::ListDevices(AccountCallback callback) {
+  CallSpec spec;
+  spec.route = "aparatos/listar";
+  spec.op = "aparatos-listar";
+  spec.auth = Auth::kTokenOrProof;
+  Call(std::move(spec),
+       base::BindOnce(
+           [](base::WeakPtr<AccountService> self, AccountCallback callback,
+              AccountResult r) {
+             if (self && r.ok) {
+               if (const base::ListValue* list = r.data.FindList("aparatos")) {
+                 self->devices_ = list->Clone();
+               }
+               self->NotifyStatus();
+             }
+             std::move(callback).Run(std::move(r));
+           },
+           weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void AccountService::RemoveDevice(const std::string& device_id,
+                                  AccountCallback callback) {
+  if (!BeginOperation(callback)) {
+    return;
+  }
+  CallSpec spec;
+  spec.route = "aparatos/quitar";
+  spec.op = "aparatos-quitar";
+  spec.auth = Auth::kProof;
+  spec.body.Set("aparato", device_id);
+  Call(std::move(spec),
+       EndOperation(base::BindOnce(
+           [](base::WeakPtr<AccountService> self, AccountCallback callback,
+              AccountResult r) {
+             if (self && r.ok) {
+               self->ListDevices(base::DoNothing());
+             }
+             std::move(callback).Run(std::move(r));
+           },
+           weak_ptr_factory_.GetWeakPtr(), std::move(callback))));
+}
+
+void AccountService::RenameDevice(const std::string& device_id,
+                                  const std::string& name,
+                                  AccountCallback callback) {
+  if (!IsValidName(name)) {
+    std::move(callback).Run(AccountResult::Error("peticion"));
+    return;
+  }
+  if (!BeginOperation(callback)) {
+    return;
+  }
+  CallSpec spec;
+  spec.route = "aparatos/renombrar";
+  spec.op = "aparatos-renombrar";
+  spec.auth = Auth::kProof;
+  spec.body.Set("aparato", device_id);
+  spec.body.Set("nombre", name);
+  Call(std::move(spec),
+       EndOperation(base::BindOnce(
+           [](base::WeakPtr<AccountService> self, AccountCallback callback,
+              AccountResult r) {
+             if (self && r.ok) {
+               self->ListDevices(base::DoNothing());
+             }
+             std::move(callback).Run(std::move(r));
+           },
+           weak_ptr_factory_.GetWeakPtr(), std::move(callback))));
+}
+
+// --- «¿Has sido tú?» (§6.2) ---
+
+void AccountService::NotMe(AccountCallback callback) {
+  if (!BeginOperation(callback)) {
+    return;
+  }
+  CallSpec spec;
+  spec.route = "no-he-sido-yo";
+  spec.op = "no-he-sido-yo";
+  spec.auth = Auth::kProof;
+  Call(std::move(spec),
+       EndOperation(base::BindOnce(
+           [](base::WeakPtr<AccountService> self, AccountCallback callback,
+              AccountResult r) {
+             if (self && r.ok) {
+               // All tokens are invalid now, this one too: the next poll
+               // renews it with the chain proof. The page then guides to
+               // change the password and the key (§6.2).
+               self->token_.clear();
+               self->StoreString(kPrefToken, std::string());
+               self->warnings_.clear();
+               self->Poll(base::DoNothing());
+             }
+             std::move(callback).Run(std::move(r));
+           },
+           weak_ptr_factory_.GetWeakPtr(), std::move(callback))));
+}
+
+void AccountService::DismissWarnings() {
+  warnings_.clear();
+  NotifyStatus();
+}
+
+void AccountService::DismissNotice() {
+  SetNotice(std::string());
+  UpdateState();
+  NotifyStatus();
+}
+
+// --- delete and leave (§7, §9) ---
+
+void AccountService::DeleteEverywhere(AccountCallback callback) {
+  if (!BeginOperation(callback)) {
+    return;
+  }
+  CallSpec spec;
+  spec.route = "cuenta/borrar";
+  spec.op = "cuenta-borrar";
+  spec.auth = Auth::kProof;
+  Call(std::move(spec),
+       EndOperation(base::BindOnce(
+           [](base::WeakPtr<AccountService> self, AccountCallback callback,
+              AccountResult r) {
+             if (!self) {
+               return;
+             }
+             if (r.ok) {
+               // The server cleared the chain and disabled it. Here: stop
+               // and clear, as after PermanentlyDeleteAccount; the profile
+               // keeps its data.
+               self->own_chain_change_ = true;
+               self->ForgetAccount(/*keep_email=*/false);
+               if (syncer::BraveSyncServiceImpl* sync =
+                       self->GetSyncService()) {
+                 sync->StopAndClearWithResetLocalDataReason();
+               }
+               self->own_chain_change_ = false;
+             }
+             std::move(callback).Run(std::move(r));
+           },
+           weak_ptr_factory_.GetWeakPtr(), std::move(callback))));
+}
+
+void AccountService::CancelDeletion(AccountCallback callback) {
+  if (!BeginOperation(callback)) {
+    return;
+  }
+  CallSpec spec;
+  spec.route = "cuenta/borrar/cancelar";
+  spec.op = "borrado-cancelar";
+  spec.auth = Auth::kProof;
+  Call(std::move(spec),
+       EndOperation(base::BindOnce(
+           [](base::WeakPtr<AccountService> self, AccountCallback callback,
+              AccountResult r) {
+             if (self && r.ok) {
+               self->server_state_ = "activa";
+               self->deletion_date_ = 0;
+               self->Poll(base::DoNothing());
+             }
+             std::move(callback).Run(std::move(r));
+           },
+           weak_ptr_factory_.GetWeakPtr(), std::move(callback))));
+}
+
+void AccountService::LeaveOnThisMac(AccountCallback callback) {
+  if (!BeginOperation(callback)) {
+    return;
+  }
+  callback = EndOperation(std::move(callback));
+  auto leave = base::BindOnce(
+      [](base::WeakPtr<AccountService> self, AccountCallback callback,
+         AccountResult r) {
+        if (!self) {
+          return;
+        }
+        if (!r.ok) {
+          std::move(callback).Run(std::move(r));
+          return;
+        }
+        // Leaves the chain, keeps the profile; the server deletes nothing
+        // (P7).
+        self->ForgetAccount(/*keep_email=*/false);
+        self->LeaveChainThen(base::BindOnce(
+            [](AccountCallback callback) {
+              std::move(callback).Run(AccountResult::Ok());
+            },
+            std::move(callback)));
+      },
+      weak_ptr_factory_.GetWeakPtr(), std::move(callback));
+  if (device_id_.empty()) {
+    std::move(leave).Run(AccountResult::Ok());
+    return;
+  }
+  CallSpec spec;
+  spec.route = "salir";
+  spec.op = "salir";
+  spec.auth = Auth::kProof;
+  spec.body.Set("aparato", device_id_);
+  Call(std::move(spec), std::move(leave));
+}
+
+// --- only the mailbox (§6.4) ---
+
+void AccountService::MailboxDeleteStart(const std::string& email,
+                                        AccountCallback callback) {
+  const auto normalized = account::NormalizeEmail(email);
+  if (!normalized) {
+    std::move(callback).Run(AccountResult::Error("email"));
+    return;
+  }
+  CancelFlow();
+  flow_ = std::make_unique<Flow>();
+  flow_->kind = Flow::Kind::kMailboxDelete;
+  flow_->email = *normalized;
+  ResendCode(std::move(callback));
+}
+
+void AccountService::MailboxDeleteFinish(const std::string& code,
+                                         AccountCallback callback) {
+  if (!flow_ || flow_->kind != Flow::Kind::kMailboxDelete ||
+      flow_->request_id.empty()) {
+    std::move(callback).Run(AccountResult::Error("sin-flujo"));
+    return;
+  }
+  if (!BeginOperation(callback)) {
+    return;
+  }
+  CallSpec spec;
+  spec.route = "cuenta/borrar-por-email/confirmar";
+  spec.body.Set("solicitud", flow_->request_id);
+  spec.body.Set("codigo", code);
+  Call(std::move(spec),
+       EndOperation(base::BindOnce(
+           [](base::WeakPtr<AccountService> self, AccountCallback callback,
+              AccountResult r) {
+             if (self && r.ok) {
+               self->CancelFlow();
+             }
+             std::move(callback).Run(std::move(r));  // data.fecha
+           },
+           weak_ptr_factory_.GetWeakPtr(), std::move(callback))));
+}
+
+void AccountService::StartOverStart(const std::string& email,
+                                    AccountCallback callback) {
+  const auto normalized = account::NormalizeEmail(email);
+  if (!normalized) {
+    std::move(callback).Run(AccountResult::Error("email"));
+    return;
+  }
+  CancelFlow();
+  flow_ = std::make_unique<Flow>();
+  flow_->kind = Flow::Kind::kStartOver;
+  flow_->email = *normalized;
+  ResendCode(std::move(callback));
+}
+
+void AccountService::StartOverFinish(const std::string& code,
+                                     std::string password,
+                                     AccountCallback callback) {
+  if (!flow_ || flow_->kind != Flow::Kind::kStartOver ||
+      flow_->request_id.empty()) {
+    account::WipeString(password);
+    std::move(callback).Run(AccountResult::Error("sin-flujo"));
+    return;
+  }
+  if (account::CountCodePoints(account::NormalizePassword(password)) <
+      account::kMinPasswordLength) {
+    account::WipeString(password);
+    std::move(callback).Run(AccountResult::Error("contrasena-corta"));
+    return;
+  }
+  if (!BeginOperation(callback)) {
+    account::WipeString(password);
+    return;
+  }
+  callback = EndOperation(std::move(callback));
+  const std::string email = flow_->email;
+  DeriveKeys(
+      std::move(password), email,
+      base::BindOnce(
+          [](base::WeakPtr<AccountService> self, std::string code,
+             std::string email, AccountCallback callback,
+             std::optional<account::AccountKeys> keys) {
+            if (!self) {
+              return;
+            }
+            if (!keys || !self->flow_) {
+              std::move(callback).Run(AccountResult::Error("interno"));
+              return;
+            }
+            const std::vector<uint8_t> fresh = brave_sync::crypto::GetSeed();
+            std::array<uint8_t, account::kSeedSize> raw;
+            std::ranges::copy(fresh, raw.begin());
+            auto seed = std::make_unique<account::SecretKey>(raw);
+            std::ranges::fill(raw, 0);
+            std::vector<uint8_t> wrapped =
+                account::WrapSeed(keys->wrap_key, seed->bytes(), email);
+            if (!account::UnwrapSeed(keys->wrap_key, wrapped, email)) {
+              std::move(callback).Run(AccountResult::Error("interno"));
+              return;
+            }
+            auto chain = std::make_unique<account::ChainKeys>(
+                account::ChainKeys::FromSeed(seed->bytes()));
+            CallSpec spec;
+            spec.route = "cuenta/empezar-de-cero/confirmar";
+            spec.op = "empezar-de-cero";
+            spec.auth = Auth::kProof;
+            spec.empty_account_in_proof = true;
+            spec.proof_keys = chain.get();
+            spec.body.Set("solicitud", self->flow_->request_id);
+            spec.body.Set("codigo", code);
+            spec.body.Set("kl", B64(keys->login_key.bytes()));
+            spec.body.Set("envoltura", B64(wrapped));
+            self->Call(
+                std::move(spec),
+                base::BindOnce(
+                    [](base::WeakPtr<AccountService> self, std::string email,
+                       std::unique_ptr<account::SecretKey> seed,
+                       std::unique_ptr<account::ChainKeys> chain,
+                       AccountCallback callback, AccountResult r) {
+                      if (!self) {
+                        return;
+                      }
+                      if (!r.ok) {
+                        std::move(callback).Run(std::move(r));
+                        return;
+                      }
+                      self->CancelFlow();
+                      // The new chain syncs now, without account; at day 14
+                      // the server links the account to it and the poll
+                      // registers this Mac (§6.4).
+                      self->ForgetAccount(/*keep_email=*/false);
+                      self->email_ = email;
+                      self->StoreString(kPrefEmail, email);
+                      AccountResult ok = AccountResult::Ok();
+                      ok.data.Set("fecha", GetInt(r.data, "fecha"));
+                      ok.data.Set("recoveryWords",
+                                  brave_sync::crypto::PassphraseFromBytes32(
+                                      std::vector<uint8_t>(
+                                          seed->bytes().begin(),
+                                          seed->bytes().end())));
+                      auto join = base::BindOnce(
+                          [](base::WeakPtr<AccountService> self,
+                             std::unique_ptr<account::SecretKey> seed,
+                             AccountResult ok, AccountCallback callback) {
+                            if (!self) {
+                              return;
+                            }
+                            self->JoinChain(
+                                *seed,
+                                base::BindOnce(
+                                    [](AccountResult ok, AccountResult r) {
+                                      if (!r.ok) {
+                                        ok.ok = false;
+                                        ok.error = r.error;
+                                      }
+                                      return ok;
+                                    },
+                                    std::move(ok))
+                                    .Then(std::move(callback)));
+                          },
+                          self, std::move(seed), std::move(ok),
+                          std::move(callback));
+                      if (self->HasChain()) {
+                        self->LeaveChainThen(std::move(join));
+                      } else {
+                        std::move(join).Run();
+                      }
+                    },
+                    self, email, std::move(seed), std::move(chain),
+                    std::move(callback)));
+          },
+          weak_ptr_factory_.GetWeakPtr(), code, email, std::move(callback)));
+}
