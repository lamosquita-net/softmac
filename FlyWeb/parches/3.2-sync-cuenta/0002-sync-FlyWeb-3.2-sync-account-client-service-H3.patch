+AccountService::AccountService(Profile* profile) : profile_(profile) {
+  url_loader_factory_ = profile_->GetDefaultStoragePartition()
+                            ->GetURLLoaderFactoryForBrowserProcess();
+
+  // Same origin as the sync server (--sync-url, which brave_main_delegate
+  // always sets from brave_sync_endpoint); so a test instance only needs
+  // --sync-url (P12, P15, P19). HTTPS only, or plain HTTP on loopback.
+  const GURL sync_url(
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          syncer::kSyncServiceURL));
+  if (sync_url.is_valid() &&
+      (sync_url.SchemeIs("https") ||
+       (sync_url.SchemeIs("http") && net::IsLocalhost(sync_url)))) {
+    base_url_ = sync_url.GetWithEmptyPath().Resolve(kPathPrefix);
+  } else {
+    LOG(ERROR) << "FlyWeb sync account: no usable --sync-url";
+  }
+
+  pref_change_registrar_.Init(profile_->GetPrefs());
+  pref_change_registrar_.Add(
+      brave_sync::Prefs::GetSeedPath(),
+      base::BindRepeating(&AccountService::OnSeedPrefChanged,
+                          base::Unretained(this)));
+
+  if (syncer::SyncService* sync = SyncServiceFactory::GetForProfile(profile_)) {
+    sync_observation_.Observe(sync);
+  }
+
+  g_browser_process->os_crypt_async()->GetInstance(base::BindOnce(
+      &AccountService::OnEncryptorReady, weak_ptr_factory_.GetWeakPtr()));
+}
