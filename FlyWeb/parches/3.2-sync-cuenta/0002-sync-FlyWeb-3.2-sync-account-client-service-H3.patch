+// --- Flow: the operation with an email code in the middle ---
+
+struct AccountService::Flow {
+  enum class Kind {
+    kCreate,
+    kLogin,
+    kPasswordChange,
+    kEmailChange,
+    kMailboxDelete,
+    kStartOver,
+  };
+  Kind kind;
+  std::string email;       // the one the code went to
+  std::string request_id;  // «solicitud»
+  // kLogin: KL and KU of `email`. kEmailChange: those of the new email.
+  std::optional<account::AccountKeys> keys;
+  // kEmailChange: KL of the current email, to send the code again.
+  std::optional<account::SecretKey> current_login_key;
+
+  const char* Name() const {
+    switch (kind) {
+      case Kind::kCreate:
+        return "crear";
+      case Kind::kLogin:
+        return "entrar";
+      case Kind::kPasswordChange:
+        return "contrasena";
+      case Kind::kEmailChange:
+        return "email";
+      case Kind::kMailboxDelete:
+        return "borrar-por-email";
+      case Kind::kStartOver:
+        return "empezar-de-cero";
+    }
+  }
+};
