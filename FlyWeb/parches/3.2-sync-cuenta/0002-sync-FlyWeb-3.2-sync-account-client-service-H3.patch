+// Prefs. All but the notice are encrypted with OSCrypt, like the seed (§11).
+constexpr char kPrefAccountId[] = "flyweb_sync_account.id";
+constexpr char kPrefEmail[] = "flyweb_sync_account.email";
+constexpr char kPrefDevice[] = "flyweb_sync_account.device";
+constexpr char kPrefToken[] = "flyweb_sync_account.token";
+constexpr char kPrefLastEvent[] = "flyweb_sync_account.last_event";
+constexpr char kPrefNotice[] = "flyweb_sync_account.notice";
+
+constexpr char kPathPrefix[] = "/cuenta/v1/";
+// §9: no call waits more than 30 s. The server gives up a scrypt turn at 25 s.
+constexpr base::TimeDelta kCallTimeout = base::Seconds(30);
+constexpr size_t kMaxResponseSize = 64 * 1024;
+// §11: every 15 min with sync on; back off up to 1 h when it fails.
+constexpr base::TimeDelta kPollInterval = base::Minutes(15);
+constexpr base::TimeDelta kMaxPollBackoff = base::Hours(1);
+// Life of an email code (§6.1): the flow and the keys it keeps go with it.
+constexpr base::TimeDelta kFlowLifetime = base::Minutes(10);
+// Server limits (README of cuenta/).
+constexpr size_t kMaxNameLength = 64;
+constexpr size_t kEventsPage = 100;
+
+// Events that show a bar (§6.2). aparato-renombrado only changes the list.
