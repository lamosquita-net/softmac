+
+void AccountService::OnEncryptorReady(
+    scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+  encryptor_ = std::move(encryptor);
+  LoadPrefs();
+  OnSeedPrefChanged();
+  UpdateState();
+  NotifyStatus();
+  if (HasChain()) {
+    Poll(base::DoNothing());
+  }
+}
+
+void AccountService::LoadPrefs() {
+  keys_unreadable_ = false;
+  const auto id = LoadString(kPrefAccountId);
+  const auto email = LoadString(kPrefEmail);
+  const auto device = LoadString(kPrefDevice);
+  const auto token = LoadString(kPrefToken);
+  const auto last = LoadString(kPrefLastEvent);
+  if (!id || !email || !device || !token || !last) {
+    // §9 «claves ilegibles»: the keychain changed. Same treatment as the seed.
+    keys_unreadable_ = true;
+    return;
+  }
+  account_id_ = *id;
+  email_ = *email;
+  device_id_ = *device;
+  token_ = *token;
+  if (!base::StringToInt64(*last, &last_event_)) {
+    last_event_ = 0;
+  }
+  notice_ = profile_->GetPrefs()->GetString(kPrefNotice);
+}
+
+std::optional<std::string> AccountService::LoadString(const char* path) const {
+  const std::string& stored = profile_->GetPrefs()->GetString(path);
+  if (stored.empty()) {
+    return std::string();
+  }
+  std::string encrypted;
+  std::string plain;
+  if (!encryptor_ || !base::Base64Decode(stored, &encrypted) ||
+      !encryptor_->DecryptString(encrypted, &plain)) {
+    return std::nullopt;
+  }
+  return plain;
+}
+
+void AccountService::StoreString(const char* path, const std::string& value) {
+  if (value.empty()) {
+    profile_->GetPrefs()->ClearPref(path);
+    return;
+  }
+  std::string encrypted;
+  if (!encryptor_ || !encryptor_->EncryptString(value, &encrypted)) {
+    LOG(ERROR) << "FlyWeb sync account: cannot encrypt a pref";
+    keys_unreadable_ = true;
+    return;
+  }
+  profile_->GetPrefs()->SetString(path, base::Base64Encode(encrypted));
+}
+
+void AccountService::StoreAccount(const std::string& account_id,
+                                  const std::string& email,
+                                  const std::string& device_id,
+                                  const std::string& token) {
+  account_id_ = account_id;
+  email_ = email;
+  device_id_ = device_id;
+  token_ = token;
+  last_event_ = 0;
+  baseline_pending_ = true;
+  keys_unreadable_ = false;  // every account pref is written again here
+  StoreString(kPrefAccountId, account_id_);
+  StoreString(kPrefEmail, email_);
+  StoreString(kPrefDevice, device_id_);
+  StoreString(kPrefToken, token_);
+  StoreString(kPrefLastEvent, std::string());
+  SetNotice(std::string());
+}
+
+void AccountService::StoreToken(const std::string& device_id,
+                                const std::string& token) {
+  if (!device_id.empty()) {
+    device_id_ = device_id;
+    StoreString(kPrefDevice, device_id_);
+  }
+  token_ = token;
+  StoreString(kPrefToken, token_);
+}
+
+void AccountService::ForgetAccount(bool keep_email) {
+  account_id_.clear();
+  device_id_.clear();
+  token_.clear();
+  last_event_ = 0;
+  server_state_.clear();
+  deletion_date_ = 0;
+  devices_ = base::ListValue();
+  warnings_.clear();
+  for (const char* path :
+       {kPrefAccountId, kPrefDevice, kPrefToken, kPrefLastEvent}) {
+    profile_->GetPrefs()->ClearPref(path);
+  }
+  if (!keep_email) {
+    email_.clear();
+    profile_->GetPrefs()->ClearPref(kPrefEmail);
+  }
+}
+
+void AccountService::SetNotice(const std::string& notice) {
+  notice_ = notice;
+  if (notice.empty()) {
+    profile_->GetPrefs()->ClearPref(kPrefNotice);
+  } else {
+    profile_->GetPrefs()->SetString(kPrefNotice, notice);
+  }
+}
+
+bool AccountService::ReadSeed(
+    std::array<uint8_t, account::kSeedSize>* seed) const {
+  // Decrypted here with the same OSCrypt key, not through
+  // BraveSyncServiceImpl::GetSeed(), which depends on its own encryptor.
+  const std::string& stored = profile_->GetPrefs()->GetString(
+      brave_sync::Prefs::GetSeedPath());
+  if (stored.empty() || !encryptor_) {
+    return false;
+  }
+  std::string encrypted;
+  std::string words;
+  if (!base::Base64Decode(stored, &encrypted) ||
+      !encryptor_->DecryptString(encrypted, &words)) {
+    return false;
+  }
+  std::vector<uint8_t> bytes;
+  const bool ok = brave_sync::crypto::PassphraseToBytes32(words, &bytes) &&
+                  bytes.size() == account::kSeedSize;
+  if (ok) {
+    std::ranges::copy(bytes, seed->begin());
+  }
+  account::WipeString(words);
+  std::ranges::fill(bytes, 0);
+  return ok;
+}
+
+void AccountService::OnSeedPrefChanged() {
+  if (!encryptor_) {
+    return;
+  }
+  std::array<uint8_t, account::kSeedSize> seed;
+  const bool has_seed_pref = !profile_->GetPrefs()
+                                  ->GetString(brave_sync::Prefs::GetSeedPath())
+                                  .empty();
+  if (ReadSeed(&seed)) {
+    if (keys_unreadable_) {
+      LoadPrefs();  // the seed reads again: clear the state if the rest does
+    }
+    account::ChainKeys keys = account::ChainKeys::FromSeed(seed);
+    std::ranges::fill(seed, 0);
+    if (chain_keys_.empty() || chain_keys_.ChainId() != keys.ChainId()) {
+      chain_keys_ = std::move(keys);
+      if (!own_chain_change_) {
+        // Joined through the old way (or another chain): find out from the
+        // server whether this chain has an account (decision 11).
+        SchedulePoll(false);
+        poll_timer_.FireNow();
+      }
+    }
+  } else if (has_seed_pref) {
+    // The seed is there but cannot be read: «claves ilegibles» (§9, P9).
+    keys_unreadable_ = true;
+  } else if (!chain_keys_.empty()) {
+    // The seed was cleared.
+    account::ChainKeys old_keys = std::move(chain_keys_);
+    chain_keys_ = account::ChainKeys();
+    poll_timer_.Stop();
+    if (!own_chain_change_ && !account_id_.empty()) {
+      OnChainDisabled(std::move(old_keys));
+    }
+  }
+  UpdateState();
+  NotifyStatus();
+}
+
+// The chain was disabled by the server (DISABLED_BY_ADMIN) and the sync
+// service has already cleared the seed. With the old keys, still in memory,
+// ask the server why: the key was changed from another Mac (§6.3) or the
+// account was deleted.
+void AccountService::OnChainDisabled(account::ChainKeys old_keys) {
+  auto keys = std::make_unique<account::ChainKeys>(std::move(old_keys));
+  resolving_chain_disabled_ = true;
+  CallSpec spec;
+  spec.route = "eventos";
+  spec.op = "eventos";
+  spec.auth = Auth::kProof;
+  spec.body.Set("desde", static_cast<double>(last_event_));
+  spec.proof_keys = keys.get();
+  Call(std::move(spec),
+       base::BindOnce(
+           [](base::WeakPtr<AccountService> self,
+              std::unique_ptr<account::ChainKeys> keys, AccountResult r) {
+             if (!self) {
+               return;
+             }
+             self->resolving_chain_disabled_ = false;
+             const bool changed =
+                 r.ok && GetStr(r.data, "estado") == "cadena-sustituida";
+             self->ForgetAccount(/*keep_email=*/true);
+             self->SetNotice(changed ? "cadena-cambiada" : "cuenta-borrada");
+             if (changed) {
+               // Brave's «account deleted» bar would say the wrong thing.
+               brave_sync::Prefs(self->profile_->GetPrefs())
+                   .SetSyncAccountDeletedNoticePending(false);
+             }
+             self->UpdateState();
+             self->NotifyStatus();
+           },
+           weak_ptr_factory_.GetWeakPtr(), std::move(keys)));
+}
+
+void AccountService::UpdateState() {
+  State s;
+  if (!encryptor_) {
+    s = State::kLoading;
+  } else if (keys_unreadable_) {
+    s = State::kKeysUnreadable;
+  } else if (notice_ == "cuenta-borrada") {
+    s = State::kAccountDeleted;
+  } else if (notice_ == "cadena-cambiada") {
+    s = State::kChainChanged;
+  } else if (!account_id_.empty() && HasChain()) {
+    s = server_state_ == "borrado-programado" ? State::kDeletionScheduled
+                                              : State::kSynced;
+  } else {
+    s = State::kNoAccount;
+  }
+  state_ = s;
+}
+
+void AccountService::NotifyStatus() {
+  for (Observer& o : observers_) {
+    o.OnAccountStatusChanged();
+  }
+}
+
+base::DictValue AccountService::GetStatus() const {
+  base::DictValue s;
+  const char* state = "cargando";
+  switch (state_) {
+    case State::kLoading:
+      state = "cargando";
+      break;
+    case State::kNoAccount:
+      state = "sin-cuenta";
+      break;
+    case State::kSynced:
+      state = "sincronizado";
+      break;
+    case State::kDeletionScheduled:
+      state = "borrado-programado";
+      break;
+    case State::kKeysUnreadable:
+      state = "claves-ilegibles";
+      break;
+    case State::kAccountDeleted:
+      state = "cuenta-borrada";
+      break;
+    case State::kChainChanged:
+      state = "clave-cambiada";
+      break;
+  }
+  s.Set("state", state);
+  s.Set("email", email_);
+  s.Set("hasChain", HasChain());
+  s.Set("hasAccount", !account_id_.empty());
+  s.Set("deletionDate", static_cast<double>(deletion_date_));
+  s.Set("offline", offline_);
+  s.Set("lastError", last_error_);
+  s.Set("lastContact",
+        last_contact_.is_null()
+            ? 0.0
+            : last_contact_.InSecondsFSinceUnixEpoch());
+  s.Set("busy", busy_);
+  s.Set("model", DeviceModel());
+  s.Set("minPasswordLength", static_cast<int>(account::kMinPasswordLength));
+  if (flow_) {
+    base::DictValue f;
+    f.Set("kind", flow_->Name());
+    f.Set("email", flow_->email);
+    s.Set("flow", std::move(f));
+  }
+  base::ListValue w;
+  for (const AccountEvent& e : warnings_) {
+    w.Append(e.ToValue());
+  }
+  s.Set("warnings", std::move(w));
+  s.Set("devices", devices_.Clone());
+  return s;
+}
+
+syncer::BraveSyncServiceImpl* AccountService::GetSyncService() const {
+  return SyncServiceFactory::IsSyncAllowed(profile_)
+             ? static_cast<syncer::BraveSyncServiceImpl*>(
+                   SyncServiceFactory::GetForProfile(profile_))
+             : nullptr;
+}
+
+void AccountService::OnStateChanged(syncer::SyncService* sync) {
+  // Sync came up or went down: poll soon if it is on and nothing is planned.
+  if (HasChain() && !poll_timer_.IsRunning() && !polling_) {
+    SchedulePoll(false);
+  }
+}
+
+void AccountService::OnSyncShutdown(syncer::SyncService* sync) {
+  sync_observation_.Reset();
+}
