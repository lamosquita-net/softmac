+bool IsWarningType(const std::string& type) {
+  return std::ranges::find(kWarningTypes, type) != std::end(kWarningTypes);
+}
+
+int64_t GetInt(const base::DictValue& dict, std::string_view key) {
+  const std::optional<double> v = dict.FindDouble(key);
+  return v ? static_cast<int64_t>(*v) : 0;
+}
+
+std::string GetStr(const base::DictValue& dict, std::string_view key) {
+  const std::string* v = dict.FindString(key);
+  return v ? *v : std::string();
+}
+
+std::string B64(base::span<const uint8_t> bytes) {
+  return base::Base64Encode(bytes);
+}
+
+bool IsValidName(const std::string& name) {
+  if (name.empty() || !base::IsStringUTF8(name)) {
+    return false;
+  }
+  const std::u16string u = base::UTF8ToUTF16(name);
+  if (u.size() > kMaxNameLength) {
+    return false;
+  }
+  return std::ranges::none_of(
+      u, [](char16_t c) { return c < 0x20 || c == 0x7f; });
+}
