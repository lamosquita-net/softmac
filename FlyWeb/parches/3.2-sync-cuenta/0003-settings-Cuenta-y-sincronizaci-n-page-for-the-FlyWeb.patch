+      </div>
+    </div>
+  </template>
+
+  <!-- Borrar la cuenta por email (§6.4, §7) -->
+  <template is="dom-if" if="[[is_(screen_, 'mailbox-delete')]]">
+    <div class="fw-screen">
+      <h2>$i18n{flywebAccountMailboxDelete}</h2>
