+      <div class="fw-actions">
+        <cr-button class="action-button" on-click="onLoginAgain_"
+            disabled="[[busy_(accountStatus, pending_)]]">
+          $i18n{flywebAccountLoginAgain}
+        </cr-button>
+        <cr-button on-click="onUnderstood_"
+            disabled="[[busy_(accountStatus, pending_)]]">
+          $i18n{flywebAccountUnderstood}
+        </cr-button>
+        <!-- The account went away while this chain lives on (§9). -->
+        <template is="dom-if" if="[[hasChain_(accountStatus)]]">
+          <cr-button on-click="onViewRecovery_">
+            $i18n{flywebAccountViewRecovery}
+          </cr-button>
+        </template>
+      </div>
+    </div>
+  </template>
+
+  <!-- Clave cambiada desde otro Mac (§6.3) -->
