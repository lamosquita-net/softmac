+          $i18n{flywebAccountStartOver}
+        </cr-button>
+        <cr-button on-click="onMailboxDelete_">
+          $i18n{flywebAccountMailboxDelete}
+        </cr-button>
+        <cr-button on-click="onBack_">$i18n{flywebAccountBack}</cr-button>
+      </div>
+    </div>
+  </template>
+
+  <!-- Empezar de cero: the email (§6.4) -->
+  <template is="dom-if" if="[[is_(screen_, 'start-over')]]">
+    <div class="fw-screen">
