+        <cr-button on-click="onWasMe_"
+            disabled="[[busy_(accountStatus, pending_)]]">
+          $i18n{flywebAccountWarningWasMe}
+        </cr-button>
+      </div>
+    </div>
+  </template>
+
+  <!-- After «No he sido yo»: what comes next (§6.2). -->
+  <template is="dom-if" if="[[notMeDone_]]">
+    <div class="fw-banner" role="status">
+      <p>$i18n{flywebAccountNotMeDone}</p>
+      <div class="fw-actions">
+        <cr-button class="action-button" on-click="onChangePassword_"
+            disabled="[[busy_(accountStatus, pending_)]]">
+          $i18n{flywebAccountChangePassword}
+        </cr-button>
+        <cr-button on-click="onChangeKey_">
+          $i18n{flywebAccountChangeKey}
+        </cr-button>
+        <cr-button on-click="onChangeEmail_">
+          $i18n{flywebAccountChangeEmail}
+        </cr-button>
+        <cr-button on-click="onNotMeClose_">
+          $i18n{flywebAccountClose}
+        </cr-button>
+      </div>
+    </div>
+  </template>
+
+  <!-- cargando -->
+  <template is="dom-if" if="[[is_(screen_, 'loading')]]">
