+    color: var(--cr-secondary-text-color);
+  }
+  .strength-3,
+  .strength-4
+  {
+    color: var(--cr-checked-color, rgb(26, 115, 232));
+  }
+</style>
+
+<template is="dom-if" if="[[!is_(screen_, 'none')]]">
+
+  <!-- «Sin red»: what was known last, and Reintentar (§9). -->
+  <template is="dom-if" if="[[showOffline_(accountStatus)]]">
+    <div class="fw-banner" role="status">
+      <div>[[offlineText_(accountStatus)]]</div>
+      <div class="fw-actions">
+        <cr-button on-click="onRefresh_"
+            disabled="[[busy_(accountStatus, pending_)]]">
+          $i18n{flywebAccountRetry}
+        </cr-button>
+      </div>
+    </div>
+  </template>
+
+  <!-- «¿Has sido tú?» (§6.2) -->
+  <template is="dom-if" if="[[showWarnings_(accountStatus, screen_)]]">
+    <div class="fw-banner fw-alert" role="alert">
+      <h2>$i18n{flywebAccountWarningsTitle}</h2>
+      <template is="dom-repeat" items="[[accountStatus.warnings]]">
+        <p>
+          [[warningText_(item)]]
