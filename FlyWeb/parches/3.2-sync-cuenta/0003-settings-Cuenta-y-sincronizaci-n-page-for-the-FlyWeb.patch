+<translation id="1554792256814134143">Desde otro Mac se ha pulsado «No he sido yo».</translation>
+<translation id="5764456135109043317">Se ha pedido borrar tu cuenta de sincronización; se borrará el <ph name="DATE"/>.</translation>
+<translation id="4892015564872566991">Se ha cancelado el borrado de tu cuenta de sincronización.</translation>
+<translation id="8526251264674164601">y <ph name="COUNT"/> avisos más</translation>
