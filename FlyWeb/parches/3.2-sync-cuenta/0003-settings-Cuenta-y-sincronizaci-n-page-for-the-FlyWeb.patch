+          <cr-button class="action-button" on-click="onCreate_"
+              disabled="[[busy_(accountStatus, pending_)]]">
+            $i18n{flywebAccountCreate}
+          </cr-button>
+          <cr-button on-click="onViewRecovery_">
+            $i18n{flywebAccountViewRecovery}
+          </cr-button>
+        </div>
+      </template>
+      <template is="dom-if" if="[[!hasChain_(accountStatus)]]">
+        <p>$i18n{flywebAccountNoAccountDesc}</p>
+        <div class="fw-actions">
+          <cr-button class="action-button" on-click="onCreate_"
+              disabled="[[busy_(accountStatus, pending_)]]">
+            $i18n{flywebAccountCreate}
+          </cr-button>
+          <cr-button on-click="onLogin_"
+              disabled="[[busy_(accountStatus, pending_)]]">
+            $i18n{flywebAccountLogin}
+          </cr-button>
+          <cr-button on-click="onHaveRecoveryKey_"
+              disabled="[[busy_(accountStatus, pending_)]]">
+            $i18n{flywebAccountHaveRecoveryKey}
+          </cr-button>
+        </div>
+        <div class="fw-actions">
+          <cr-button on-click="onForgot_">
+            $i18n{flywebAccountForgotPassword}
+          </cr-button>
+        </div>
+      </template>
+    </div>
+  </template>
+
+  <!-- Crear cuenta: the email -->
+  <template is="dom-if" if="[[is_(screen_, 'create')]]">
+    <div class="fw-screen">
+      <h2>$i18n{flywebAccountCreate}</h2>
+      <template is="dom-if" if="[[hasChain_(accountStatus)]]">
+        <p>$i18n{flywebAccountLinkDesc}</p>
+      </template>
+      <p>$i18n{flywebAccountEmailCodeDesc}</p>
+      <div class="fw-field">
+        <label for="createEmail">$i18n{flywebAccountEmailLabel}</label>
+        <input id="createEmail" class="fw-input" type="email"
+            autocomplete="email" spellcheck="false"
+            value="{{email_::input}}">
+      </div>
+      <div class="fw-actions">
+        <cr-button class="action-button" on-click="onCreateStart_"
+            disabled="[[!canSendEmail_(email_, pending_, accountStatus)]]">
+          $i18n{flywebAccountSendCode}
+        </cr-button>
+        <cr-button on-click="onBack_">$i18n{flywebAccountBack}</cr-button>
+      </div>
+    </div>
+  </template>
+
+  <!-- Entrar: email and password (§5.1) -->
+  <template is="dom-if" if="[[is_(screen_, 'login')]]">
+    <div class="fw-screen">
+      <h2>$i18n{flywebAccountLogin}</h2>
+      <p>$i18n{flywebAccountLoginDesc}</p>
+      <div class="fw-field">
+        <label for="loginEmail">$i18n{flywebAccountEmailLabel}</label>
+        <input id="loginEmail" class="fw-input" type="email"
+            autocomplete="username" spellcheck="false"
+            value="{{email_::input}}">
+      </div>
+      <div class="fw-field">
+        <label for="loginPassword">$i18n{flywebAccountPasswordLabel}</label>
+        <input id="loginPassword" class="fw-input" type="password"
+            autocomplete="current-password" value="{{password_::input}}">
+      </div>
+      <div class="fw-actions">
+        <cr-button class="action-button" on-click="onLoginStart_"
+            disabled="[[!canLogin_(email_, password_, pending_, accountStatus)]]">
+          $i18n{flywebAccountSendCode}
+        </cr-button>
+        <cr-button on-click="onForgot_">
+          $i18n{flywebAccountForgotPassword}
+        </cr-button>
+        <cr-button on-click="onBack_">$i18n{flywebAccountBack}</cr-button>
+      </div>
+    </div>
+  </template>
+
+  <!-- Tengo mi clave de recuperación (§6.6) -->
+  <template is="dom-if" if="[[is_(screen_, 'words')]]">
