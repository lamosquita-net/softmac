+<style include="cr-shared-style settings-shared">
+  :host
+  {
+    display: block;
+  }
+  h2
+  {
+    font-size: 15px;
+    font-weight: 600;
+    margin: 0 0 8px 0;
+  }
+  p
+  {
+    margin: 8px 0;
+  }
+  .fw-screen
+  {
+    padding: 12px 0;
+  }
+  .fw-actions
+  {
+    display: flex;
+    flex-direction: row;
+    flex-wrap: wrap;
+    gap: 8px;
+    margin: 12px 0;
+  }
+  .fw-field
+  {
+    display: flex;
+    flex-direction: column;
+    gap: 4px;
+    margin: 12px 0;
+    max-width: 420px;
+  }
+  .fw-field label
+  {
+    font-weight: 500;
+  }
+  .fw-input
+  {
+    background: var(--cr-input-background-color, transparent);
+    border: 1px solid var(--cr-separator-color);
+    border-radius: 4px;
+    box-sizing: border-box;
+    color: var(--cr-primary-text-color);
+    font: inherit;
+    padding: 6px 8px;
+  }
+  .fw-words
+  {
+    background: var(--cr-input-background-color, transparent);
+    border: 1px solid var(--cr-separator-color);
+    border-radius: 6px;
+    box-sizing: border-box;
+    color: var(--cr-primary-text-color);
+    font-family: inherit;
+    font-size: 15px;
+    line-height: 24px;
+    min-height: 110px;
+    padding: 10px 14px;
+    resize: vertical;
+    width: 100%;
+  }
+  .fw-hint
+  {
+    color: var(--cr-secondary-text-color);
+    font-size: 12px;
+  }
+  .fw-error
+  {
+    color: var(--cr-input-error-color, rgb(217, 48, 37));
+  }
+  .fw-info
+  {
+    color: var(--cr-secondary-text-color);
+  }
+  .fw-banner
+  {
+    border: 1px solid var(--cr-separator-color);
+    border-radius: 6px;
+    margin: 12px 0;
+    padding: 12px 16px;
+  }
+  .fw-banner.fw-alert
+  {
+    border-color: var(--cr-input-error-color, rgb(217, 48, 37));
+  }
+  .fw-device
+  {
+    align-items: center;
+    border-bottom: var(--cr-separator-line);
+    display: flex;
+    flex-wrap: wrap;
+    gap: 12px;
+    justify-content: space-between;
+    padding: 10px 0;
+  }
+  .fw-device .fw-actions
+  {
+    margin: 0;
+  }
+  .fw-device-name
+  {
+    font-weight: 600;
+  }
+  .fw-badge
+  {
+    border: 1px solid var(--cr-separator-color);
+    border-radius: 10px;
+    font-size: 11px;
+    font-weight: 500;
+    margin-inline-start: 6px;
+    padding: 1px 8px;
+  }
+  .strength-0,
