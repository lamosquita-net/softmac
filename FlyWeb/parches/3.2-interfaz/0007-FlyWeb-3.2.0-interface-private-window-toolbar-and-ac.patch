From 7d12c31ec86f5e75d3186f49a99a44fe8a4b4082 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 19 Nov 2026 18:21:17 +0000
Subject: [PATCH] FlyWeb 3.2.0 interface: private window toolbar and active tab
 color

Titin's color for the private window: active tab and toolbar in one
piece, #571E73. Private windows are always in dark mode (ThemeService
forces it for incognito profiles), so his light value (#AFA6D2) is not
applied until it is decided whether they should follow the system mode.
The frame, the icons and the URL field keep their current colors.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01MwmK2juPkbC58kEi4QFeyU
---
 browser/themes/brave_theme_service_browsertest.cc | 5 +++++
 browser/ui/color/brave_color_mixer.cc             | 6 +++---
 browser/ui/color/color_palette.h                  | 6 ++++++
 3 files changed, 14 insertions(+), 3 deletions(-)

diff --git a/browser/themes/brave_theme_service_browsertest.cc b/browser/themes/brave_theme_service_browsertest.cc
index 1180852cc2..9f4eae6381 100644
--- a/browser/themes/brave_theme_service_browsertest.cc
+++ b/browser/themes/brave_theme_service_browsertest.cc
@@ -267,6 +267,11 @@ IN_PROC_BROWSER_TEST_F(BraveThemeServiceTest, ColorProviderTest) {
   cp = browser_view->GetColorProvider();
   frame_active_color = cp->GetColor(ui::kColorFrameActive);
   EXPECT_EQ(kPrivateFrame, frame_active_color);
+
+  // FlyWeb 3.2.0: private window toolbar and active tab, one color.
+  EXPECT_EQ(kFlyWebPrivateDarkToolbar, cp->GetColor(kColorToolbar));
+  EXPECT_EQ(kFlyWebPrivateDarkToolbar,
+            cp->GetColor(kColorTabBackgroundActiveFrameActive));
 }
 
 #if BUILDFLAG(IS_WIN)
diff --git a/browser/ui/color/brave_color_mixer.cc b/browser/ui/color/brave_color_mixer.cc
index 8262d49291..76e9b8be93 100644
--- a/browser/ui/color/brave_color_mixer.cc
+++ b/browser/ui/color/brave_color_mixer.cc
@@ -575,8 +575,8 @@ void AddPrivateThemeColorMixer(ui::ColorProvider* provider,
   mixer[kColorNewTabButtonBackgroundFrameActive] = {ui::kColorFrameActive};
   mixer[kColorNewTabButtonBackgroundFrameInactive] = {ui::kColorFrameInactive};
   mixer[kColorNewTabPageBackground] = {kPrivateFrame};
-  mixer[kColorTabBackgroundActiveFrameActive] = {
-      leo::kColorPrimitivePrivateWindow80};
+  // FlyWeb: the active tab and the toolbar are one piece of the same color.
+  mixer[kColorTabBackgroundActiveFrameActive] = {kColorToolbar};
   mixer[kColorTabBackgroundActiveFrameInactive] = {
       kColorTabBackgroundActiveFrameActive};
   mixer[kColorTabBackgroundInactiveFrameActive] = {ui::kColorFrameActive};
@@ -589,7 +589,7 @@ void AddPrivateThemeColorMixer(ui::ColorProvider* provider,
       SkColorSetRGB(0xCC, 0xBE, 0xFE)};
   mixer[kColorTabForegroundInactiveFrameActive] = {
       SkColorSetRGB(0xCC, 0xBE, 0xFE)};
-  mixer[kColorToolbar] = {leo::kColorPrimitivePrivateWindow90};
+  mixer[kColorToolbar] = {kFlyWebPrivateDarkToolbar};
   mixer[kColorToolbarButtonIcon] = {leo::kColorPrimitivePrivateWindow40};
   mixer[kColorToolbarButtonIconInactive] = {
       ui::SetAlpha(kColorToolbarButtonIcon, kBraveDisabledControlAlpha)};
diff --git a/browser/ui/color/color_palette.h b/browser/ui/color/color_palette.h
index 0029eeeabd..2a21d35f85 100644
--- a/browser/ui/color/color_palette.h
+++ b/browser/ui/color/color_palette.h
@@ -56,6 +56,12 @@ constexpr SkColor kFlyWebOmniboxSelectionOnLight =
 
 constexpr SkColor kPrivateFrame = SkColorSetRGB(0x13, 0x05, 0x2A);
 
+// FlyWeb 3.2.0: private window active tab and toolbar (Titín, 19-11), one
+// piece of the same color as in regular windows. Private windows are always in
+// dark mode (ThemeService forces it for incognito profiles); Titín's light
+// value, #AFA6D2, waits for the decision on whether they follow the system.
+constexpr SkColor kFlyWebPrivateDarkToolbar = SkColorSetRGB(0x57, 0x1E, 0x73);
+
 constexpr SkColor kBraveNewTabBackgroundDark = SkColorSetRGB(0x33, 0x36, 0x39);
 constexpr SkColor kBraveNewTabBackgroundLight = SkColorSetRGB(0x6B, 0x70, 0x84);
 
-- 
2.43.0

