From c01ec05935d6e4a633d6ed6d8364d545f1c5e162 Mon Sep 17 00:00:00 2001
From: "MOTOR-47 (Claude)" <noreply@anthropic.com>
Date: Fri, 20 Nov 2026 16:51:22 +0000
Subject: [PATCH] FlyWeb 3.2.0 interface: OmniboxColorTest reads the dark
 provider explicitly

bt-320f: BraveThemeServiceTest.OmniboxColorTest failed in dark mode,
expecting #4D4D4D and #909294 and reading #FFFFFF, while the browser
shows the dark colors. On Mac SetBraveDarkModeType() only changes
NSApp's appearance and the native theme follows asynchronously, so the
window's provider was still the light one (the same cause as
ThemeObserverTest and SystemThemeChangeTest). Until 3.2.0 the dark URL
field was white like the light one, so the test passed by chance. Read
the dark colors from the provider for the window's own key with the
dark color mode. Test only; no browser code changes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01MwmK2hjxRPyuefYzGRoZRk
---
 .../themes/brave_theme_service_browsertest.cc    | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/browser/themes/brave_theme_service_browsertest.cc b/browser/themes/brave_theme_service_browsertest.cc
index 83b9965db31bcf2f73a3fae7e8ad3c6d6a6d3558..728ad7bd101b004eb345f7c2f4ce1b5521aaa2f7 100644
--- a/browser/themes/brave_theme_service_browsertest.cc
+++ b/browser/themes/brave_theme_service_browsertest.cc
@@ -26,8 +26,11 @@
 #include "testing/gmock/include/gmock/gmock.h"
 #include "testing/gtest/include/gtest/gtest-spi.h"
 #include "ui/color/color_provider.h"
+#include "ui/color/color_provider_key.h"
+#include "ui/color/color_provider_manager.h"
 #include "ui/native_theme/native_theme.h"
 #include "ui/native_theme/native_theme_observer.h"
+#include "ui/views/widget/widget.h"
 
 #if BUILDFLAG(IS_WIN)
 #include "base/run_loop.h"
@@ -225,7 +228,18 @@ IN_PROC_BROWSER_TEST_F(BraveThemeServiceTest, OmniboxColorTest) {
   dark_mode::SetBraveDarkModeType(
       dark_mode::BraveDarkModeType::BRAVE_DARK_MODE_TYPE_DARK);
   dark = true;
-  color_provider = browser_view->GetColorProvider();
+  // FlyWeb: on Mac, SetBraveDarkModeType() only changes NSApp's appearance and
+  // the native theme follows asynchronously, so the window's provider can still
+  // be the light one here (as in ThemeObserverTest and SystemThemeChangeTest).
+  // Until 3.2.0 the dark URL field was white like the light one, so this
+  // passed by chance. Read the colors from the provider for the window's own
+  // key in dark mode instead.
+  ui::ColorProviderKey dark_key =
+      browser_view->GetWidget()->GetColorProviderKeyForTesting();
+  dark_key.color_mode = ui::ColorProviderKey::ColorMode::kDark;
+  color_provider =
+      ui::ColorProviderManager::Get().GetColorProviderFor(dark_key);
+  ASSERT_TRUE(color_provider);
   EXPECT_EQ(GetLocationBarBackground(dark, false /* incognito */),
             color_provider->GetColor(kColorToolbarBackgroundSubtleEmphasis));
   // Check color is different on dark mode and incognito mode.
-- 
