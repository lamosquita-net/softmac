From 7900c51c885f54014e75e9bc25abcaf65844e9d2 Mon Sep 17 00:00:00 2001
From: "MOTOR-46 (Claude)" <noreply@anthropic.com>
Date: Fri, 20 Nov 2026 09:07:59 +0000
Subject: [PATCH 11/11] FlyWeb 3.2.0 interface: lower favicon and title on
 inactive tabs
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Titín (20-11): the favicon and title of inactive tabs, pinned ones
included, sit a bit lower and go back up when the tab becomes active.
kFlyWebInactiveTabContentOffset (provisional 4 dip, from Titín's high-resolution mockup: ~5-6 image px with the URL at ~33) is added to the
favicon through the existing layout hook and to the title through a new
one in Tab::Layout (one more line in Brave's tab.cc patch). Activation
already lays the tab out at once (Tab::ActiveStateChanged), and the
title animation only runs when the favicon appears or disappears, so
nothing animates. Only the horizontal tab strip: 156's vertical tabs use
their own views.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01MwmK2juPkbC58kEi4QFeyU
---
 .../chrome/browser/ui/views/tabs/tab.cc       | 23 ++++++++++++++++++-
 .../chrome-browser-ui-views-tabs-tab.cc.patch | 11 ++++++++-
 2 files changed, 32 insertions(+), 2 deletions(-)

diff --git a/chromium_src/chrome/browser/ui/views/tabs/tab.cc b/chromium_src/chrome/browser/ui/views/tabs/tab.cc
index f2f9178161979d98fe07044fe4172227d9419092..08a7f7f1488db082724d70dca18fb8bb530a987d 100644
--- a/chromium_src/chrome/browser/ui/views/tabs/tab.cc
+++ b/chromium_src/chrome/browser/ui/views/tabs/tab.cc
@@ -12,13 +12,33 @@
 #include "chrome/browser/ui/views/tabs/tab_slot_controller.h"
 #include "components/prefs/pref_service.h"
 
+namespace {
+
+// FlyWeb 3.2.0 interface (Titín, 20-11): the favicon and title of inactive
+// tabs (pinned ones too) sit this many dip lower; they go back up when the
+// tab becomes active (Tab::ActiveStateChanged() lays the tab out at once, and
+// the title animation only runs when the favicon appears or disappears).
+// Only the horizontal tab strip: 156's vertical tabs use their own views.
+// Provisional, adjusted with Titín on screenshots.
+constexpr int kFlyWebInactiveTabContentOffset = 4;
+
+int FlyWebInactiveTabContentOffset(const Tab* tab) {
+  return tab->IsActive() ? 0 : kFlyWebInactiveTabContentOffset;
+}
+
+}  // namespace
+
 // Upstream is no longer centering the tab favicon vertically within the tab
 // view (likely due to the fact that their tab contents rect happens to be the
 // same height as the favicon). Ensure that the favicon is centered vertically
 // within the tab.
 #define BRAVE_UI_VIEWS_TABS_TAB_LAYOUT_ADJUST_ICON_POSITION \
   favicon_bounds.set_y(contents_rect.y() +                  \
-                       Center(contents_rect.height(), gfx::kFaviconSize));
+                       Center(contents_rect.height(), gfx::kFaviconSize) + \
+                       FlyWebInactiveTabContentOffset(this));
+
+#define BRAVE_UI_VIEWS_TABS_TAB_TITLE_Y_OFFSET \
+  +FlyWebInactiveTabContentOffset(this)
 
 // Set alert indicator's pos to start of the title and
 // move title after the alert indicator.
@@ -37,6 +57,7 @@
 #include "src/chrome/browser/ui/views/tabs/tab.cc"
 
 #undef BRAVE_UI_VIEWS_TABS_TAB_UPDATE_ICON_VISIBILITY
+#undef BRAVE_UI_VIEWS_TABS_TAB_TITLE_Y_OFFSET
 #undef BRAVE_UI_VIEWS_TABS_TAB_ALERT_INDICATOR_POSITION
 #undef BRAVE_UI_VIEWS_TABS_TAB_LAYOUT_ADJUST_ICON_POSITION
 
diff --git a/patches/chrome-browser-ui-views-tabs-tab.cc.patch b/patches/chrome-browser-ui-views-tabs-tab.cc.patch
index 78ec0fc48a57f59f09cd068ec1c02120fac4f4df..28d551762e5cd63a98149458fbb7064ff7f33719 100644
