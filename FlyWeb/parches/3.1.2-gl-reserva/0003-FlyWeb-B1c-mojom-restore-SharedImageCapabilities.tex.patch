From d078e75aeb299b44112469e4f71fc42847763cad Mon Sep 17 00:00:00 2001
From: lamosquita <developer@lamosquita.com>
Date: Wed, 4 Nov 2026 18:26:28 +0100
Subject: [PATCH] FlyWeb B1c mojom: restore
 SharedImageCapabilities.texture_target_for_io_surfaces

From Chromium 150: same paths. Measurement only (FM.55).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 gpu/command_buffer/common/shared_image_capabilities.h    | 5 +++++
 gpu/ipc/common/shared_image_capabilities.mojom           | 4 ++++
 gpu/ipc/common/shared_image_capabilities_mojom_traits.cc | 5 +++++
 gpu/ipc/common/shared_image_capabilities_mojom_traits.h  | 8 ++++++++
 4 files changed, 22 insertions(+)

diff --git a/gpu/command_buffer/common/shared_image_capabilities.h b/gpu/command_buffer/common/shared_image_capabilities.h
index e60ebcb026..041a02dd09 100644
--- a/gpu/command_buffer/common/shared_image_capabilities.h
+++ b/gpu/command_buffer/common/shared_image_capabilities.h
@@ -46,6 +46,11 @@ struct GPU_COMMAND_BUFFER_COMMON_EXPORT SharedImageCapabilities {
 #if BUILDFLAG(IS_WIN)
   bool shared_image_swap_chain = false;
 #endif
+
+  // FlyWeb B1c: IOSurface texture target (rectangle on ANGLE GL), from 150.
+#if BUILDFLAG(IS_MAC)
+  uint32_t texture_target_for_io_surfaces = 0;
+#endif
 };
 
 }  // namespace gpu
diff --git a/gpu/ipc/common/shared_image_capabilities.mojom b/gpu/ipc/common/shared_image_capabilities.mojom
index 95943e1ad5..cad3d59e16 100644
--- a/gpu/ipc/common/shared_image_capabilities.mojom
+++ b/gpu/ipc/common/shared_image_capabilities.mojom
@@ -24,4 +24,8 @@ struct SharedImageCapabilities {
   bool shared_image_d3d;
   [EnableIf=is_win]
   bool shared_image_swap_chain;
+
+  // FlyWeb B1c: IOSurface texture target (rectangle on ANGLE GL), from 150.
+  [EnableIf=is_mac]
+  uint32 texture_target_for_io_surfaces;
 };
diff --git a/gpu/ipc/common/shared_image_capabilities_mojom_traits.cc b/gpu/ipc/common/shared_image_capabilities_mojom_traits.cc
index ada98cf634..a3882d0359 100644
--- a/gpu/ipc/common/shared_image_capabilities_mojom_traits.cc
+++ b/gpu/ipc/common/shared_image_capabilities_mojom_traits.cc
@@ -33,6 +33,11 @@ bool StructTraits<gpu::mojom::SharedImageCapabilitiesDataView,
   out->shared_image_swap_chain = data.shared_image_swap_chain();
 #endif
 
+  // FlyWeb B1c: IOSurface texture target (rectangle on ANGLE GL), from 150.
+#if BUILDFLAG(IS_MAC)
+  out->texture_target_for_io_surfaces = data.texture_target_for_io_surfaces();
+#endif
+
   return true;
 }
 
diff --git a/gpu/ipc/common/shared_image_capabilities_mojom_traits.h b/gpu/ipc/common/shared_image_capabilities_mojom_traits.h
index a7c2e536c8..ca8c3e62aa 100644
--- a/gpu/ipc/common/shared_image_capabilities_mojom_traits.h
+++ b/gpu/ipc/common/shared_image_capabilities_mojom_traits.h
@@ -79,6 +79,14 @@ struct GPU_IPC_COMMON_EXPORT StructTraits<
     return input.shared_image_swap_chain;
   }
 #endif
+
+  // FlyWeb B1c: IOSurface texture target (rectangle on ANGLE GL), from 150.
+#if BUILDFLAG(IS_MAC)
+  static uint32_t texture_target_for_io_surfaces(
+      const gpu::SharedImageCapabilities& input) {
+    return input.texture_target_for_io_surfaces;
+  }
+#endif
 };
 
 }  // namespace mojo
-- 
2.55.0

