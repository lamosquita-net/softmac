diff --git a/chromium_src/ui/color/material_ui_color_mixer.cc b/chromium_src/ui/color/material_ui_color_mixer.cc
index a30642546905e946dba99c63b8c49bcda9b5fd89..6c2442045052bc70c2f6951e661d8bc2ca66d5be 100644
--- a/chromium_src/ui/color/material_ui_color_mixer.cc
+++ b/chromium_src/ui/color/material_ui_color_mixer.cc
@@ -57,8 +57,14 @@ void AddMaterialUiColorMixer(ColorProvider* provider,
   mixer[ui::kColorToolbarSearchFieldIcon] = {ui::kColorSysOnSurfaceSubtle};
   mixer[ui::kColorToastBackground] = {is_dark ? gfx::kGoogleGrey800
                                               : gfx::kGoogleGrey100};
-  mixer[ui::kColorToastButton] = {ui::kColorSysInversePrimary};
-  mixer[ui::kColorToastForeground] = {ui::kColorSysOnSurfaceSubtle};
+  // FlyWeb: the browser toasts (ToastView: "FlyWeb is now your default
+  // browser", etc.) paint on kColorToastBackgroundProminent, which came out
+  // red with dark red text. Orange with black text, like the welcome page's
+  // buttons (components/brave_welcome_ui/components/flyweb/estilo.ts), in
+  // light and dark mode. kColorToastBackground is not used by any 156 toast.
+  mixer[ui::kColorToastBackgroundProminent] = {SkColorSetRGB(0xFF, 0x99, 0x00)};
+  mixer[ui::kColorToastButton] = {SK_ColorBLACK};
+  mixer[ui::kColorToastForeground] = {SK_ColorBLACK};
   mixer[ui::kColorToggleButtonHover] = {ui::kColorSysStateHover};
   mixer[ui::kColorToggleButtonPressed] = {ui::kColorSysStatePressed};
   mixer[ui::kColorToggleButtonShadow] = {ui::kColorSysOutline};
