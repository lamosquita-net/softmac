@@ -9,6 +9,7 @@
 
 #include "base/strings/utf_string_conversions.h"
 #include "build/build_config.h"
+#include "components/autofill/core/common/autofill_constants.h"
 #include "testing/gtest/include/gtest/gtest.h"
 
 namespace autofill {
@@ -68,6 +69,13 @@ TEST(CountryNamesForLocaleTest, EmptyCountryCodeForInvalidCountryName) {
   EXPECT_EQ("", de_names.GetCountryCode(u"ThisISNotACountry"));
 }
 
+// Test that an empty string is returned for an oversized country name.
+TEST(CountryNamesForLocaleTest, EmptyCountryCodeForOversizedCountryName) {
+  CountryNamesForLocale en_us_names("en_US");
+  EXPECT_EQ("", en_us_names.GetCountryCode(
+                    std::u16string(kMaxStringLength + 1, u'\uFDFA')));
+}
+
 // Test that an instance is correctly constructed using the move semantics.
 TEST(CountryNamesForLocaleTest, MoveConstructior) {
   // Construct a working `CountryNamesForLocale` instance.
diff --git a/components/autofill/core/common/autofill_data_validation.cc b/components/autofill/core/common/autofill_data_validation.cc
index c804da8be..9aab13e4b 100644
--- a/components/autofill/core/common/autofill_data_validation.cc
+++ b/components/autofill/core/common/autofill_data_validation.cc
@@ -37,6 +37,9 @@ bool IsValidOption(const SelectOption& option) {
 bool IsValidFormFieldData(const FormFieldData& field) {
   return IsValidString16(field.label()) && IsValidString16(field.name()) &&
          IsValidString16(field.value()) &&
+         field.selected_text().size() <= kMaxSelectedTextLength &&
+         (!field.selected_option_text().has_value() ||
+          IsValidString16(*field.selected_option_text())) &&
          mojom::IsKnownEnumValue(field.form_control_type()) &&
          (!field.IsSelectElement() || field.max_length() == 0) &&
          IsValidString(field.autocomplete_attribute()) &&
diff --git a/components/autofill/core/common/autofill_data_validation_unittest.cc b/components/autofill/core/common/autofill_data_validation_unittest.cc
index ff72c906c..f97fa1ffc 100644
--- a/components/autofill/core/common/autofill_data_validation_unittest.cc
+++ b/components/autofill/core/common/autofill_data_validation_unittest.cc
@@ -5,6 +5,7 @@
 #include "components/autofill/core/common/autofill_data_validation.h"
 
 #include "base/test/metrics/histogram_tester.h"
+#include "components/autofill/core/common/autofill_constants.h"
 #include "components/autofill/core/common/autofill_test_util.h"
 #include "testing/gtest/include/gtest/gtest.h"
 
@@ -70,6 +71,35 @@ TEST(AutofillDataValidationTest,
   EXPECT_FALSE(IsValidFormData(form_data));
 }
 
+// Tests that `IsValidFormFieldData` enforces `kMaxStringLength` on
+// `selected_option_text`.
+TEST(AutofillDataValidationTest, SelectedOptionTextValidation) {
+  FormFieldData field;
+  field.set_form_control_type(FormControlType::kSelectOne);
+  field.set_max_length(0);
+
+  EXPECT_TRUE(IsValidFormFieldData(field));
+
+  field.set_selected_option_text(std::u16string(kMaxStringLength, u'a'));
+  EXPECT_TRUE(IsValidFormFieldData(field));
+
+  field.set_selected_option_text(std::u16string(kMaxStringLength + 1, u'a'));
+  EXPECT_FALSE(IsValidFormFieldData(field));
+}
+
+// Tests that `IsValidFormFieldData` enforces `kMaxSelectedTextLength` on
+// `selected_text`.
+TEST(AutofillDataValidationTest, SelectedTextValidation) {
+  FormFieldData field;
+  EXPECT_TRUE(IsValidFormFieldData(field));
+
+  field.set_selected_text(std::u16string(kMaxSelectedTextLength, u'a'));
+  EXPECT_TRUE(IsValidFormFieldData(field));
+
+  field.set_selected_text(std::u16string(kMaxSelectedTextLength + 1, u'a'));
+  EXPECT_FALSE(IsValidFormFieldData(field));
+}
+
 }  // namespace
 
 }  // namespace autofill
