From 5be19ad6d6b8e60f4301425ebbf2678208594bf8 Mon Sep 17 00:00:00 2001
From: SEGURIDAD-PORTES-24 <noreply@anthropic.com>
Date: Wed, 18 Nov 2026 09:29:18 +0000
Subject: [PATCH 14/17] [FlyWeb] Autofill: SynchronousFormCache holds copies
 (crbug 573263397)

CVE-2026-131059 (High, Chrome 158). Upstream fix 770ffddb7f ("Fix UAF in
SynchronousFormCache") reworks SynchronousFormCache, FormCache,
FormSubmissionTracker and PasswordGenerationAgent around APIs 156 does not
have. Equivalent for 156: the cache stores std::optional<FormData> copies
instead of base::optional_ref references into FormCache, so JavaScript run by
the input/change events that autofill and password generation dispatch while
a cache is alive cannot leave it pointing to freed FormData. The cached data
can be stale in that case, as upstream accepts for the single-form cache.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01MwmK2hXs9xn6KN4sT9iVtr
---
 .../content/renderer/synchronous_form_cache.cc         | 10 +++++-----
 .../autofill/content/renderer/synchronous_form_cache.h | 10 +++++++---
 2 files changed, 12 insertions(+), 8 deletions(-)

diff --git a/components/autofill/content/renderer/synchronous_form_cache.cc b/components/autofill/content/renderer/synchronous_form_cache.cc
index fb33bb4425..70519020ba 100644
--- a/components/autofill/content/renderer/synchronous_form_cache.cc
+++ b/components/autofill/content/renderer/synchronous_form_cache.cc
@@ -17,8 +17,7 @@
 namespace autofill {
 
 SynchronousFormCache::SynchronousFormCache() = default;
-SynchronousFormCache::SynchronousFormCache(
-    const FormData& form LIFETIME_BOUND) {
+SynchronousFormCache::SynchronousFormCache(const FormData& form) {
   Insert(form.renderer_id(), &form);
 }
 SynchronousFormCache::SynchronousFormCache(
@@ -43,14 +42,14 @@ std::optional<FormData> SynchronousFormCache::GetOrExtractForm(
     const FieldDataManager& field_data_manager,
     const CallTimerState& timer_state,
     form_util::ButtonTitlesCache* button_titles_cache) const {
-  const base::optional_ref<const FormData>* cache_entry =
+  const std::optional<FormData>* cache_entry =
       base::FindOrNull(cache_, form_util::GetFormRendererId(form_element));
 
   // If `cache_entry` is non-null, the value of the `cache_entry` may be a null
   // reference, in case the previous extraction failed. In this case, the form
   // is not extracted again, because it would fail again.
   // TODO(crbug.com/40947729): Try caching forms that were not found.
-  return cache_entry ? cache_entry->CopyAsOptional()
+  return cache_entry ? *cache_entry
                      : form_util::ExtractFormData(
                            document, form_element, field_data_manager,
                            timer_state, button_titles_cache);
@@ -58,7 +57,8 @@ std::optional<FormData> SynchronousFormCache::GetOrExtractForm(
 
 void SynchronousFormCache::Insert(FormRendererId form_id,
                                   const FormData* form) {
-  cache_.emplace(form_id, form);
+  cache_.emplace(form_id,
+                 form ? std::optional<FormData>(*form) : std::nullopt);
 }
 
 }  // namespace autofill
diff --git a/components/autofill/content/renderer/synchronous_form_cache.h b/components/autofill/content/renderer/synchronous_form_cache.h
index c3b68a7fd8..ebd649650d 100644
--- a/components/autofill/content/renderer/synchronous_form_cache.h
+++ b/components/autofill/content/renderer/synchronous_form_cache.h
@@ -7,8 +7,8 @@
 
 #include <map>
 #include <memory>
+#include <optional>
 
-#include "base/compiler_specific.h"
 #include "base/types/optional_ref.h"
 #include "components/autofill/content/renderer/form_autofill_util.h"
 #include "components/autofill/core/common/form_data.h"
@@ -39,7 +39,7 @@ class SynchronousFormCache {
   SynchronousFormCache(SynchronousFormCache&&) = delete;
   // The two constructors below create a singleton cache (or cache with a single
   // form).
-  explicit SynchronousFormCache(const FormData& form LIFETIME_BOUND);
+  explicit SynchronousFormCache(const FormData& form);
   SynchronousFormCache(FormRendererId form_id,
                        base::optional_ref<const FormData> form);
   explicit SynchronousFormCache(
@@ -61,9 +61,13 @@ class SynchronousFormCache {
   // FormElement with the given ID. Note that this could be std::nullopt since
   // extraction might fail, and this would still be useful because knowing that
   // would allow avoiding a future failing attempt at extraction.
+  // FlyWeb (crbug.com/573263397): the cache holds copies, not references.
+  // Autofill and password generation dispatch input and change events while a
+  // cache is alive, and JavaScript can then destroy the FormData objects of the
+  // FormCache that a reference would point to.
   void Insert(FormRendererId form_id, const FormData* form);
 
-  std::map<FormRendererId, base::optional_ref<const FormData>> cache_;
+  std::map<FormRendererId, std::optional<FormData>> cache_;
 };
 
 }  // namespace autofill
