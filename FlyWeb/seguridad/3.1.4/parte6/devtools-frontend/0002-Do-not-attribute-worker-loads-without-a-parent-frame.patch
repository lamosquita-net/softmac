FlyWeb: ported to the 156 branch by hand. 156 has no #resolveFrameTarget (no
parentFrameId walk for dedicated workers): the load resolves the frame target
inline in loadResource(). The fix keeps the same rule there: a non-frame
initiator without a frameId loads through its own target, never under the
main frame id. The test rewrite of PageResourceLoader.test.ts is left out (it
pins the 157+ #resolveFrameTarget behavior).
---
 front_end/core/sdk/PageResourceLoader.ts | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/front_end/core/sdk/PageResourceLoader.ts b/front_end/core/sdk/PageResourceLoader.ts
index b88517a..b2141a0 100644
--- a/front_end/core/sdk/PageResourceLoader.ts
+++ b/front_end/core/sdk/PageResourceLoader.ts
@@ -347,6 +347,13 @@ export class PageResourceLoader extends Common.ObjectWrapper.ObjectWrapper<Event
       while (frameTarget && !frameTarget.model(ResourceTreeModel)) {
         frameTarget = frameTarget.parentTarget();
       }
+      if (frameTarget && frameTarget !== initiator.target && !initiator.frameId) {
+        // The initiator is a non-frame target (e.g. a service worker or a shared worker) that is not
+        // owned by any single frame. Don't attribute the load to the page's main frame, as the browser
+        // would then issue the request with the main frame's origin and credentials. Load through the
+        // initiator's own target instead, where the browser attributes the request to the worker's origin.
+        frameTarget = initiator.target;
+      }
       const frameId = initiator.frameId ?? frameTarget?.model(ResourceTreeModel)?.mainFrame?.id ?? null;
       if (isHttp && frameTarget) {
         const networkManager = frameTarget.model(NetworkManager);
