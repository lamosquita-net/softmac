From cf77fb8630525e2125276161dcc84c5af8900941 Mon Sep 17 00:00:00 2001
From: Andrew Moylan <amoylan@google.com>
Date: Sun, 25 Oct 2026 16:15:28 -0700
Subject: [PATCH 31/32] image_annotation: Call AnnotateImage via Mojo Remote in
 unit tests

Make AnnotateImage private and standardize on running unit tests against
the bound Mojo interface.

Bug: chromium:564769937
Change-Id: I0960de3a49346069233b8f1aaa3a3c7f4c1250c0
Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8625980
Reviewed-by: Ramin Halavati <rhalavati@chromium.org>
Commit-Queue: Andrew Moylan <amoylan@google.com>
Cr-Commit-Position: refs/heads/main@{#1726676}
---
 services/image_annotation/annotator.h         |  12 +-
 .../image_annotation/annotator_unittest.cc    | 152 ++++++++++++------
 2 files changed, 111 insertions(+), 53 deletions(-)

diff --git a/services/image_annotation/annotator.h b/services/image_annotation/annotator.h
index 876f15625b..8999509140 100644
--- a/services/image_annotation/annotator.h
+++ b/services/image_annotation/annotator.h
@@ -110,12 +110,6 @@ class Annotator : public mojom::Annotator {
   // Start providing behavior for the given Mojo receiver.
   void BindReceiver(mojo::PendingReceiver<mojom::Annotator> receiver);
 
-  // mojom::Annotator:
-  void AnnotateImage(const std::string& source_id,
-                     const std::string& description_language_tag,
-                     mojo::PendingRemote<mojom::ImageProcessor> image,
-                     AnnotateImageCallback callback) override;
-
  private:
   FRIEND_TEST_ALL_PREFIXES(AnnotatorTest, DescLanguage);
   FRIEND_TEST_ALL_PREFIXES(AnnotatorTest, ComputePreferredLanguage);
@@ -173,6 +167,12 @@ class Annotator : public mojom::Annotator {
   // List of URL loader objects.
   using UrlLoaderList = std::list<std::unique_ptr<network::SimpleURLLoader>>;
 
+  // mojom::Annotator:
+  void AnnotateImage(const std::string& source_id,
+                     const std::string& description_language_tag,
+                     mojo::PendingRemote<mojom::ImageProcessor> image,
+                     AnnotateImageCallback callback) override;
+
   // Returns true if the given dimensions fit the policy of the description
   // backend (i.e. the image has size / shape on which it is acceptable to run
   // the description model).
