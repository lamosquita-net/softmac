diff --git a/third_party/blink/renderer/core/css/css_style_sheet.cc b/third_party/blink/renderer/core/css/css_style_sheet.cc
index 817fdfa904..781cdc65c0 100644
--- a/third_party/blink/renderer/core/css/css_style_sheet.cc
+++ b/third_party/blink/renderer/core/css/css_style_sheet.cc
@@ -155,9 +155,10 @@ CSSParserContext* CSSStyleSheet::InlineParserContext(
           // document. `Referrer::ClientReferrerString()` for a fetch request
           // just means "use the default referrer", which will be computed from
           // the client (in this case, the owner document's ExecutionContext)
-          // when fetching.
+          // when fetching. The referrer policy is the owner document's policy
+          // at the time the inline CSS is parsed.
           Referrer::ClientReferrerString(),
-          network::mojom::ReferrerPolicy::kDefault),
+          owner_node_document.GetReferrerPolicy()),
       encoding);
   if (AdTracker::IsAdScriptExecutingInDocument(&owner_node_document)) {
     parser_context->SetIsAdRelated();
diff --git a/third_party/blink/renderer/core/execution_context/execution_context.cc b/third_party/blink/renderer/core/execution_context/execution_context.cc
index 59ed41c4e6..6242f2e336 100644
--- a/third_party/blink/renderer/core/execution_context/execution_context.cc
+++ b/third_party/blink/renderer/core/execution_context/execution_context.cc
@@ -517,7 +517,8 @@ void ExecutionContext::ParseAndSetReferrerPolicy(
 }
 
 network::mojom::ReferrerPolicy ExecutionContext::GetReferrerPolicy() const {
-  return policy_container_->GetReferrerPolicy();
+  return policy_container_ ? policy_container_->GetReferrerPolicy()
+                           : network::mojom::ReferrerPolicy::kDefault;
 }
 
 void ExecutionContext::SetReferrerPolicy(
