     network::mojom::ReferrerPolicy new_referrer_policy =
         GetExecutionContext()->GetReferrerPolicy();
     if (old_referrer_policy != new_referrer_policy) {
+      GetDocument().ReferrerPolicyChanged();
       if (auto* document_rules =
               DocumentSpeculationRules::FromIfExists(GetDocument())) {
         document_rules->DocumentReferrerPolicyChanged();
diff --git a/third_party/blink/web_tests/external/wpt/referrer-policy/css-integration/image/inline-style-with-color-scheme-no-referrer.html b/third_party/blink/web_tests/external/wpt/referrer-policy/css-integration/image/inline-style-with-color-scheme-no-referrer.html
