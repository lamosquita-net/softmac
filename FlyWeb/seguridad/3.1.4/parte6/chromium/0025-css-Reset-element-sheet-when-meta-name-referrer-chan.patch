diff --git a/third_party/blink/renderer/core/css/style_engine.cc b/third_party/blink/renderer/core/css/style_engine.cc
index e838a11c8c..9ca3cdbf2c 100644
--- a/third_party/blink/renderer/core/css/style_engine.cc
+++ b/third_party/blink/renderer/core/css/style_engine.cc
@@ -4957,6 +4957,12 @@ void StyleEngine::BaseURLChanged() {
   fill_or_clip_path_uri_value_cache_.clear();
 }
 
+void StyleEngine::ReferrerPolicyChanged() {
+  // Cached CSSURIValues carry the referrer policy of the element sheet they
+  // were parsed with.
+  fill_or_clip_path_uri_value_cache_.clear();
+}
+
 void StyleEngine::UpdateViewportSize() {
   viewport_size_ =
       CSSToLengthConversionData::ViewportSize(GetDocument().GetLayoutView());
diff --git a/third_party/blink/renderer/core/css/style_engine.h b/third_party/blink/renderer/core/css/style_engine.h
index 09f3d63575..730d8849a4 100644
--- a/third_party/blink/renderer/core/css/style_engine.h
+++ b/third_party/blink/renderer/core/css/style_engine.h
@@ -611,6 +611,8 @@ class CORE_EXPORT StyleEngine final : public GarbageCollected<StyleEngine>,
 
   // Invalidate caches that depends on the base url.
   void BaseURLChanged();
+  // Invalidate caches that depend on the document's referrer policy.
+  void ReferrerPolicyChanged();
 
   unsigned StyleForElementCount() const { return style_for_element_count_; }
   void IncStyleForElementCount() { style_for_element_count_++; }
diff --git a/third_party/blink/renderer/core/dom/document.cc b/third_party/blink/renderer/core/dom/document.cc
index 207f4278b2..4f2f35b46a 100644
--- a/third_party/blink/renderer/core/dom/document.cc
+++ b/third_party/blink/renderer/core/dom/document.cc
@@ -5353,6 +5353,18 @@ CSSStyleSheet& Document::ElementSheet() {
   return *elem_sheet_;
 }
 
+void Document::ReferrerPolicyChanged() {
+  // The element sheet holds no rules; it only carries the CSSParserContext
+  // used for inline style and presentation attributes. That context
+  // snapshots the referrer policy, so drop the sheet and let ElementSheet()
+  // recreate it with the new policy.
+  if (elem_sheet_) {
+    DCHECK(!elem_sheet_->Contents()->RuleCount());
+    elem_sheet_ = nullptr;
+  }
+  GetStyleEngine().ReferrerPolicyChanged();
+}
+
 bool Document::InvalidationDisallowed() const {
   return View() && View()->InvalidationDisallowed();
 }
diff --git a/third_party/blink/renderer/core/dom/document.h b/third_party/blink/renderer/core/dom/document.h
index 166962ca18..10a7b4eb59 100644
--- a/third_party/blink/renderer/core/dom/document.h
+++ b/third_party/blink/renderer/core/dom/document.h
@@ -1058,6 +1058,9 @@ class CORE_EXPORT Document : public ContainerNode,
   static bool ShouldInheritSecurityOriginFromOwner(const KURL&);
 
   CSSStyleSheet& ElementSheet();
+  // Called when the document's referrer policy changes (e.g. via
+  // <meta name="referrer">) to drop cached parser state that snapshots it.
+  void ReferrerPolicyChanged();
 
   virtual DocumentParser* CreateParser();
   DocumentParser* Parser() const { return parser_.Get(); }
diff --git a/third_party/blink/renderer/core/html/html_meta_element.cc b/third_party/blink/renderer/core/html/html_meta_element.cc
index 21aa571783..ef4a80935b 100644
