From e54ba569f5ebf7fe4b1ef39b16c00433b1956222 Mon Sep 17 00:00:00 2001
From: Viktor Semeniuk <vsemeniuk@google.com>
Date: Thu, 22 Oct 2026 07:52:06 -0700
Subject: [PATCH 28/32] [PWM] Validate frame URL in
 UserModifiedNonPasswordField

ContentPasswordManagerDriver::UserModifiedNonPasswordField forwarded
username candidates to PasswordManager without checking that the frame
is allowed to access password data for its URL, unlike the sibling
handlers (PasswordFormsParsed, PasswordFormSubmitted, etc.).
PasswordManager keys the candidate by the signon realm of the frame's
last committed URL, which for a sandboxed iframe is the precursor
origin's URL. A compromised sandboxed iframe could therefore inject a
username candidate for its precursor origin's Username First Flow.

Add a HasValidURL() check. Don't kill the renderer on failure, since
legitimate renderers also send this message from opaque-origin frames.

Fixed: 521476204
Change-Id: I5a6114a9d94a3927a9d9de7272599c37b6227447
Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8629349
Reviewed-by: Maria Kazinova <kazinova@google.com>
Commit-Queue: Viktor Semeniuk <vsemeniuk@google.com>
Cr-Commit-Position: refs/heads/main@{#1724760}
---
 .../content_password_manager_driver.cc        |  7 +++
 ...ontent_password_manager_driver_unittest.cc | 45 +++++++++++++++++++
 2 files changed, 52 insertions(+)

diff --git a/components/password_manager/content/browser/content_password_manager_driver.cc b/components/password_manager/content/browser/content_password_manager_driver.cc
index 58c8707fe8..84e9ea3d2e 100644
--- a/components/password_manager/content/browser/content_password_manager_driver.cc
+++ b/components/password_manager/content/browser/content_password_manager_driver.cc
@@ -668,6 +668,13 @@ void ContentPasswordManagerDriver::UserModifiedNonPasswordField(
   if (!CheckFrameActiveAndNotPrerendering(render_frame_host_)) {
     return;
   }
+  // Frames that can't access password data for their URL's origin (e.g.
+  // sandboxed iframes, whose URL refers to the precursor origin) must not
+  // record username candidates. Legitimate renderers send this message from
+  // such frames too, so don't kill the renderer.
+  if (!HasValidURL(/*may_kill_renderer=*/false)) {
+    return;
+  }
   GetPasswordManager()->OnUserModifiedNonPasswordField(
       this, renderer_id, value, autocomplete_attribute_has_username,
       is_likely_otp);
diff --git a/components/password_manager/content/browser/content_password_manager_driver_unittest.cc b/components/password_manager/content/browser/content_password_manager_driver_unittest.cc
index 8ab5f95b44..d01fb813d7 100644
--- a/components/password_manager/content/browser/content_password_manager_driver_unittest.cc
+++ b/components/password_manager/content/browser/content_password_manager_driver_unittest.cc
@@ -30,6 +30,7 @@
 #include "content/public/browser/navigation_entry.h"
 #include "content/public/browser/ssl_status.h"
 #include "content/public/browser/web_contents.h"
+#include "content/public/test/mock_render_process_host.h"
 #include "content/public/test/navigation_simulator.h"
 #include "content/public/test/test_renderer_host.h"
 #include "content/public/test/web_contents_tester.h"
@@ -196,6 +197,14 @@ class MockPasswordManager : public PasswordManager {
               OnPasswordFormCleared,
               (PasswordManagerDriver * driver, const autofill::FormData&),
               (override));
+  MOCK_METHOD(void,
+              OnUserModifiedNonPasswordField,
+              (PasswordManagerDriver * driver,
+               autofill::FieldRendererId renderer_id,
+               const std::u16string& value,
+               bool autocomplete_attribute_has_username,
+               bool is_likely_otp),
+              (override));
   MOCK_METHOD(PasswordFormCache*, GetPasswordFormCache, (), (override));
 };
 
@@ -442,6 +451,42 @@ TEST_F(ContentPasswordManagerDriverURLTest, PasswordFormCleared) {
   driver()->PasswordFormCleared(form);
 }
 
+TEST_F(ContentPasswordManagerDriverURLTest, UserModifiedNonPasswordField) {
+  EXPECT_CALL(password_manager_,
+              OnUserModifiedNonPasswordField(
+                  _, autofill::FieldRendererId(1), std::u16string(u"username"),
+                  /*autocomplete_attribute_has_username=*/true,
+                  /*is_likely_otp=*/false));
+
+  driver()->UserModifiedNonPasswordField(
+      autofill::FieldRendererId(1), u"username",
+      /*autocomplete_attribute_has_username=*/
+      true, /*is_likely_otp=*/false);
+}
+
+// Frames that are not allowed to access password data for their URL must not
+// record username candidates. The renderer must not be killed, since
+// legitimate renderers may send this message from such frames.
+TEST_F(ContentPasswordManagerDriverURLTest,
+       UserModifiedNonPasswordFieldIgnoredForInvalidURL) {
+  NavigateAndCommit(GURL("data:text/html,<input>"));
+  // The navigation may have swapped the RenderFrameHost, so create a driver
+  // for the current one.
+  driver_ = std::make_unique<ContentPasswordManagerDriver>(
+      main_rfh(), &password_manager_client_);
+  content::MockRenderProcessHost* process =
+      static_cast<content::MockRenderProcessHost*>(main_rfh()->GetProcess());
+  int bad_msg_count = process->bad_msg_count();
+
+  EXPECT_CALL(password_manager_, OnUserModifiedNonPasswordField).Times(0);
+
+  driver()->UserModifiedNonPasswordField(
+      autofill::FieldRendererId(1), u"username",
+      /*autocomplete_attribute_has_username=*/
+      true, /*is_likely_otp=*/false);
+  EXPECT_EQ(bad_msg_count, process->bad_msg_count());
+}
+
 TEST_F(ContentPasswordManagerDriverTest,
        PasswordAutofillDisabledOnCredentiallessIframe) {
   NavigateAndCommit(GURL("https://test.org"));
-- 
