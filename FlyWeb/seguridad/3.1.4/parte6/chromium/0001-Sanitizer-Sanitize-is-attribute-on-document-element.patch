From 74ced9b4421d888b77b2859e1051631ea829bc2e Mon Sep 17 00:00:00 2001
From: Daniel Vogelheim <vogelheim@chromium.org>
Date: Tue, 13 Oct 2026 02:19:06 -0700
Subject: [PATCH 01/32] [Sanitizer] Sanitize is= attribute on document element.

In Document.parseHTML (and Document.parseHTMLUnsafe) treats the document
element seperately and has a seperate code path for it
(HTMLContrsuctionSite::InsertHMLStartTagInBody). This code path was
overlooked in crrev.com/c/7883146 and now also checks whether the is=
attribute is allowed on this element.

Fixed: 571722742
Change-Id: If99538f13a6b741f28c50db1b0001d8cf147c342
Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8559025
Reviewed-by: Noam Rosenthal <nrosenthal@google.com>
Commit-Queue: Daniel Vogelheim <vogelheim@chromium.org>
Cr-Commit-Position: refs/heads/main@{#1717444}
---
 .../html/parser/html_construction_site.cc     |  7 +++-
 ...anitizer-custom-elements-is.tentative.html | 41 +++++++++++++++++++
 2 files changed, 47 insertions(+), 1 deletion(-)

diff --git a/third_party/blink/renderer/core/html/parser/html_construction_site.cc b/third_party/blink/renderer/core/html/parser/html_construction_site.cc
index b97249b38f..ced27a633d 100644
--- a/third_party/blink/renderer/core/html/parser/html_construction_site.cc
+++ b/third_party/blink/renderer/core/html/parser/html_construction_site.cc
@@ -458,7 +458,12 @@ void HTMLConstructionSite::InsertHTMLHtmlStartTagBeforeHTML(
     AtomicHTMLToken* token) {
   DCHECK(document_);
   HTMLHtmlElement* element;
-  if (const auto* is_attribute = token->GetAttributeItem(html_names::kIsAttr)) {
+  const auto* is_attribute = token->GetAttributeItem(html_names::kIsAttr);
+  const auto* active_sanitizer = ActiveSanitizer();
+  bool sanitizer_allows_is_attribute =
+      is_attribute && (!active_sanitizer || active_sanitizer->AllowIsAttribute(
+                                                html_names::kHTMLTag));
+  if (is_attribute && sanitizer_allows_is_attribute) {
     element = To<HTMLHtmlElement>(document_->CreateElement(
         html_names::kHTMLTag, GetCreateElementFlags(), is_attribute->Value(),
         CustomElementRegistry::DefaultRegistry(*document_)));
diff --git a/third_party/blink/web_tests/external/wpt/sanitizer-api/sanitizer-custom-elements-is.tentative.html b/third_party/blink/web_tests/external/wpt/sanitizer-api/sanitizer-custom-elements-is.tentative.html
index 62cf4e8687..f61d1ada13 100644
--- a/third_party/blink/web_tests/external/wpt/sanitizer-api/sanitizer-custom-elements-is.tentative.html
+++ b/third_party/blink/web_tests/external/wpt/sanitizer-api/sanitizer-custom-elements-is.tentative.html
@@ -90,6 +90,47 @@ test(t => {
 test(t => {
   assert_kept({ elements: [{ name: "div", attributes: ["is"] }], attributes: [] });
 }, "The is= attribute is kept when allowed by local attributes.");
+
+
+function assert_removed_parseHTML(sanitizer, element) {
+  constructor_called = connectedCallback_called = false;
+
+  // To have meaningful test results with parseHTML, we need to always allow
+  // "html" and "body". But since those might also be in the config, we need
+  // to be a bit careful in when to allow them.
+  if (sanitizer && sanitizer.elements && sanitizer.elements[0].name != "html")
+    sanitizer.elements.push("html");
+  if (sanitizer && sanitizer.elements && sanitizer.elements[0].name != "body")
+    sanitizer.elements.push("body");
+
+  const doc = Document.parseHTML(`<${element} is="foo-bar">hello</${element}>`, { sanitizer } );
+  assert_equals(doc.body.innerText, `hello`);
+  assert_equals(doc.getElementsByTagName(element).length, 1);
+  const parsed_element = doc.getElementsByTagName(element)[0];
+  assert_false(parsed_element.hasAttribute("is"));
+  assert_true(parsed_element.matches(":defined"));
+
+  assert_false(constructor_called);
+  assert_false(connectedCallback_called);
+}
+
+for (element of ["html", "body", "div"]) {
+  test(t => {
+    assert_removed_parseHTML("default", element);
+}, `parseHTML removes ${element} is= attribute with the default sanitizer config.`);
+
+  test(t => {
+    assert_removed_parseHTML({ removeAttributes: ["is"] }, element);
+  }, `parseHTML removes ${element} is= attribute with global removeAttributes`);
+
+  test(t => {
+    assert_removed_parseHTML({ elements: [{ name: element, removeAttributes: ["is"] }], removeAttributes: [] }, element);
+  }, `parseHTML removes ${element} is= attribute with local removeAttributes`);
+
+  test(t => {
+    assert_removed_parseHTML({ elements: [{ name: element, attributes: [] }], attributes: [] }, element);
+  }, `parseHTML removes ${element} is= attribute with local allow attributes`);
+}
 </script>
 </body>
 </html>
