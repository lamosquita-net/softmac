From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrea Orru <andreaorru@chromium.org>
Date: Fri, 16 Oct 2026 16:43:14 -0700
Subject: [PATCH 18/18] [Extensions] Disallow error pages from allowlisting DNR
 frames

When a navigation fails and commits an error page,
RenderFrameHost::GetLastCommittedURL() retains the failed destination
URL rather than an error URL. Cross-document URL spoofing on error
commits was addressed separately in crbug.com/511736672; this CL handles
the genuine failed URL.

Previously, Declarative Net Request evaluated allowAllRequests rules
against error-page navigations, allowing an error document whose failed
URL matched an allowAllRequests rule to poison allowlisted_frames_ and
exempt its subresource loads from DNR rules.

Skip evaluating allowAllRequests rules for a frame's own navigation when
committing or same-document navigating within an error document, while
still updating allowlisted_frames_ to evict any stale entry from a prior
document in the same RenderFrameHost and preserve any allowlist
inherited from an ancestor frame.

Fixed: 519999855
Change-Id: Ic2099d36696cfcd58725c67344a9e613d1a50202
Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8574062
Reviewed-by: Kelvin Jiang <kelvinjiang@chromium.org>
Commit-Queue: Andrea Orru <andreaorru@chromium.org>
Cr-Commit-Position: refs/heads/main@{#1721175}
(cherry picked from commit c06e1d94a232)

[FlyWeb] Applied on top of 0016 (22a2af917b), the reverse of the upstream
order: OnDidFinishNavigation() is taken whole from upstream after both
commits (it sets `has_host_access` inside the new error-document branch);
the new test passes `has_host_access_for_navigation`, as upstream does.
---
 .../ruleset_matcher_base.cc                   |  99 +++++++-----
 .../ruleset_matcher_unittest.cc               | 144 ++++++++++++++++++
 2 files changed, 203 insertions(+), 40 deletions(-)

diff --git a/extensions/browser/api/declarative_net_request/ruleset_matcher_base.cc b/extensions/browser/api/declarative_net_request/ruleset_matcher_base.cc
index ce7c251a1..518e3a3d6 100644
--- a/extensions/browser/api/declarative_net_request/ruleset_matcher_base.cc
+++ b/extensions/browser/api/declarative_net_request/ruleset_matcher_base.cc
@@ -268,49 +268,68 @@ void RulesetMatcherBase::OnDidFinishNavigation(
   // Hence we need not listen to OnRenderFrameCreated.
   DCHECK(host);
 
-  RequestParams params(host, navigation_handle->IsPost(),
-                       /*response_headers=*/nullptr);
-  params.has_host_access[extension_id_] = has_host_access_for_navigation;
-
-  // Find the highest priority allowAllRequests action corresponding to this
-  // frame for rules that match in the onBeforeRequest request stage.
-  std::optional<RequestAction> frame_action =
-      GetAllowAllRequestsAction(params, RulesetMatchingStage::kOnBeforeRequest);
-
-  // The only navigation requests that match DNR rules in the OnHeadersReceived
-  // request phase are HTTP/HTTPS and will have response headers. So in this
-  // method, if a navigation request:
-  //  - has response headers, then match it against rules for both the
-  //    `kOnBeforeRequest` and `kOnHeadersReceived` stages.
-  //  - has no response headers, then only match against rule for the
-  //    `kOnBeforeRequest` stage.
-  // TODO(crbug.com/331846139): Add filtering logic to limit which requests can
-  // be matched here, similar to what's done in the webrequest event router for
-  // OnBeforeRequest and OnHeadersReceived.
-  if (navigation_handle->GetResponseHeaders()) {
-    // The allow rule cache from `params` does not need to be copied into
-    // `params_with_headers` since it won't have an effect on the final value of
-    // `frame_action`.
-    RequestParams params_with_headers(host, navigation_handle->IsPost(),
-                                      navigation_handle->GetResponseHeaders());
-    // Rules with response header conditions that require host permissions
-    // must not allowlist the frame if the extension doesn't have host access
-    // to the navigation, since allowlisting the frame would bypass
-    // subresource rules and leak whether the header value matched.
-    params_with_headers.has_host_access[extension_id_] =
-        has_host_access_for_navigation;
-    // Take the matching allowAllRequests action with the highest priority
-    // between all ruleset matching stages that this navigation request can be
-    // matched against.
-    frame_action = GetMaxPriorityAction(
-        std::move(frame_action),
-        GetAllowAllRequestsAction(params_with_headers,
-                                  RulesetMatchingStage::kOnHeadersReceived));
+  // Error documents retain the failed destination URL in GetLastCommittedURL()
+  // and must never grant allowAllRequests privileges for their own navigation
+  // (including subsequent same-document navigations within an error page).
+  // However, we still update `allowlisted_frames_` below to evict any stale
+  // entry from a prior document in `host` and preserve any allowlist inherited
+  // from an ancestor frame.
+  //
+  // Check for an empty URL first, as util::GetURLForExtensionPermissionCheck()
+  // does, since IsErrorDocument() CHECKs that `host` is not speculative.
+  const bool is_error_document =
+      navigation_handle->IsErrorPage() ||
+      (!host->GetLastCommittedURL().is_empty() && host->IsErrorDocument());
+
+  std::optional<RequestAction> frame_action;
+  if (!is_error_document) {
+    RequestParams params(host, navigation_handle->IsPost(),
+                         /*response_headers=*/nullptr);
+    params.has_host_access[extension_id_] = has_host_access_for_navigation;
+
+    // Find the highest priority allowAllRequests action corresponding to this
+    // frame for rules that match in the onBeforeRequest request stage.
+    frame_action = GetAllowAllRequestsAction(
+        params, RulesetMatchingStage::kOnBeforeRequest);
+
+    // The only navigation requests that match DNR rules in the
+    // OnHeadersReceived request phase are HTTP/HTTPS and will have response
+    // headers. So in this method, if a navigation request:
+    //  - has response headers, then match it against rules for both the
+    //    `kOnBeforeRequest` and `kOnHeadersReceived` stages.
+    //  - has no response headers, then only match against rule for the
+    //    `kOnBeforeRequest` stage.
+    // TODO(crbug.com/331846139): Add filtering logic to limit which requests
+    // can be matched here, similar to what's done in the webrequest event
+    // router for OnBeforeRequest and OnHeadersReceived.
+    if (navigation_handle->GetResponseHeaders()) {
+      // The allow rule cache from `params` does not need to be copied into
+      // `params_with_headers` since it won't have an effect on the final value
+      // of `frame_action`.
+      RequestParams params_with_headers(
+          host, navigation_handle->IsPost(),
+          navigation_handle->GetResponseHeaders());
+      // Rules with response header conditions that require host permissions
+      // must not allowlist the frame if the extension doesn't have host access
+      // to the navigation, since allowlisting the frame would bypass
+      // subresource rules and leak whether the header value matched.
+      params_with_headers.has_host_access[extension_id_] =
+          has_host_access_for_navigation;
+      // Take the matching allowAllRequests action with the highest priority
+      // between all ruleset matching stages that this navigation request can be
+      // matched against.
+      frame_action = GetMaxPriorityAction(
+          std::move(frame_action),
+          GetAllowAllRequestsAction(params_with_headers,
+                                    RulesetMatchingStage::kOnHeadersReceived));
+    }
   }
 
+  content::RenderFrameHost* parent = host->GetParentOrOuterDocument();
+  std::optional<RequestAction> parent_action =
+      parent ? GetAllowlistedFrameAction(parent->GetGlobalId()) : std::nullopt;
   std::optional<RequestAction> action =
-      GetMaxPriorityAction(GetAllowlistedFrameAction(params.parent_routing_id),
-                           std::move(frame_action));
+      GetMaxPriorityAction(std::move(parent_action), std::move(frame_action));
 
   content::GlobalRenderFrameHostId frame_id = host->GetGlobalId();
   allowlisted_frames_.erase(frame_id);
diff --git a/extensions/browser/api/declarative_net_request/ruleset_matcher_unittest.cc b/extensions/browser/api/declarative_net_request/ruleset_matcher_unittest.cc
index dae9075a8..7d1e10364 100644
--- a/extensions/browser/api/declarative_net_request/ruleset_matcher_unittest.cc
+++ b/extensions/browser/api/declarative_net_request/ruleset_matcher_unittest.cc
@@ -39,6 +39,7 @@
 #include "extensions/common/api/declarative_net_request/test_utils.h"
 #include "extensions/common/extension_features.h"
 #include "extensions/common/features/feature_channel.h"
+#include "net/base/net_errors.h"
 #include "net/http/http_request_headers.h"
 #include "net/http/http_response_headers.h"
 #include "testing/gmock/include/gmock/gmock.h"
@@ -1405,6 +1406,149 @@ TEST_F(AllowAllRequestsTest, AllowlistedFrameTracking) {
   EXPECT_FALSE(action);
 }
 
+// Regression test for crbug.com/519999855: verifies that error documents do not
+// gain allowAllRequests privileges from their failed destination URL (neither
+// on initial error commit nor on subsequent same-document navigations), evict
+// stale self-allowlist entries on same-RFH error commits, and still preserve
+// any allowlist action inherited from an enclosing allowlisted parent frame.
+TEST_F(AllowAllRequestsTest, ErrorDocumentTracking) {
+  TestRule parent_allow_rule = CreateGenericRule();
+  parent_allow_rule.id = kMinValidID;
+  parent_allow_rule.condition->url_filter = "||parent-allowed.com";
+  parent_allow_rule.condition->resource_types =
+      std::vector<std::string>({"main_frame"});
+  parent_allow_rule.action->type = "allowAllRequests";
+  parent_allow_rule.priority = 2;
+
+  TestRule subframe_allow_rule = CreateGenericRule();
+  subframe_allow_rule.id = kMinValidID + 1;
+  subframe_allow_rule.condition->url_filter = "||corp-intranet.com";
+  subframe_allow_rule.condition->resource_types =
+      std::vector<std::string>({"sub_frame"});
+  subframe_allow_rule.action->type = "allowAllRequests";
+  subframe_allow_rule.priority = 10;
+
+  TestRule block_rule = CreateGenericRule();
+  block_rule.id = kMinValidID + 2;
+  block_rule.condition->url_filter = "||tracker.com";
+  block_rule.action->type = "block";
+  block_rule.priority = 5;
+
+  std::unique_ptr<RulesetMatcher> matcher;
+  ASSERT_TRUE(CreateVerifiedMatcher(
+      {parent_allow_rule, subframe_allow_rule, block_rule},
+      CreateTemporarySource(), &matcher));
+
+  auto notify_committed = [&matcher](content::RenderFrameHost* host,
+                                     const GURL& url, bool is_error_page) {
+    testing::NiceMock<content::MockNavigationHandle> navigation_handle(url,
+                                                                       host);
+    navigation_handle.set_has_committed(true);
+    navigation_handle.set_is_error_page(is_error_page);
+    matcher->OnDidFinishNavigation(&navigation_handle,
+                                   /*has_host_access_for_navigation=*/true);
+  };
+
+  std::unique_ptr<content::WebContents> web_contents =
+      content::WebContentsTester::CreateTestWebContents(
+          browser_context(), content::SiteInstance::Create(browser_context()));
+  ASSERT_TRUE(web_contents);
+
+  // 1. Navigate main frame to a non-allowlisted page and append a child frame.
+  const GURL untrusted_main_url("https://attacker.com/");
+  content::NavigationSimulator::NavigateAndCommitFromBrowser(
+      web_contents.get(), untrusted_main_url);
+  content::RenderFrameHost* main_rfh = web_contents->GetPrimaryMainFrame();
+  notify_committed(main_rfh, untrusted_main_url, /*is_error_page=*/false);
+  EXPECT_FALSE(matcher->GetAllowlistedFrameActionForTesting(main_rfh));
+
+  content::RenderFrameHost* child =
+      content::RenderFrameHostTester::For(main_rfh)->AppendChild("sub_frame");
+  ASSERT_TRUE(child);
+
+  // 2. Navigate child frame to https://corp-intranet.com/ and fail (e.g.,
+  // ERR_BLOCKED_BY_CSP). Even though GetLastCommittedURL() holds
+  // https://corp-intranet.com/, the error document must not be allowlisted and
+  // block rules must still apply to its subresource loads.
+  const GURL blocked_allowlisted_url("https://corp-intranet.com/secret");
+  content::RenderFrameHost* error_child =
+      content::NavigationSimulator::NavigateAndFailFromDocument(
+          blocked_allowlisted_url, net::ERR_BLOCKED_BY_CSP, child);
+  ASSERT_TRUE(error_child);
+  ASSERT_TRUE(error_child->IsErrorDocument());
+  ASSERT_EQ(blocked_allowlisted_url, error_child->GetLastCommittedURL());
+
+  notify_committed(error_child, blocked_allowlisted_url,
+                   /*is_error_page=*/true);
+  EXPECT_FALSE(matcher->GetAllowlistedFrameActionForTesting(error_child));
+
+  // Verify subresource requests from `error_child` are blocked by `block_rule`.
+  GURL tracker_url("https://tracker.com/probe.gif");
+  RequestParams subresource_params;
+  subresource_params.url = &tracker_url;
+  subresource_params.element_type = url_pattern_index::flat::ElementType_IMAGE;
+  subresource_params.parent_routing_id = error_child->GetGlobalId();
+  EXPECT_EQ(CreateRequestActionForTesting(RequestAction::Type::COLLAPSE,
+                                          *block_rule.id, *block_rule.priority),
+            matcher->GetAction(subresource_params,
+                               RulesetMatchingStage::kOnBeforeRequest));
+
+  // 3. Simulate a same-document navigation inside `error_child` (where
+  // NavigationHandle::IsErrorPage() is false while host->IsErrorDocument()
+  // remains true). The error document must still not be allowlisted.
+  const GURL fragment_url("https://corp-intranet.com/secret#fragment");
+  notify_committed(error_child, fragment_url, /*is_error_page=*/false);
+  EXPECT_FALSE(matcher->GetAllowlistedFrameActionForTesting(error_child));
+
+  // 4. Commit a valid navigation to https://corp-intranet.com/ in the subframe,
+  // then simulate an error page committing in the same RenderFrameHost to
+  // verify the stale self-allowlist entry is evicted.
+  content::RenderFrameHost* allowed_child =
+      content::NavigationSimulator::NavigateAndCommitFromDocument(
+          blocked_allowlisted_url, error_child);
+  ASSERT_TRUE(allowed_child);
+  ASSERT_FALSE(allowed_child->IsErrorDocument());
+  notify_committed(allowed_child, blocked_allowlisted_url,
+                   /*is_error_page=*/false);
+  EXPECT_EQ(CreateRequestActionForTesting(
+                RequestAction::Type::ALLOW_ALL_REQUESTS,
+                *subframe_allow_rule.id, *subframe_allow_rule.priority),
+            matcher->GetAllowlistedFrameActionForTesting(allowed_child));
+
+  // Simulate an error commit in the same RenderFrameHost. This intentionally
+  // exercises the NavigationHandle::IsErrorPage() branch while the host's last
+  // committed URL still matches `subframe_allow_rule`, verifying that the stale
+  // self-allowlist entry is evicted rather than re-added.
+  notify_committed(allowed_child, blocked_allowlisted_url,
+                   /*is_error_page=*/true);
+  EXPECT_FALSE(matcher->GetAllowlistedFrameActionForTesting(allowed_child));
+
+  // 5. Navigate main frame to https://parent-allowed.com/ (priority 2) and fail
+  // a child subframe navigation to https://corp-intranet.com/ (priority 10):
+  // the error child must inherit the parent's priority-2 action rather than
+  // gaining the failed URL's priority-10 action.
+  const GURL allowed_main_url("https://parent-allowed.com/");
+  content::NavigationSimulator::NavigateAndCommitFromBrowser(web_contents.get(),
+                                                             allowed_main_url);
+  main_rfh = web_contents->GetPrimaryMainFrame();
+  notify_committed(main_rfh, allowed_main_url, /*is_error_page=*/false);
+  RequestAction parent_action = CreateRequestActionForTesting(
+      RequestAction::Type::ALLOW_ALL_REQUESTS, *parent_allow_rule.id,
+      *parent_allow_rule.priority);
+  EXPECT_EQ(parent_action,
+            matcher->GetAllowlistedFrameActionForTesting(main_rfh));
+
+  child = content::RenderFrameHostTester::For(main_rfh)->AppendChild("sub2");
+  ASSERT_TRUE(child);
+  error_child = content::NavigationSimulator::NavigateAndFailFromDocument(
+      blocked_allowlisted_url, net::ERR_BLOCKED_BY_CSP, child);
+  ASSERT_TRUE(error_child);
+  notify_committed(error_child, blocked_allowlisted_url,
+                   /*is_error_page=*/true);
+  EXPECT_EQ(parent_action,
+            matcher->GetAllowlistedFrameActionForTesting(error_child));
+}
+
 // Ensures that GetBeforeRequestAction correctly incorporates allowAllRequests
 // rules.
 TEST_F(AllowAllRequestsTest, GetBeforeRequestAction) {
