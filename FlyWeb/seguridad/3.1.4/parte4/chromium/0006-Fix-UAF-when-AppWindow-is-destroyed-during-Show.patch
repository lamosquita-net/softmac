diff --git a/chrome/browser/apps/platform_apps/app_window_browsertest.cc b/chrome/browser/apps/platform_apps/app_window_browsertest.cc
index 0af52dd5f..de121d352 100644
--- a/chrome/browser/apps/platform_apps/app_window_browsertest.cc
+++ b/chrome/browser/apps/platform_apps/app_window_browsertest.cc
@@ -318,6 +318,33 @@ class TestAppWindowClient : public ChromeAppWindowClient {
   }
 };
 
+class ClosingOnShowWindow : public native_app_window::NativeAppWindowViews {
+ public:
+  ClosingOnShowWindow() = default;
+  ~ClosingOnShowWindow() override = default;
+
+  void Show() override {
+    // Simulate synchronous window closure during Show() (e.g. as can happen
+    // when spinning a nested run loop or during synchronous activation
+    // observer notifications).
+    widget()->CloseNow();
+  }
+};
+
+class ClosingOnShowAppWindowClient : public ChromeAppWindowClient {
+ public:
+  ClosingOnShowAppWindowClient() = default;
+  ~ClosingOnShowAppWindowClient() override = default;
+
+  std::unique_ptr<extensions::NativeAppWindow> CreateNativeAppWindow(
+      extensions::AppWindow* window,
+      extensions::AppWindow::CreateParams* params) override {
+    auto native_window = std::make_unique<ClosingOnShowWindow>();
+    native_window->Init(window, *params);
+    return native_window;
+  }
+};
+
 }  // namespace
 
 // Regression test for crbug.com/516948486.
@@ -425,6 +452,48 @@ IN_PROC_BROWSER_TEST_F(AppWindowAPITest, UafInAppWindowCreateForcedFullscreen) {
   extensions::AppWindowClient::Set(ChromeAppWindowClient::GetInstance());
 }
 
+// Regression test for crbug.com/553159779: when `chrome.app.window.create()`
+// is called with a window `id` matching an existing singleton window,
+// `AppWindowCreateFunction::Run()` calls `existing_window->Show()`. If `Show()`
+// synchronously closes the native window and deletes `AppWindow`, `Show()` and
+// `AppWindowCreateFunction::Run()` must not continue accessing the destroyed
+// `AppWindow`.
+IN_PROC_BROWSER_TEST_F(AppWindowAPITest,
+                       UafInAppWindowCreateExistingWindowShow) {
+  const extensions::Extension* extension = LoadExtension(
+      test_data_dir_.AppendASCII("platform_apps").AppendASCII("window_api"));
+  ASSERT_TRUE(extension);
+
+  ClosingOnShowAppWindowClient test_client;
+  extensions::AppWindowClient::Set(nullptr);
+  extensions::AppWindowClient::Set(&test_client);
+
+  extensions::ProcessManager* process_manager =
+      extensions::ProcessManager::Get(browser()->GetProfile());
+  extensions::ExtensionHost* background_host =
+      process_manager->GetBackgroundHostForExtension(extension->id());
+  ASSERT_TRUE(background_host);
+
+  EXPECT_EQ("App window is closed before ready to commit first navigation.",
+            content::EvalJs(background_host->host_contents(), R"(
+              new Promise(resolve => {
+                chrome.app.window.create(
+                    'test.html', {id: 'singleton', hidden: true}, () => {
+                      chrome.app.window.create(
+                          'test.html', {id: 'singleton'}, () => {
+                            resolve(chrome.runtime.lastError
+                                        ? chrome.runtime.lastError.message
+                                        : 'ok');
+                          });
+                    });
+              })
+            )"));
+  EXPECT_EQ(0u, GetAppWindowCount());
+
+  extensions::AppWindowClient::Set(nullptr);
+  extensions::AppWindowClient::Set(ChromeAppWindowClient::GetInstance());
+}
+
 IN_PROC_BROWSER_TEST_F(AppWindowAPITest,
                        RendererInitiatedCrossProcessNavigationBlocked) {
   ASSERT_TRUE(StartEmbeddedTestServer());
diff --git a/extensions/browser/api/app_window/app_window_api.cc b/extensions/browser/api/app_window/app_window_api.cc
index a80c6dd51..b69ddf26e 100644
--- a/extensions/browser/api/app_window/app_window_api.cc
+++ b/extensions/browser/api/app_window/app_window_api.cc
@@ -200,10 +200,18 @@ ExtensionFunction::ResponseAction AppWindowCreateFunction::Run() {
           }
 
           if (!options->hidden || !*options->hidden) {
+            // Showing the existing window may synchronously close the native
+            // window and destroy `existing_window`.
+            base::WeakPtr<AppWindow> weak_existing_window =
+                existing_window->GetWeakPtr();
             if (options->focused && !*options->focused)
               existing_window->Show(AppWindow::SHOW_INACTIVE);
             else
               existing_window->Show(AppWindow::SHOW_ACTIVE);
+            if (!weak_existing_window) {
+              return RespondNow(
+                  Error(app_window_constants::kPrematureWindowClose));
+            }
           }
 
           // We should not return the window until that window is properly
diff --git a/extensions/browser/app_window/app_window.cc b/extensions/browser/app_window/app_window.cc
index 91cfa657b..2a85dbf0c 100644
--- a/extensions/browser/app_window/app_window.cc
+++ b/extensions/browser/app_window/app_window.cc
@@ -740,6 +740,7 @@ void AppWindow::Show(ShowType show_type) {
   bool was_hidden = is_hidden_ || !has_been_shown_;
   is_hidden_ = false;
 
+  base::WeakPtr<AppWindow> weak_this = weak_ptr_factory_.GetWeakPtr();
   switch (show_type) {
     case SHOW_ACTIVE:
       GetBaseWindow()->Show();
@@ -748,13 +749,20 @@ void AppWindow::Show(ShowType show_type) {
       GetBaseWindow()->ShowInactive();
       break;
   }
+  if (!weak_this) {
+    return;
+  }
   AppWindowRegistry::Get(browser_context_)->AppWindowShown(this, was_hidden);
   has_been_shown_ = true;
 }
 
 void AppWindow::Hide() {
   is_hidden_ = true;
+  base::WeakPtr<AppWindow> weak_this = weak_ptr_factory_.GetWeakPtr();
   GetBaseWindow()->Hide();
+  if (!weak_this) {
+    return;
+  }
   AppWindowRegistry::Get(browser_context_)->AppWindowHidden(this);
   app_delegate_->OnHide();
 }
