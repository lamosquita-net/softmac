 .../declarative_net_request/request_params.cc | 30 +++++---
 .../ruleset_matcher_unittest.cc               | 70 +++++++++++++++++++
 2 files changed, 92 insertions(+), 8 deletions(-)

diff --git a/extensions/browser/api/declarative_net_request/request_params.cc b/extensions/browser/api/declarative_net_request/request_params.cc
index 24edd4184..2a91f79d2 100644
--- a/extensions/browser/api/declarative_net_request/request_params.cc
+++ b/extensions/browser/api/declarative_net_request/request_params.cc
@@ -5,6 +5,7 @@
 #include "extensions/browser/api/declarative_net_request/request_params.h"
 
 #include <algorithm>
+#include <functional>
 #include <optional>
 #include <string_view>
 
@@ -22,6 +23,7 @@
 #include "extensions/browser/api/declarative_net_request/constants.h"
 #include "extensions/browser/api/declarative_net_request/flat/extension_ruleset_generated.h"
 #include "extensions/browser/api/declarative_net_request/utils.h"
+#include "extensions/browser/api/extensions_api_client.h"
 #include "extensions/browser/api/web_request/web_request_info.h"
 #include "extensions/browser/extensions_browser_client.h"
 #include "extensions/common/api/web_request/web_request_resource_type.h"
@@ -90,13 +92,15 @@ bool HasHeaderValue(const net::HttpResponseHeaders& response_headers,
 
 // Returns true if the request's response headers matches at least one condition
 // in `header_conditions`. A header matches a condition if:
-// - the header exists AND
+// - the header exists and is not hidden from extensions AND
 // - contains a value in condition->values() if specified AND
 // - does not contain any values in condition->excluded_values() if specified.
 bool MatchesHeaderConditions(
+    const GURL& url,
     const net::HttpResponseHeaders& response_headers,
     const flatbuffers::Vector<flatbuffers::Offset<flat::HeaderCondition>>&
         header_conditions) {
+  ExtensionsAPIClient* api_client = ExtensionsAPIClient::Get();
   for (const flat::HeaderCondition* header_condition : header_conditions) {
     std::string_view header =
         CreateString<std::string_view>(*header_condition->header());
@@ -104,6 +108,13 @@ bool MatchesHeaderConditions(
       continue;
     }
 
+    // Treat headers that should be hidden from extensions as absent, so that
+    // their presence or values cannot be observed through rule matching.
+    if (api_client &&
+        api_client->ShouldHideResponseHeader(url, std::string(header))) {
+      continue;
+    }
+
     // Match on the existence of the header if no values or excluded values are
     // specified.
     if (!header_condition->values() && !header_condition->excluded_values()) {
@@ -136,6 +147,7 @@ bool MatchesHeaderConditions(
 
 bool DoEmbedderConditionsMatch(
     bool has_host_access,
+    const GURL& url,
     int tab_id,
     const std::string& top_level_frame_or_initiator_host,
     scoped_refptr<const net::HttpResponseHeaders> response_headers,
@@ -217,7 +229,7 @@ bool DoEmbedderConditionsMatch(
     // match.
     if (embedder_conditions->excluded_response_headers() &&
         MatchesHeaderConditions(
-            *response_headers,
+            url, *response_headers,
             *embedder_conditions->excluded_response_headers())) {
       return false;
     }
@@ -225,7 +237,7 @@ bool DoEmbedderConditionsMatch(
     // Do not match the rule if no conditions in `response_headers()` match.
     if (embedder_conditions->response_headers() &&
         embedder_conditions->response_headers()->size() &&
-        !MatchesHeaderConditions(*response_headers,
+        !MatchesHeaderConditions(url, *response_headers,
                                  *embedder_conditions->response_headers())) {
       return false;
     }
@@ -240,9 +252,10 @@ void InitEmbedderConditionsMatchers(
     int tab_id,
     const std::string& top_level_frame_or_initiator_host,
     scoped_refptr<const net::HttpResponseHeaders> response_headers) {
-  params.embedder_conditions_matcher_with_host_access = base::BindRepeating(
-      DoEmbedderConditionsMatch, /*has_host_access=*/true, tab_id,
-      top_level_frame_or_initiator_host, response_headers);
+  params.embedder_conditions_matcher_with_host_access =
+      base::BindRepeating(DoEmbedderConditionsMatch, /*has_host_access=*/true,
+                          std::cref(*params.url), tab_id,
+                          top_level_frame_or_initiator_host, response_headers);
 
   // If restricting response header value matching is disabled, rules which
   // would otherwise require host permissions are matched regardless.
@@ -251,8 +264,9 @@ void InitEmbedderConditionsMatchers(
           kDeclarativeNetRequestRestrictResponseHeaderValueMatching);
   params.embedder_conditions_matcher_without_host_access = base::BindRepeating(
       DoEmbedderConditionsMatch,
-      /*has_host_access=*/!restrict_header_value_matching, tab_id,
-      top_level_frame_or_initiator_host, std::move(response_headers));
+      /*has_host_access=*/!restrict_header_value_matching,
+      std::cref(*params.url), tab_id, top_level_frame_or_initiator_host,
+      std::move(response_headers));
 }
 
 }  // namespace
diff --git a/extensions/browser/api/declarative_net_request/ruleset_matcher_unittest.cc b/extensions/browser/api/declarative_net_request/ruleset_matcher_unittest.cc
index 96e5e9d5b..dae9075a8 100644
--- a/extensions/browser/api/declarative_net_request/ruleset_matcher_unittest.cc
+++ b/extensions/browser/api/declarative_net_request/ruleset_matcher_unittest.cc
@@ -31,6 +31,7 @@
 #include "extensions/browser/api/declarative_net_request/request_params.h"
 #include "extensions/browser/api/declarative_net_request/test_utils.h"
 #include "extensions/browser/api/declarative_net_request/utils.h"
+#include "extensions/browser/api/extensions_api_client.h"
 #include "extensions/browser/extensions_test.h"
 #include "extensions/buildflags/buildflags.h"
 #include "extensions/common/api/declarative_net_request.h"
@@ -1877,5 +1878,74 @@ TEST_F(RulesetMatcherResponseHeadersTest, MatchOnResponseHeaders) {
   }
 }
 
+// Test that response headers hidden from extensions by
+// ExtensionsAPIClient::ShouldHideResponseHeader are treated as absent when
+// matching response header conditions.
+TEST_F(RulesetMatcherResponseHeadersTest, HiddenResponseHeadersNotMatched) {
+  class TestExtensionsAPIClient : public ExtensionsAPIClient {
+   public:
+    bool ShouldHideResponseHeader(
+        const GURL& url,
+        const std::string& header_name) const override {
+      return url.host() == "hidden.com" &&
+             base::EqualsCaseInsensitiveASCII(header_name, "secret");
+    }
+  };
+  TestExtensionsAPIClient api_client;
+
+  // `rule_1` matches if the secret header is present with a value starting
+  // with "a" (i.e. a value-probing rule).
+  TestRule rule_1 = CreateGenericRule(kMinValidID);
+  rule_1.action->type = std::string("block");
+  rule_1.condition->url_filter = std::string("|http://");
+  rule_1.condition->response_headers = std::vector<TestHeaderCondition>(
+      {TestHeaderCondition("secret", {"a*"}, {})});
+
+  // `rule_2` does not match if the secret header is present.
+  TestRule rule_2 = CreateGenericRule(kMinValidID + 1);
+  rule_2.action->type = std::string("block");
+  rule_2.condition->url_filter = std::string("|https://");
+  rule_2.condition->excluded_response_headers =
+      std::vector<TestHeaderCondition>({TestHeaderCondition("secret", {}, {})});
+
+  std::unique_ptr<RulesetMatcher> matcher;
+  ASSERT_TRUE(CreateVerifiedMatcher({rule_1, rule_2}, CreateTemporarySource(),
+                                    &matcher));
+  ASSERT_TRUE(matcher);
+
+  struct Cases {
+    std::string url;
+    std::optional<RequestAction> expected_action;
+  };
+  auto cases = std::to_array<Cases>({
+      // The secret header is visible for non-hidden hosts.
+      {"http://visible.com", CreateRequestActionForTesting(
+                                 RequestAction::Type::COLLAPSE, kMinValidID)},
+      {"https://visible.com", std::nullopt},
+
+      // The secret header is hidden for hidden.com, so `rule_1` does not match
+      // and `rule_2` is not excluded.
+      {"http://hidden.com", std::nullopt},
+      {"https://hidden.com",
+       CreateRequestActionForTesting(RequestAction::Type::COLLAPSE,
+                                     kMinValidID + 1)},
+  });
+
+  auto base_headers = base::MakeRefCounted<net::HttpResponseHeaders>(
+      net::HttpUtil::AssembleRawHeaders("HTTP/1.0 200 OK\r\nSecret: abc\r\n"));
+  for (size_t i = 0; i < std::size(cases); ++i) {
+    SCOPED_TRACE(base::StringPrintf("Testing case[%" PRIuS "]", i));
+    GURL url(cases[i].url);
+    ASSERT_TRUE(url.is_valid());
+
+    RequestParams params =
+        CreateRequestWithResponseHeaders(url, base_headers.get());
+    params.has_host_access[kExtensionId] = true;
+    EXPECT_EQ(
+        cases[i].expected_action,
+        matcher->GetAction(params, RulesetMatchingStage::kOnHeadersReceived));
+  }
+}
+
 }  // namespace
 }  // namespace extensions::declarative_net_request
