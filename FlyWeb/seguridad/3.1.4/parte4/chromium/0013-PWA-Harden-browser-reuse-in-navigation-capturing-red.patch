+  }
+
+ protected:
+  static constexpr char kControllableRedirectPath[] =
+      "/web_apps/simple2/controllable_redirect.html";
+  std::unique_ptr<net::test_server::ControllableHttpResponse>
+      controllable_redirect_response_;
