     PruneNoOpsTraverser prune(symbolTable);
     root->traverse(&prune);
     ASSERT(prune.mSwitchPrunedDeclarationsStack.empty());
-    return prune.updateTree(compiler, root);
+    if (!prune.updateTree(compiler, root))
