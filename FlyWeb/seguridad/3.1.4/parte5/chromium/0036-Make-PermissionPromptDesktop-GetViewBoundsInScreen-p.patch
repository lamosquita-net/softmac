 .../exclusive_access_permission_prompt.h      |  1 +
 ...ve_access_permission_prompt_browsertest.cc | 21 +++++++++++++++++++
 .../permissions/permission_prompt_desktop.cc  |  5 -----
 .../permissions/permission_prompt_desktop.h   |  2 +-
