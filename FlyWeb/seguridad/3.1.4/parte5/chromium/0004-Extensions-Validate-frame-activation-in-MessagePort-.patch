+// Verifies that the browser process validates `Message::user_gesture` against
+// the sending `content::RenderFrameHost`'s `HasTransientUserActivation()` state
+// when dispatching a message over `mojom::MessagePortHost::PostMessage`.
+IN_PROC_BROWSER_TEST_F(ExtensionSecurityExploitBrowserTest,
+                       PostMessageUserGestureRequiresFrameActivation) {
+  // Load a test extension with a content script and a background service
+  // worker that reports whether `chrome.test.isProcessingUserGesture()` is
+  // `true` when `chrome.runtime.onMessage` is triggered.
+  TestExtensionDir dir;
+  dir.WriteManifest(R"({
+    "name": "user_gesture receiver",
+    "version": "1.0",
+    "manifest_version": 3,
+    "content_scripts": [{
+      "matches": ["*://foo.com/*"],
+      "js": ["content_script.js"]
+    }],
+    "background": {"service_worker": "background.js"}
+  })");
+  dir.WriteFile(FILE_PATH_LITERAL("content_script.js"),
+                "chrome.test.sendMessage('content script ready');");
+  dir.WriteFile(FILE_PATH_LITERAL("background.js"), R"(
+    chrome.runtime.onMessage.addListener((msg, sender, sendResponse) => {
+      chrome.test.sendMessage(
+          'gesture:' + chrome.test.isProcessingUserGesture());
+    });
+  )");
+  const Extension* extension = LoadExtension(dir.UnpackedPath());
+  ASSERT_TRUE(extension);
+
+  // Navigate to a page matching the content script so that the renderer
+  // process is registered with `ScriptInjectionTracker` as running a content
+  // script for `extension`.
+  GURL page_url =
+      embedded_test_server()->GetURL(/*hostname=*/"foo.com",
+                                     /*relative_url=*/"/title1.html");
+  content::WebContents* web_contents = GetActiveWebContents();
+  {
+    ExtensionTestMessageListener ready_listener(
+        /*expected_message=*/"content script ready");
+    ASSERT_TRUE(NavigateToURL(web_contents, page_url));
+    {
+      SCOPED_TRACE("Waiting for content script ready message");
+      ASSERT_TRUE(ready_listener.WaitUntilSatisfied());
+    }
+  }
+  content::RenderFrameHost* main_frame = web_contents->GetPrimaryMainFrame();
+  content::RenderProcessHost* process = main_frame->GetProcess();
+
+  // Helper lambda that opens a message channel from `main_frame` to
+  // `extension` and posts a `Message` with `user_gesture` set to `true`
+  // directly over `mojom::MessagePortHost`, returning the gesture status
+  // observed by the extension service worker.
+  auto post_message_with_forged_user_gesture = [&]() -> std::string {
+    ChannelEndpoint source(profile(), process->GetDeprecatedID(),
+                           PortContext::ForFrame(main_frame->GetRoutingID()));
+    PortId source_port_id(/*context_id=*/base::UnguessableToken::Create(),
+                          /*port_number=*/0, /*is_opener=*/true,
+                          mojom::SerializationFormat::kJson);
+    mojom::ExternalConnectionInfo info;
+    info.target_id = extension->id();
+    info.source_endpoint = MessagingEndpoint::ForContentScript(extension->id());
+    info.source_url = page_url;
+
+    // Calling `chrome.runtime.sendMessage()` from JavaScript in an
+    // uncompromised renderer runs `messaging_util::GetMessageMetadata()` first,
+    // which sets `user_gesture` to `false` when `main_frame` lacks user
+    // activation. To simulate a compromised (or slow) renderer sending an IPC
+    // with `user_gesture` set to `true`, bypass the JavaScript bindings and
+    // send a raw `Message` over `mojom::MessagePortHost` directly.
+    //
+    // `MessageService::OpenChannelToExtension()` requires both a
+    // `mojom::MessagePort` remote (for browser-to-renderer messages and
+    // disconnect notifications) and a `mojom::MessagePortHost` receiver (for
+    // renderer-to-browser messages). `test_port` keeps the
+    // `mojom::MessagePort` pipe alive while `port_host_remote` posts the
+    // message to the browser.
+    TestMessagePort test_port(/*quit_closure=*/base::DoNothing());
+    mojo::AssociatedReceiver<mojom::MessagePort> port_receiver(&test_port);
+    mojo::PendingAssociatedRemote<mojom::MessagePort> port_remote =
+        port_receiver.BindNewEndpointAndPassDedicatedRemote();
+    mojo::AssociatedRemote<mojom::MessagePortHost> port_host_remote;
+    mojo::PendingAssociatedReceiver<mojom::MessagePortHost> port_host_receiver =
+        port_host_remote.BindNewEndpointAndPassDedicatedReceiver();
+
+    MessageService::Get(profile())->OpenChannelToExtension(
+        source, source_port_id, info, mojom::ChannelType::kSendMessage,
+        /*channel_name=*/"chrome.runtime.sendMessage", std::move(port_remote),
+        std::move(port_host_receiver));
+
+    ExtensionTestMessageListener gesture_listener;
+    port_host_remote->PostMessage(
+        Message(/*data=*/std::string(R"("hello")"), /*user_gesture=*/true));
+    port_host_remote.FlushForTesting();
+    {
+      SCOPED_TRACE("Waiting for service worker gesture status message");
+      EXPECT_TRUE(gesture_listener.WaitUntilSatisfied());
+    }
+    return gesture_listener.message();
+  };
+
+  // Verify that `main_frame` currently has no transient user activation.
+  ASSERT_FALSE(main_frame->HasTransientUserActivation());
+
+  // Check whether the receiving service worker observes a user gesture when
+  // `main_frame` has no transient user activation.
+  std::string result_without_activation =
+      post_message_with_forged_user_gesture();
+
+  // Expect that when `main_frame->HasTransientUserActivation()` is `false`, the
+  // browser overrides `user_gesture` to `false` so the receiver observes
+  // `"gesture:false"`. If the bug is present (unpatched),
+  // `result_without_activation` evaluates to `"gesture:true"`, failing this
+  // assertion and confirming the vulnerability is reproduced.
+  EXPECT_EQ("gesture:false", result_without_activation);
+
+  // Grant real transient user activation to `main_frame` and verify that
+  // `user_gesture` is preserved when legitimate activation exists.
+  ASSERT_TRUE(content::ExecJs(main_frame, /*script=*/""));
+  ASSERT_TRUE(main_frame->HasTransientUserActivation());
+  EXPECT_EQ("gesture:true", post_message_with_forged_user_gesture());
+}
+
+// Verifies that when a user clicks an extension action (dispatching
+// `chrome.action.onClicked` to the extension service worker) it synthesizes a
+// user gesture (`ServiceWorkerData::DispatchEventToListeners()`), and when the
+// service worker sends a message to a frame via `chrome.tabs.sendMessage()`,
+// `MessagePort::PostMessage()` preserves `Message::user_gesture` so the
+// receiving frame observes an active user gesture.
+IN_PROC_BROWSER_TEST_F(ExtensionSecurityExploitBrowserTest,
+                       ActionOnClickedServiceWorkerToFrameUserGesture) {
+  // Load a test extension with an action, a background service worker that
+  // listens to `chrome.action.onClicked` and forwards its gesture state to the
+  // clicked tab via `chrome.tabs.sendMessage()`, and a content script in the
+  // frame that reports both the sender and receiver gesture states.
+  TestExtensionDir dir;
+  dir.WriteManifest(R"({
+    "name": "action sw to frame gesture",
+    "version": "1.0",
+    "manifest_version": 3,
+    "action": {},
+    "background": {"service_worker": "background.js"},
+    "content_scripts": [{
+      "matches": ["*://foo.com/*"],
+      "js": ["content_script.js"]
+    }]
+  })");
+  dir.WriteFile(FILE_PATH_LITERAL("background.js"), R"(
+    chrome.action.onClicked.addListener((tab) => {
+      const swGesture = chrome.test.isProcessingUserGesture();
+      chrome.tabs.sendMessage(tab.id, 'sender_gesture:' + swGesture);
+    });
+    chrome.test.sendMessage('sw ready');
+  )");
+  dir.WriteFile(FILE_PATH_LITERAL("content_script.js"), R"(
+    chrome.runtime.onMessage.addListener((msg, sender, sendResponse) => {
+      chrome.test.sendMessage(
+          msg + ',receiver_gesture:' + chrome.test.isProcessingUserGesture());
+    });
+    chrome.test.sendMessage('content script ready');
+  )");
+
+  ExtensionTestMessageListener sw_onclicked_listener_registered(
+      /*expected_message=*/"sw ready");
+  const Extension* extension = LoadExtension(dir.UnpackedPath());
+  ASSERT_TRUE(extension);
+  {
+    SCOPED_TRACE("Waiting for service worker onClicked listener to register");
+    ASSERT_TRUE(sw_onclicked_listener_registered.WaitUntilSatisfied());
+  }
+
+  // Navigate to a page matching the content script and wait for it to load.
+  GURL page_url =
+      embedded_test_server()->GetURL(/*hostname=*/"foo.com",
+                                     /*relative_url=*/"/title1.html");
+  content::WebContents* web_contents = GetActiveWebContents();
+  {
+    ExtensionTestMessageListener content_script_onmessage_listener_registered(
+        /*expected_message=*/"content script ready");
+    ASSERT_TRUE(NavigateToURL(web_contents, page_url));
+    {
+      SCOPED_TRACE("Waiting for content script onMessage listener to register");
+      ASSERT_TRUE(
+          content_script_onmessage_listener_registered.WaitUntilSatisfied());
+    }
+  }
+  content::RenderFrameHost* main_frame = web_contents->GetPrimaryMainFrame();
+  ASSERT_FALSE(main_frame->HasTransientUserActivation());
+
+  // Simulate the user clicking the extension action button via
+  // `ExtensionActionRunner::RunAction()`, which dispatches
+  // `chrome.action.onClicked` with `EventRouter::UserGestureState::kEnabled`.
+  ExtensionTestMessageListener gesture_result_listener;
+  ExtensionActionRunner::GetForWebContents(web_contents)
+      ->RunAction(extension, /*grant_tab_permissions=*/true);
+
+  // Verify that `chrome.action.onClicked` synthesized a user gesture in the
+  // service worker and that `MessagePort::PostMessage()` preserved
+  // `Message::user_gesture` when delivering the message to `main_frame`.
+  {
+    SCOPED_TRACE("Waiting for gesture passing result message");
+    ASSERT_TRUE(gesture_result_listener.WaitUntilSatisfied());
+  }
+  EXPECT_EQ("sender_gesture:true,receiver_gesture:true",
+            gesture_result_listener.message());
+}
+
+// Test fixture for messages sent from an extension page opened in a tab
+// (`mojom::ViewType::kTabContents`) to a content script in another tab.
+class ExtensionTabFrameUserGestureTest
+    : public ExtensionSecurityExploitBrowserTest {
+ public:
+  void TearDownOnMainThread() override {
+    extension_ = nullptr;
+    extension_frame_ = nullptr;
+    target_web_contents_ = nullptr;
+    ExtensionSecurityExploitBrowserTest::TearDownOnMainThread();
+  }
+
+ protected:
+  // Loads a Manifest V3 extension with an action, opens its `frame.html` page
+  // in the active tab, and opens `foo.com` in a new tab where the extension's
+  // content script runs. `frame.html` sends `"sender_gesture:<bool>"` to the
+  // `foo.com` tab from its `chrome.action.onClicked` listener and from
+  // `window.sendMessageToTab()`. The content script reports each message it
+  // receives, with `",receiver_gesture:<bool>"` appended, via
+  // `chrome.test.sendMessage()`.
+  void LoadExtensionAndOpenTabs() {
+    // Write the extension. `frame.js` reports its own gesture state as the
+    // sender and `content_script.js` appends its gesture state as the
+    // receiver.
+    test_dir_.WriteManifest(R"({
+      "name": "extension tab frame to frame gesture",
+      "version": "1.0",
+      "manifest_version": 3,
+      "action": {},
+      "content_scripts": [{
+        "matches": ["*://foo.com/*"],
+        "js": ["content_script.js"]
+      }]
+    })");
+    test_dir_.WriteFile(FILE_PATH_LITERAL("frame.html"),
+                        "<script src=\"frame.js\"></script>");
+    test_dir_.WriteFile(FILE_PATH_LITERAL("frame.js"), R"(
+      chrome.action.onClicked.addListener((tab) => {
+        const frameGesture = chrome.test.isProcessingUserGesture();
+        chrome.tabs.sendMessage(tab.id, 'sender_gesture:' + frameGesture);
+      });
+      window.sendMessageToTab = (tabId) => {
+        const frameGesture = chrome.test.isProcessingUserGesture();
+        chrome.tabs.sendMessage(tabId, 'sender_gesture:' + frameGesture);
+      };
+      chrome.test.sendMessage('extension frame ready');
+    )");
+    test_dir_.WriteFile(FILE_PATH_LITERAL("content_script.js"), R"(
+      chrome.runtime.onMessage.addListener((msg, sender, sendResponse) => {
+        chrome.test.sendMessage(
+            msg + ',receiver_gesture:' + chrome.test.isProcessingUserGesture());
+      });
+      chrome.test.sendMessage('content script ready');
+    )");
+    extension_ = LoadExtension(test_dir_.UnpackedPath());
+    ASSERT_TRUE(extension_);
+
+    // Open `frame.html` in the active tab and wait for its listeners to be
+    // registered.
+    content::WebContents* extension_web_contents = GetActiveWebContents();
+    ExtensionTestMessageListener frame_ready(
+        /*expected_message=*/"extension frame ready");
+    ASSERT_TRUE(NavigateToURL(extension_web_contents,
+                              extension_->GetResourceURL("frame.html")));
+    {
+      SCOPED_TRACE("Waiting for extension frame listeners to register");
+      ASSERT_TRUE(frame_ready.WaitUntilSatisfied());
+    }
+    extension_frame_ = extension_web_contents->GetPrimaryMainFrame();
+    ASSERT_TRUE(extension_frame_);
+
+    // Open `foo.com` in a new tab so the content script loads there. This tab
+    // becomes the active tab passed to `chrome.action.onClicked`.
+    GURL page_url =
+        embedded_test_server()->GetURL(/*hostname=*/"foo.com",
+                                       /*relative_url=*/"/title1.html");
+    ExtensionTestMessageListener content_script_ready(
+        /*expected_message=*/"content script ready");
+    content::RenderFrameHost* target_frame = NavigateToURLInNewTab(page_url);
+    ASSERT_TRUE(target_frame);
+    target_web_contents_ =
+        content::WebContents::FromRenderFrameHost(target_frame);
+    ASSERT_TRUE(target_web_contents_);
+    {
+      SCOPED_TRACE("Waiting for content script onMessage listener to register");
+      ASSERT_TRUE(content_script_ready.WaitUntilSatisfied());
+    }
+
+    // `extension_frame_` should not have user activation before each test acts.
+    ASSERT_FALSE(extension_frame_->HasTransientUserActivation());
+  }
+
+  const Extension* extension() const { return extension_.get(); }
+  content::RenderFrameHost* extension_frame() const {
+    return extension_frame_.get();
+  }
+  content::WebContents* target_web_contents() const {
+    return target_web_contents_.get();
+  }
+
+ private:
+  TestExtensionDir test_dir_;
+  raw_ptr<const Extension> extension_ = nullptr;
+  raw_ptr<content::RenderFrameHost> extension_frame_ = nullptr;
+  raw_ptr<content::WebContents> target_web_contents_ = nullptr;
+};
+
+// Verifies that an extension page opened in a tab
+// (`mojom::ViewType::kTabContents`) does not get a synthesized user gesture
+// when it handles `chrome.action.onClicked`, so a message it sends from that
+// listener has `user_gesture = false`.
+//
+// This test does not cover a frame with a synthesized gesture.
+// `Dispatcher::DispatchEvent()` only synthesizes a frame gesture (via
+// `WebLocalFrame::NotifyUserActivation()`) for
+// `mojom::ViewType::kExtensionBackgroundPage`, which only exists in Manifest
+// V2. In Manifest V3 the extension service worker is the context that gets a
+// synthesized gesture for extension events (see
+// `ActionOnClickedServiceWorkerToFrameUserGesture`).
+//
+// The message leaves the extension renderer with `user_gesture = false` (set by
+// `messaging_util::GetMessageMetadata()`), so the `false` result is not caused
+// by the browser-side check in `MessagePort::PostMessage()`, which only runs
+// when `user_gesture` is `true`.
+IN_PROC_BROWSER_TEST_F(
+    ExtensionTabFrameUserGestureTest,
+    ActionOnClickedExtensionTabFrameHasNoSynthesizedGesture) {
+  // Load the extension and open `frame.html` and the `foo.com` target tab.
+  ASSERT_NO_FATAL_FAILURE(LoadExtensionAndOpenTabs());
+
+  // Simulate the user clicking the extension action. The only
+  // `chrome.action.onClicked` listener is in `extension_frame()`, which is not
+  // a background page, so `Dispatcher::DispatchEvent()` does not synthesize a
+  // gesture for it and `chrome.test.isProcessingUserGesture()` is `false` in
+  // the listener.
+  ExtensionTestMessageListener action_click_listener;
+  ExtensionActionRunner::GetForWebContents(target_web_contents())
+      ->RunAction(extension(), /*grant_tab_permissions=*/true);
+  {
+    SCOPED_TRACE("Waiting for message from action click");
+    ASSERT_TRUE(action_click_listener.WaitUntilSatisfied());
+  }
+
+  // Verify that the message was sent without a gesture and that the action
+  // click did not give `extension_frame()` user activation.
+  EXPECT_EQ("sender_gesture:false,receiver_gesture:false",
+            action_click_listener.message());
+  EXPECT_FALSE(extension_frame()->HasTransientUserActivation());
+}
+
+// Verifies that `MessagePort::PostMessage()` keeps `user_gesture = true` for a
+// message sent by an extension page opened in a tab when the sending frame has
+// real transient user activation
+// (`RenderFrameHost::HasTransientUserActivation()`). This shows that the
+// browser-side check does not block a frame that has a real gesture.
+IN_PROC_BROWSER_TEST_F(
+    ExtensionTabFrameUserGestureTest,
+    ExtensionTabFrameWithTransientActivationSendsUserGesture) {
+  // Load the extension and open `frame.html` and the `foo.com` target tab.
+  ASSERT_NO_FATAL_FAILURE(LoadExtensionAndOpenTabs());
+  int target_tab_id = ExtensionTabUtil::GetTabId(target_web_contents());
+
+  // Give `extension_frame()` real transient user activation
+  // (`content::ExecJs()` runs the script with a simulated user gesture by
+  // default) and send a message from it. `messaging_util::GetMessageMetadata()`
+  // sets `user_gesture = true` in the renderer.
+  ExtensionTestMessageListener activated_frame_listener;
+  ASSERT_TRUE(content::ExecJs(
+      extension_frame(),
+      base::StringPrintf("window.sendMessageToTab(%d);", target_tab_id)));
+  ASSERT_TRUE(extension_frame()->HasTransientUserActivation());
+  {
+    SCOPED_TRACE("Waiting for message from frame with user activation");
+    ASSERT_TRUE(activated_frame_listener.WaitUntilSatisfied());
+  }
+
+  // Verify that `MessagePort::PostMessage()` kept `user_gesture = true`
+  // because the sending frame has transient user activation, so the receiver
+  // observes a gesture.
+  EXPECT_EQ("sender_gesture:true,receiver_gesture:true",
+            activated_frame_listener.message());
+}
+
 }  // namespace extensions
diff --git a/extensions/browser/api/messaging/message_port.cc b/extensions/browser/api/messaging/message_port.cc
index 6524e76438..a8fad62a59 100644
--- a/extensions/browser/api/messaging/message_port.cc
+++ b/extensions/browser/api/messaging/message_port.cc
@@ -5,7 +5,10 @@
 #include "extensions/browser/api/messaging/message_port.h"
 
 #include <optional>
+#include <utility>
 
+#include "content/public/browser/render_frame_host.h"
+#include "extensions/common/api/messaging/message.h"
 #include "extensions/common/api/messaging/port_context.h"
 
 namespace extensions {
@@ -67,6 +70,34 @@ void MessagePort::PostMessage(Message message) {
   if (!weak_channel_delegate_) {
     return;
   }
+  // Verify `message.user_gesture()` against the sending frame's browser-side
+  // `HasTransientUserActivation()` state so a compromised frame renderer cannot
+  // arbitrarily forge `user_gesture` set to `true` over Mojo. Unlike
+  // `messaging_util::GetMessageMetadata()` in the renderer, this check does not
+  // query `LastActivationWasRestricted()` because `content::RenderFrameHost`
+  // does not expose `RenderFrameHostImpl::user_activation_state_`'s restricted
+  // state. Additionally, a compromised renderer can still spoof unrestricted
+  // frame user activation via `blink::mojom::LocalFrameHost`'s
+  // `UpdateUserActivationState()` IPC until browser-first user activation
+  // tracking (https://crbug.com/848778) is implemented.
+  if (message.user_gesture()) {
+    // `receivers_.current_context()` is the context
+    // `MessagePort::AddReceiver()` bound to the `mojom::MessagePortHost`
+    // receiver this call arrived on, which identifies the endpoint that sent
+    // `message`. Only frame senders are checked. Service worker senders are not
+    // checked: their gesture is synthesized in the renderer by
+    // `ExtensionInteractionProvider::Scope::ForWorker()` and is not tracked by
+    // the browser, so there is no browser-side state to verify it against.
+    const auto& [sender_process_id, sender_port_context] =
+        receivers_.current_context();
+    if (sender_port_context.is_for_render_frame()) {
+      content::RenderFrameHost* sender_frame = content::RenderFrameHost::FromID(
+          sender_process_id, sender_port_context.frame->routing_id);
+      if (!sender_frame || !sender_frame->HasTransientUserActivation()) {
+        message.set_user_gesture(false);
+      }
+    }
+  }
   weak_channel_delegate_->PostMessage(port_id_, std::move(message));
 }
 
diff --git a/extensions/common/api/messaging/message.h b/extensions/common/api/messaging/message.h
index 53323dd9da..d9ff68265e 100644
--- a/extensions/common/api/messaging/message.h
+++ b/extensions/common/api/messaging/message.h
@@ -114,6 +114,7 @@ class Message {
                : mojom::SerializationFormat::kStructuredClone;
   }
   bool user_gesture() const { return user_gesture_; }
+  void set_user_gesture(bool user_gesture) { user_gesture_ = user_gesture; }
   bool from_privileged_context() const { return from_privileged_context_; }
 
  private:
