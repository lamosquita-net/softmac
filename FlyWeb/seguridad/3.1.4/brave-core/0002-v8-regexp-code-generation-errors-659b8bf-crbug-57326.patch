+@@ -5850,6 +5850,7 @@ EmitResult ActionNode::Emit(Compiler* compiler, Trace* trace) {
+   RegExpMacroAssembler* assembler = compiler->macro_assembler();
+   LimitResult limit_result = LimitVersions(compiler, trace);
+   if (limit_result == DONE) return EmitResult::Success();
++  if (limit_result == FAILED) return EmitResult::Error();
+   DCHECK(limit_result == CONTINUE);
+ 
+   RecursionCheck rc(compiler);
+@@ -5878,7 +5879,7 @@ EmitResult ActionNode::Emit(Compiler* compiler, Trace* trace) {
+         // Complex situation: Flush the trace state to the assembler and
+         // generate a generic version of this action.  This call will
+         // recurse back to the else clause here.
+-        trace->Flush(compiler, this);
++        return trace->Flush(compiler, this);
+       } else {
+         assembler->WriteCurrentPositionToRegister(
+             data_.u_submatch.current_position_register, 0);
+@@ -5902,7 +5903,7 @@ EmitResult ActionNode::Emit(Compiler* compiler, Trace* trace) {
+         // immediately.
+         RETURN_IF_ERROR(on_success()->Emit(compiler, trace));
+       } else if (!trace->is_trivial()) {
+-        trace->Flush(compiler, this);
++        return trace->Flush(compiler, this);
+       } else {
+         Label skip_empty_check;
+         // If we have a minimum number of repetitions we check the current
+@@ -5991,6 +5992,7 @@ EmitResult BackReferenceNode::Emit(Compiler* compiler, Trace* trace) {
+ 
+   LimitResult limit_result = LimitVersions(compiler, trace);
+   if (limit_result == DONE) return EmitResult::Success();
++  if (limit_result == FAILED) return EmitResult::Error();
+   DCHECK(limit_result == CONTINUE);
+ 
+   RecursionCheck rc(compiler);
