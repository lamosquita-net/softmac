+<!DOCTYPE html>
+<script src="../../resources/testharness.js"></script>
+<script src="../../resources/testharnessreport.js"></script>
+<div id="outer1">
+  <object id="obj1" type="text/html" data="about:blank">
+    <svg><foreignObject><canvas></canvas></foreignObject></svg>
+  </object>
+</div>
+<div id="outer2">
+  <object id="obj2" type="text/html" data="about:blank">
+    <svg><foreignObject><canvas></canvas></foreignObject></svg>
+  </object>
+</div>
+<script>
+async_test((t) => {
+  const outer = document.getElementById('outer1');
+  const obj = document.getElementById('obj1');
+  const canvas = outer.querySelector('canvas');
+  const home = canvas.parentNode;
+  const ctx = canvas.getContext('2d');
+  const other = document.implementation.createHTMLDocument();
+
+  EventTarget.prototype.addEventListener.call(obj, 'load', t.step_func_done(() => {
+    ctx.filter = 'url(#none)';
+    obj.contentWindow.onpagehide = () => {
+      other.adoptNode(canvas);
+      canvas.width = 17;
+      home.append(canvas);
+    };
+
+    outer.style.display = 'none';
+    outer.offsetWidth;
+    getComputedStyle(canvas).color;
+    Element.prototype.setAttribute.call(obj, 'type', 'image/png');
+    Element.prototype.setAttribute.call(obj, 'data', 'data:image/png,x');
+    ctx.fillRect(0, 0, 10, 10);
+
+    const data = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
+    assert_true(data.some((v) => v !== 0), 'Expected fillRect to draw pixels');
+  }));
+}, 'Canvas2D fillRect does not crash and draws pixels when filter style recalc resizes canvas');
+
+async_test((t) => {
+  const outer = document.getElementById('outer2');
+  const obj = document.getElementById('obj2');
+  const canvas = outer.querySelector('canvas');
+  const home = canvas.parentNode;
+  const ctx = canvas.getContext('2d');
+  const other = document.implementation.createHTMLDocument();
+
+  EventTarget.prototype.addEventListener.call(obj, 'load', t.step_func_done(() => {
+    ctx.filter = 'url(#none)';
+    obj.contentWindow.onpagehide = () => {
+      other.adoptNode(canvas);
+      canvas.width = 17;
+      home.append(canvas);
+    };
+
+    outer.style.display = 'none';
+    outer.offsetWidth;
+    getComputedStyle(canvas).color;
+    Element.prototype.setAttribute.call(obj, 'type', 'image/png');
+    Element.prototype.setAttribute.call(obj, 'data', 'data:image/png,x');
+    ctx.beginLayer();
+    ctx.fillRect(0, 0, 10, 10);
+    ctx.endLayer();
+
+    const data = ctx.getImageData(0, 0, canvas.width, canvas.height).data;
+    assert_true(data.some((v) => v !== 0), 'Expected layer to draw pixels');
+  }));
+}, 'Canvas2D beginLayer does not crash and draws pixels when filter style recalc resizes canvas');
+</script>
