---
 pdf/pdfium/pdfium_page.cc | 14 ++++++++++++++
 pdf/pdfium/pdfium_page.h  |  3 ++-
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/pdf/pdfium/pdfium_page.cc b/pdf/pdfium/pdfium_page.cc
index fd08ec70180e9ed0b618b6ad505eac55da4b3352..8a199d15900c36622d3b3b00eedb7597d932ae3e 100644
--- a/pdf/pdfium/pdfium_page.cc
+++ b/pdf/pdfium/pdfium_page.cc
@@ -14,6 +14,7 @@
 #include <utility>
 #include <vector>
 
+#include "base/auto_reset.h"
 #include "base/check_op.h"
 #include "base/containers/extend.h"
 #include "base/containers/span.h"
@@ -468,6 +469,15 @@ bool PDFiumPage::Unload() {
     return false;
   }
 
+  // Also do not unload when already unloading.
+  if (is_unloading_) {
+    return false;
+  }
+
+  base::AutoReset scoped_is_unloading(&is_unloading_, true);
+  // Also mark `this` as unavailable for the duration of Unload().
+  base::AutoReset scoped_unavailable(&available_, false);
+
   text_page_.reset();
 
   if (page_) {
@@ -2024,6 +2034,10 @@ void PDFiumPage::GenerateAndSendThumbnail(float device_pixel_ratio,
 }
 
 void PDFiumPage::MarkAvailable() {
+  if (is_unloading_) {
+    return;
+  }
+
   available_ = true;
 
   // Fulfill pending thumbnail request.
diff --git a/pdf/pdfium/pdfium_page.h b/pdf/pdfium/pdfium_page.h
index 2f384dd6483354157abb50bda78ee2d85626ad1f..5eb02de1f9e5da8a87e0062660156a7f2b6a5065 100644
--- a/pdf/pdfium/pdfium_page.h
+++ b/pdf/pdfium/pdfium_page.h
@@ -451,7 +451,7 @@ class PDFiumPage {
   void GenerateAndSendThumbnail(float device_pixel_ratio,
                                 SendThumbnailCallback send_callback);
 
-  raw_ptr<PDFiumEngine> engine_;
+  raw_ptr<PDFiumEngine> const engine_;
   ScopedFPDFPage page_;
   ScopedFPDFTextPage text_page_;
   uint32_t index_;
@@ -480,6 +480,7 @@ class PDFiumPage {
   std::set<int> page_object_text_run_breaks_;
   base::OnceClosure thumbnail_callback_;
   bool available_ = false;
+  bool is_unloading_ = false;
 
 #if BUILDFLAG(ENABLE_SCREEN_AI_SERVICE)
   // Indicates whether Searchify added text to this page or not. Note that if
