diff --git a/components/safe_browsing/core/browser/db/sb_protocol_manager_util.cc b/components/safe_browsing/core/browser/db/sb_protocol_manager_util.cc
index d40f18125f768d5793d37477be4bb930165edce2..86b8837c46ce3506ec3614fabf5612af7af35445 100644
--- a/components/safe_browsing/core/browser/db/sb_protocol_manager_util.cc
+++ b/components/safe_browsing/core/browser/db/sb_protocol_manager_util.cc
@@ -97,11 +97,19 @@ void GenerateHostVariantsToCheckV5(const std::string& host,
   // wasted on the eTLD).
   // Note: This will automatically fall back to TLD+1 for unknown registries.
   const size_t kMaxHostsToCheck = 4;
+  // `host` was canonicalized by SBProtocolManagerUtil::CanonicalizeUrl(), whose
+  // final steps run Unescape() followed by Escape() (which leaves printable
+  // ASCII characters like '*' unescaped, while escaping characters like spaces,
+  // '#', and '%'). GetDomainAndRegistry() internally runs
+  // net::CanonicalizeHost(), which applies standard GURL host escaping and
+  // re-escapes characters like '*' to "%2A". Re-apply Unescape() and Escape()
+  // to the returned eTLD+1 so it uses the same Safe Browsing escaping as
+  // `host`.
   std::string etld_plus_one =
-      net::registry_controlled_domains::GetDomainAndRegistry(
+      Escape(Unescape(net::registry_controlled_domains::GetDomainAndRegistry(
           host,
           /*filter=*/
-          net::registry_controlled_domains::EXCLUDE_PRIVATE_REGISTRIES);
+          net::registry_controlled_domains::EXCLUDE_PRIVATE_REGISTRIES)));
 
   if (etld_plus_one.empty()) {
     // eTLD+1 is only empty when a TLD+1 does not exist (e.g., single-label
diff --git a/components/safe_browsing/core/browser/db/sb_protocol_manager_util_unittest.cc b/components/safe_browsing/core/browser/db/sb_protocol_manager_util_unittest.cc
index 2d2650fe2389c54baddffcd9004a584b045e68df..6e711e0844deb80898cc311d003e52bb5d63a7de 100644
--- a/components/safe_browsing/core/browser/db/sb_protocol_manager_util_unittest.cc
+++ b/components/safe_browsing/core/browser/db/sb_protocol_manager_util_unittest.cc
@@ -266,6 +266,22 @@ TEST_P(SBProtocolManagerUtilUrlParsingTest, UrlParsing) {
     EXPECT_EQ(hosts[0], "co.uk");
     EXPECT_EQ(hosts[1], "a.co.uk");
   }
+
+  // Host containing '*' (which GURL escapes to "%2A", while Safe Browsing
+  // canonicalization unescapes it back to '*') and '%20' (which Safe Browsing
+  // canonicalization keeps escaped as "%20").
+  url = GURL("http://a.%20b*c.co.uk/1");
+  SBProtocolManagerUtil::GenerateHostsToCheck(url, &hosts);
+  if (GetParam()) {
+    EXPECT_EQ(hosts.size(), 2u);
+    EXPECT_EQ(hosts[0], "%20b*c.co.uk");
+    EXPECT_EQ(hosts[1], "a.%20b*c.co.uk");
+  } else {
+    EXPECT_EQ(hosts.size(), 3u);
+    EXPECT_EQ(hosts[0], "co.uk");
+    EXPECT_EQ(hosts[1], "%20b*c.co.uk");
+    EXPECT_EQ(hosts[2], "a.%20b*c.co.uk");
+  }
 }
 
 // Tests the url canonicalization according to the Safe Browsing spec.
