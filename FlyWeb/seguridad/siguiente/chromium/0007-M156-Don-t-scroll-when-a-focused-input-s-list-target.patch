@@ -0,0 +1,24 @@
+<!DOCTYPE html>
+<meta charset="utf-8">
+<link rel="author" href="mailto:masonf@chromium.org">
+<link rel="help" href="https://crbug.com/583179912">
+
+<input list="list">
+<div id="destination"></div>
+<div id="list"></div>
+<div id="moved">
+  <datalist id="list"><option value="x"></option></datalist>
+  <div id="host">
+    <template shadowrootmode="open"><slot></slot></template>
+    <span></span>
+  </div>
+</div>
+<script>
+  // Moving #moved inserts the <datalist> before the <div id="list">, so the
+  // focused <input> now refers to the <datalist>. That must not force a
+  // layout in the middle of the move.
+  document.querySelector('input').focus();
+  document.body.offsetTop;
+  host.shadowRoot.querySelector('slot').name = 'other';
+  destination.moveBefore(moved, null);
+</script>
diff --git a/third_party/blink/web_tests/external/wpt/dom/nodes/moveBefore/moveBefore-input-list-target-removed-crash.html b/third_party/blink/web_tests/external/wpt/dom/nodes/moveBefore/moveBefore-input-list-target-removed-crash.html
new file mode 100644
index 0000000000..28e65c1870
--- /dev/null
+++ b/third_party/blink/web_tests/external/wpt/dom/nodes/moveBefore/moveBefore-input-list-target-removed-crash.html
@@ -0,0 +1,35 @@
+<!DOCTYPE html>
+<meta charset="utf-8">
+<link rel="author" href="mailto:masonf@chromium.org">
+<link rel="help" href="https://crbug.com/583179912">
+
+<div id="outer">
+  <template shadowrootmode="open">
+    <div id="scroller" style="overflow: auto; height: 20px">
+      <div style="height: 100px"></div>
+    </div>
+    <div style="contain: strict; width: 100px; height: 40px">
+      <div id="inner"></div>
+    </div>
+    <div id="host">
+      <template shadowrootmode="open"><slot></slot></template>
+      <div id="list"></div>
+      <input list="list">
+    </div>
+    <div id="destination"></div>
+  </template>
+</div>
+<datalist id="list"><option value="x"></option></datalist>
+<script>
+  // Moving #host removes the <div id="list"> from the shadow tree, which
+  // changes the list target of the focused <input>. That must not force a
+  // layout in the middle of the move.
+  const root = outer.shadowRoot;
+  const host = root.getElementById('host');
+  root.getElementById('scroller').scrollTop = 5;
+  host.querySelector('input').focus();
+  document.body.offsetTop;
+  host.shadowRoot.querySelector('slot').name = 'other';
+  root.getElementById('inner').style.height = '1px';
+  root.getElementById('destination').moveBefore(host, null);
+</script>
