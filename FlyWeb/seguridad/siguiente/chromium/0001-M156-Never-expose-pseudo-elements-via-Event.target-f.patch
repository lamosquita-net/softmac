diff --git a/third_party/blink/renderer/core/dom/column_pseudo_element.cc b/third_party/blink/renderer/core/dom/column_pseudo_element.cc
index fa951990c3..8e469834b0 100644
--- a/third_party/blink/renderer/core/dom/column_pseudo_element.cc
+++ b/third_party/blink/renderer/core/dom/column_pseudo_element.cc
@@ -4,6 +4,7 @@
 
 #include "third_party/blink/renderer/core/dom/column_pseudo_element.h"
 
+#include "third_party/blink/renderer/core/dom/node_rare_data.h"
 #include "third_party/blink/renderer/core/frame/web_feature.h"
 #include "third_party/blink/renderer/core/layout/layout_box.h"
 #include "third_party/blink/renderer/core/layout/physical_box_fragment.h"
@@ -129,6 +130,17 @@ void ColumnPseudoElement::DetachLayoutTree(bool performing_reattach) {
   ContainerNode::DetachLayoutTree(performing_reattach);
 }
 
+void ColumnPseudoElement::Dispose() {
+  // Other pseudo-elements dispose their child pseudo-elements via
+  // Element::DetachLayoutTree(), which DetachLayoutTree() above bypasses. Do
+  // it here, so that the ::scroll-marker is never left connected under a
+  // disposed ::column.
+  if (NodeRareData* data = RareData()) {
+    data->ClearPseudoElements();
+  }
+  PseudoElement::Dispose();
+}
+
 bool ColumnPseudoElement::LayoutObjectIsNeeded(const DisplayStyle&) const {
   return false;
 }
diff --git a/third_party/blink/renderer/core/dom/column_pseudo_element.h b/third_party/blink/renderer/core/dom/column_pseudo_element.h
index 5e3d9e12a6..e723264065 100644
--- a/third_party/blink/renderer/core/dom/column_pseudo_element.h
+++ b/third_party/blink/renderer/core/dom/column_pseudo_element.h
@@ -34,6 +34,7 @@ class CORE_EXPORT ColumnPseudoElement : public IndexedPseudoElement {
   void AttachLayoutTree(AttachContext&) final;
   void DetachLayoutTree(bool performing_reattach) final;
   bool LayoutObjectIsNeeded(const DisplayStyle&) const final;
+  void Dispose() final;
 
  private:
   PhysicalRect column_rect_;
diff --git a/third_party/blink/renderer/core/dom/element.cc b/third_party/blink/renderer/core/dom/element.cc
index 62fb3efdab..b75695ee61 100644
--- a/third_party/blink/renderer/core/dom/element.cc
+++ b/third_party/blink/renderer/core/dom/element.cc
@@ -9528,22 +9528,11 @@ const ColumnPseudoElementsVector* Element::GetColumnPseudoElements() const {
 }
 
 void Element::ClearColumnPseudoElements(wtf_size_t to_keep) {
-  NodeRareData* data = RareData();
-  if (!data) {
-    return;
-  }
-  wtf_size_t idx = 0u;
-  if (const ColumnPseudoElementsVector* column_pseudo_elements =
-          data->GetColumnPseudoElements()) {
-    for (PseudoElement* column_pseudo_element : *column_pseudo_elements) {
-      if (++idx > to_keep) {
-        if (NodeRareData* column_data = column_pseudo_element->RareData()) {
-          column_data->ClearPseudoElements();
-        }
-      }
-    }
+  if (NodeRareData* data = RareData()) {
+    // Disposing each ::column also disposes its ::scroll-marker (see
+    // ColumnPseudoElement::Dispose()).
+    data->ClearColumnPseudoElements(to_keep);
   }
-  data->ClearColumnPseudoElements(to_keep);
 }
 
 void Element::SetScrollbarPseudoElementStylesDependOnFontMetrics(bool value) {
diff --git a/third_party/blink/renderer/core/dom/events/event.cc b/third_party/blink/renderer/core/dom/events/event.cc
index 344a224b9a..6c25301f12 100644
--- a/third_party/blink/renderer/core/dom/events/event.cc
+++ b/third_party/blink/renderer/core/dom/events/event.cc
@@ -260,10 +260,25 @@ void Event::preventDefault() {
 }
 
 EventTarget* Event::target() const {
-  DCHECK(!target_ || !target_->ToNode() ||
-         !target_->ToNode()->IsPseudoElement())
-      << "Event target should not be a pseudo-element, but got "
-      << target_->ToNode()->DebugName();
+  // Pseudo-elements must never be exposed to script, but `target_` can be one
+  // while script can observe this event. For example, while default event
+  // handlers run, `target_` is a pseudo-element with activation behavior (see
+  // EventDispatcher::DispatchEventPostProcess()), and script run from there
+  // (e.g. a DOMActivate listener) can read the target of an event it kept.
+  // Also, the targets of coalesced and predicted pointer events are set to the
+  // raw dispatch node. Expose the originating element instead, or null if the
+  // pseudo-element is no longer connected (e.g. it has been disposed).
+  Node* node = target_ ? target_->ToNode() : nullptr;
+  if (auto* pseudo_element = DynamicTo<PseudoElement>(node)) {
+    if (!pseudo_element->isConnected()) {
+      return nullptr;
+    }
+    Element* originating_element =
+        &pseudo_element->UltimateOriginatingElement();
+    DCHECK(!originating_element->IsPseudoElement());
+    return originating_element;
+  }
+  DCHECK(!node || !node->IsPseudoElement());
   return target_.Get();
 }
 
diff --git a/third_party/blink/renderer/core/dom/pseudo_element_data.h b/third_party/blink/renderer/core/dom/pseudo_element_data.h
index 953affc5a5..f80ac87aa8 100644
--- a/third_party/blink/renderer/core/dom/pseudo_element_data.h
+++ b/third_party/blink/renderer/core/dom/pseudo_element_data.h
@@ -53,17 +53,24 @@ class PseudoElementData final : public GarbageCollected<PseudoElementData>,
     column_pseudo_elements_->push_back(column_pseudo_element);
   }
   void ClearColumnPseudoElements(wtf_size_t to_keep) {
-    if (!column_pseudo_elements_) {
+    if (!column_pseudo_elements_ ||
+        to_keep >= column_pseudo_elements_->size()) {
       return;
     }
+    // Remove the elements from the vector before disposing them, since
+    // disposing can re-enter and modify the vector.
+    HeapVector<Member<ColumnPseudoElement>> to_dispose;
     for (wtf_size_t i = to_keep; i < column_pseudo_elements_->size(); ++i) {
-      column_pseudo_elements_->at(i)->Dispose();
+      to_dispose.push_back(column_pseudo_elements_->at(i));
     }
     if (to_keep) {
       column_pseudo_elements_->Shrink(to_keep);
     } else {
       column_pseudo_elements_->clear();
     }
+    for (ColumnPseudoElement* column_pseudo_element : to_dispose) {
+      column_pseudo_element->Dispose();
+    }
   }
 
   bool HasPseudoElements() const;
diff --git a/third_party/blink/web_tests/external/wpt/css/css-overflow/scroll-markers/column-scroll-marker-hidden-event-target-crash.html b/third_party/blink/web_tests/external/wpt/css/css-overflow/scroll-markers/column-scroll-marker-hidden-event-target-crash.html
