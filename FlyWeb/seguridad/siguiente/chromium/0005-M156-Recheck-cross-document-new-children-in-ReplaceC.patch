diff --git a/third_party/blink/renderer/core/dom/container_node.cc b/third_party/blink/renderer/core/dom/container_node.cc
index 5695cb9215..ec3787ced6 100644
--- a/third_party/blink/renderer/core/dom/container_node.cc
+++ b/third_party/blink/renderer/core/dom/container_node.cc
@@ -23,6 +23,8 @@
 
 #include "third_party/blink/renderer/core/dom/container_node.h"
 
+#include <algorithm>
+
 #include "third_party/blink/renderer/bindings/core/v8/v8_get_html_options.h"
 #include "third_party/blink/renderer/bindings/core/v8/v8_union_sethtmlunsafeoptions_trustedhtmlparseroptions.h"
 #include "third_party/blink/renderer/core/accessibility/ax_object_cache.h"
@@ -747,6 +749,16 @@ void ContainerNode::ReplaceChild(const VectorOf<Node>& new_children,
       if (!detector.NeedsRecheck()) {
         needs_recheck = true;
       }
+      // The detector above only watches this node's document. Synchronous
+      // event handlers run during the removal (e.g. `blur`) could have
+      // inserted one of `new_children` into a different document, so a
+      // recheck is needed if any of them is not in this document.
+      if (!needs_recheck &&
+          std::ranges::any_of(new_children, [this](const Node* child) {
+            return child->GetDocument() != GetDocument();
+          })) {
+        needs_recheck = true;
+      }
     }
 
     if (needs_recheck && !RecheckNodeInsertionStructuralPrereq(
diff --git a/third_party/blink/web_tests/external/wpt/dom/nodes/crashtests/replaceWith-blur-cross-document-crash.html b/third_party/blink/web_tests/external/wpt/dom/nodes/crashtests/replaceWith-blur-cross-document-crash.html
new file mode 100644
index 0000000000..85a3686e3c
--- /dev/null
+++ b/third_party/blink/web_tests/external/wpt/dom/nodes/crashtests/replaceWith-blur-cross-document-crash.html
@@ -0,0 +1,32 @@
+<!DOCTYPE html>
+<html class="test-wait">
+<meta charset="utf-8">
+<link rel="author" href="mailto:masonf@chromium.org">
+<link rel="help" href="https://crbug.com/583907042">
+
+<iframe id=iframe srcdoc="<fieldset><legend><input id=input></legend><span id=old></span></fieldset>"></iframe>
+
+<script>
+window.onload = () => {
+  const doc = iframe.contentDocument;
+  const input = doc.getElementById('input');
+  const old = doc.getElementById('old');
+  const n1 = document.createElement('div');
+  input.focus();
+  input.disabled = true;
+  input.addEventListener('blur', () => {
+    document.body.appendChild(n1);
+  });
+  // Removing `old` from the fieldset blurs the focused (disabled) input,
+  // and the blur handler inserts `n1` into the top-level document. `n1`
+  // must not then also be inserted into the fieldset.
+  old.replaceWith(n1);
+  n1.remove();
+  document.body.offsetTop;
+  requestAnimationFrame(() => {
+    requestAnimationFrame(() => {
+      document.documentElement.classList.remove('test-wait');
+    });
+  });
+};
+</script>
