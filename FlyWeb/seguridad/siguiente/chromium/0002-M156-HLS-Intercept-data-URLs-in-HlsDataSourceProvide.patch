index a317928144..d35a045bc1 100644
--- a/media/filters/hls_data_source_provider_impl.cc
+++ b/media/filters/hls_data_source_provider_impl.cc
@@ -12,7 +12,9 @@
 #include "base/types/pass_key.h"
 #include "media/base/cross_origin_data_source.h"
 #include "media/formats/hls/types.h"
+#include "net/base/data_url.h"
 #include "third_party/perfetto/include/perfetto/tracing/track.h"
+#include "url/url_constants.h"
 
 namespace media {
 
@@ -95,6 +97,34 @@ void HlsDataSourceProviderImpl::ReadFromExistingStream(
   if (stream->RequiresInit()) {
     auto [new_uri, cache_mode, range_mode, encoding_mode] =
         stream->GetSegmentInfo();
+    if (new_uri.SchemeIs(url::kDataScheme)) {
+      // If the stream points to a data-schemed URL load it directly.
+      std::string mime_type, charset, data;
+      if (!net::DataURL::Parse(new_uri, &mime_type, &charset, &data) ||
+          data.empty()) {
+        std::move(callback).Run(
+            base::unexpected(HlsDemuxerStatus::Codes::kNetworkReadError));
+        return;
+      }
+      base::span<const uint8_t> bytes = base::as_byte_span(data);
+      if (range_mode == DataSource::RangeMode::kRangeRequest) {
+        stream->set_requires_range_request();
+        const size_t start = stream->read_position();
+        const size_t end = stream->max_read_position().value();
+        if (start >= end || end > bytes.size()) {
+          std::move(callback).Run(
+              base::unexpected(HlsDemuxerStatus::Codes::kNetworkReadError));
+          return;
+        }
+        bytes = bytes.subspan(start, end - start);
+      }
+      stream->LockStreamForWriting(bytes.size()).copy_from(bytes);
+      stream->UnlockStreamPostWrite(bytes.size(), true);
+      stream->SetPostRedirectUri(std::move(new_uri));
+      std::move(callback).Run(std::move(stream));
+      return;
+    }
+
     TRACE_EVENT_BEGIN("media", "HLS::CreateDataSource", GetTracingTrack(this),
                       "uri", new_uri);
     data_source_factory_->Create(
diff --git a/media/filters/hls_data_source_provider_impl_unittest.cc b/media/filters/hls_data_source_provider_impl_unittest.cc
index c5e7677533..199fb21fbd 100644
--- a/media/filters/hls_data_source_provider_impl_unittest.cc
+++ b/media/filters/hls_data_source_provider_impl_unittest.cc
@@ -345,4 +345,81 @@ TEST_F(HlsDataSourceProviderImplUnittest, ReadSegmentWithDifferentDataOrigin) {
             url::Origin::Create(GURL("http://innocent.com")));
 }
 
+TEST_F(HlsDataSourceProviderImplUnittest, ReadFromDataUrl) {
+  EXPECT_CALL(*factory_, Setup).Times(0);
+
+  const GURL data_url("data:text/plain;base64,SGVsbG8sIFdvcmxkIQ==");
+  bool read_complete = false;
+  impl_->ReadFromUrl(
+      {data_url, std::nullopt},
+      base::BindOnce(
+          [](const GURL& expected_url, bool* complete_canary,
+             HlsDataSourceProvider::ReadResult result) {
+            ASSERT_TRUE(result.has_value());
+            auto stream = std::move(result).value();
+            EXPECT_EQ(stream->AsString(), "Hello, World!");
+            EXPECT_EQ(stream->buffer_size(), 13u);
+            EXPECT_EQ(stream->read_position(), 13u);
+            EXPECT_FALSE(stream->CanReadMore());
+            EXPECT_FALSE(stream->RequiresInit());
+            EXPECT_EQ(stream->uri(), expected_url);
+            EXPECT_TRUE(stream->SecurityInfo().response_origins.empty());
+            *complete_canary = true;
+          },
+          data_url, &read_complete));
+  task_environment_.RunUntilIdle();
+  EXPECT_TRUE(read_complete);
+
+  // Ranged read on a data: URL.
+  bool ranged_complete = false;
+  impl_->ReadFromUrl(
+      {data_url, hls::types::ByteRange::Validate(5, 7)},
+      base::BindOnce(
+          [](bool* complete_canary, HlsDataSourceProvider::ReadResult result) {
+            ASSERT_TRUE(result.has_value());
+            auto stream = std::move(result).value();
+            EXPECT_EQ(stream->AsString(), "World");
+            EXPECT_EQ(stream->buffer_size(), 5u);
+            EXPECT_EQ(stream->read_position(), 12u);
+            EXPECT_FALSE(stream->CanReadMore());
+            EXPECT_FALSE(stream->RequiresInit());
+            EXPECT_TRUE(stream->SecurityInfo().has_range_request);
+            *complete_canary = true;
+          },
+          &ranged_complete));
+  task_environment_.RunUntilIdle();
+  EXPECT_TRUE(ranged_complete);
+
+  // Out-of-bounds ranged read on a data: URL should fail with
+  // kNetworkReadError.
+  bool oob_ranged_error = false;
+  impl_->ReadFromUrl(
+      {data_url, hls::types::ByteRange::Validate(10, 7)},
+      base::BindOnce(
+          [](bool* error_canary, HlsDataSourceProvider::ReadResult result) {
+            ASSERT_FALSE(result.has_value());
+            EXPECT_EQ(result.error(),
+                      HlsDemuxerStatus::Codes::kNetworkReadError);
+            *error_canary = true;
+          },
+          &oob_ranged_error));
+  task_environment_.RunUntilIdle();
+  EXPECT_TRUE(oob_ranged_error);
+
+  // Empty or invalid data: URL should fail with kNetworkReadError.
+  bool error_complete = false;
+  impl_->ReadFromUrl(
+      {GURL("data:text/plain;base64,"), std::nullopt},
+      base::BindOnce(
+          [](bool* error_canary, HlsDataSourceProvider::ReadResult result) {
+            ASSERT_FALSE(result.has_value());
+            EXPECT_EQ(result.error(),
+                      HlsDemuxerStatus::Codes::kNetworkReadError);
+            *error_canary = true;
+          },
+          &error_complete));
+  task_environment_.RunUntilIdle();
+  EXPECT_TRUE(error_complete);
+}
+
 }  // namespace media
