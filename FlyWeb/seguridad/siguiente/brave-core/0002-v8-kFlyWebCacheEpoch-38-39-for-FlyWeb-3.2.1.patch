 --- a/src/utils/version.cc
 +++ b/src/utils/version.cc
-@@ -27,9 +27,59 @@ bool Version::candidate_ = (V8_IS_CANDIDATE_VERSION != 0);
+@@ -27,9 +27,61 @@ bool Version::candidate_ = (V8_IS_CANDIDATE_VERSION != 0);
  const char* Version::soname_ = SONAME;
  const char* Version::version_string_ = V8_VERSION_STRING;
  
@@ -53,8 +53,10 @@ index 550db661144947dbc31b5eb62c0da7ea2e6e1139..9bf7d57d3a9dcaf2dc04d2bd9ee80b82
 +// kNotAssigned context slots, and ceb90d38eb, SHA-256 source hash of the code
