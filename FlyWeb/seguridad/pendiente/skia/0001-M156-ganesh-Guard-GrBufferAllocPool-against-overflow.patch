+class TestBufferAllocPool final : public GrBufferAllocPool {
+public:
+    explicit TestBufferAllocPool(GrGpu* gpu, sk_sp<CpuBufferCache> cache = nullptr)
+            : GrBufferAllocPool(gpu, GrGpuBufferType::kVertex, std::move(cache)) {}
