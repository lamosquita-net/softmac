---
 .../file_system/local_file_stream_reader.cc   | 10 +++--
 .../local_file_stream_reader_unittest.cc      | 39 +++++++++++++++++++
 2 files changed, 45 insertions(+), 4 deletions(-)

diff --git a/storage/browser/file_system/local_file_stream_reader.cc b/storage/browser/file_system/local_file_stream_reader.cc
index 96b1fbf986..9970aa9ebc 100644
--- a/storage/browser/file_system/local_file_stream_reader.cc
+++ b/storage/browser/file_system/local_file_stream_reader.cc
@@ -70,7 +70,6 @@ int LocalFileStreamReader::Read(net::IOBuffer* buf,
   DCHECK(!has_pending_open_);
 
   if (stream_impl_) {
-    callback_ = std::move(callback);
     const auto result =
         stream_impl_->Read(buf, buf_len,
                            base::BindOnce(&LocalFileStreamReader::OnRead,
@@ -78,8 +77,8 @@ int LocalFileStreamReader::Read(net::IOBuffer* buf,
     const int read_result = result.has_value()
                                 ? base::checked_cast<int>(result->InBytes())
                                 : result.error();
-    if (read_result != net::ERR_IO_PENDING) {
-      std::move(callback_).Run(read_result);
+    if (read_result == net::ERR_IO_PENDING) {
+      callback_ = std::move(callback);
     }
     return read_result;
   }
@@ -135,7 +134,10 @@ void LocalFileStreamReader::OnScopedFileAccessRequested(
     net::CompletionOnceCallback callback,
     file_access::ScopedFileAccess scoped_file_access) {
   if (!scoped_file_access.is_allowed()) {
-    std::move(callback).Run(net::ERR_ACCESS_DENIED);
+    // Post asynchronously so `Read()` never invokes its completion callback
+    // synchronously before returning `net::ERR_IO_PENDING`.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback), net::ERR_ACCESS_DENIED));
     return;
   }
 
diff --git a/storage/browser/file_system/local_file_stream_reader_unittest.cc b/storage/browser/file_system/local_file_stream_reader_unittest.cc
index 99ab31eb85..d5b16800a2 100644
--- a/storage/browser/file_system/local_file_stream_reader_unittest.cc
+++ b/storage/browser/file_system/local_file_stream_reader_unittest.cc
@@ -10,14 +10,18 @@
 #include <memory>
 #include <string>
 #include <string_view>
+#include <utility>
+#include <vector>
 
 #include "base/files/file.h"
 #include "base/files/file_path.h"
 #include "base/files/file_util.h"
 #include "base/files/scoped_temp_dir.h"
 #include "base/functional/bind.h"
+#include "base/functional/callback.h"
 #include "base/functional/callback_helpers.h"
 #include "base/location.h"
+#include "base/memory/scoped_refptr.h"
 #include "base/run_loop.h"
 #include "base/task/single_thread_task_runner.h"
 #include "base/test/gmock_callback_support.h"
@@ -54,6 +58,12 @@ file_access::ScopedFileAccess CreateScopedFileAccess(bool allowed) {
 #endif
 }
 
+void DenyFileAccessInline(
+    const std::vector<base::FilePath>&,
+    base::OnceCallback<void(file_access::ScopedFileAccess)> callback) {
+  std::move(callback).Run(file_access::ScopedFileAccess::Denied());
+}
+
 }  // namespace
 
 class LocalFileStreamReaderTest : public FileStreamReaderTest {
@@ -229,4 +239,33 @@ TEST_F(LocalFileStreamReaderTest, ReadBlockedByDataLeakPreventionCallback) {
   EXPECT_EQ(data_or_error.error(), net::ERR_ACCESS_DENIED);
 }
 
+TEST_F(LocalFileStreamReaderTest, ReadDeniedInlineRunsCallbackAsynchronously) {
+  WriteTestFile();
+  std::unique_ptr<FileStreamReader> reader = CreateFileReader(
+      std::string(kTestFileName), 0, test_file_modification_time(),
+      base::BindRepeating(&DenyFileAccessInline));
+
+  auto buf = base::MakeRefCounted<net::IOBufferWithSize>(kTestData.size());
+  net::TestCompletionCallback callback;
+  int rv = reader->Read(buf.get(), buf->size(), callback.callback());
+  ASSERT_EQ(rv, net::ERR_IO_PENDING);
+  EXPECT_FALSE(callback.have_result());
+  EXPECT_EQ(callback.WaitForResult(), net::ERR_ACCESS_DENIED);
+}
+
+TEST_F(LocalFileStreamReaderTest, DeleteWithPendingInlineDeniedRead) {
+  WriteTestFile();
+  std::unique_ptr<FileStreamReader> reader = CreateFileReader(
+      std::string(kTestFileName), 0, test_file_modification_time(),
+      base::BindRepeating(&DenyFileAccessInline));
+
+  auto buf = base::MakeRefCounted<net::IOBufferWithSize>(kTestData.size());
+  int rv = reader->Read(buf.get(), buf->size(),
+                        base::BindOnce(&FileStreamReaderTest::NeverCalled));
+  ASSERT_EQ(rv, net::ERR_IO_PENDING);
+
+  reader.reset();
+  base::RunLoop().RunUntilIdle();
+}
+
 }  // namespace storage
