+   uint32_t length = this->length();
++  SBXCHECK_LE(length, String::kMaxLength);
+ 
+   StringCharacterStream stream(this, 0);
+   size_t utf8_bytes = stream.CountUtf8Bytes(length);
diff --git a/patches/v8/test-mjsunit-sandbox-regress-regress-579314138-1.js.patch b/patches/v8/test-mjsunit-sandbox-regress-regress-579314138-1.js.patch
