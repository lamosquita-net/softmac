+INSTANTIATE_TEST_SUITE_P(
+    ,
+    CompoundImageBackingWithWrappedSkImageTest,
+    testing::Combine(testing::Values(viz::SinglePlaneFormat::kRGBA_8888),
+                     testing::Values(GrContextType::kGL,
+                                     GrContextType::kGraphiteDawn)),
+    TestParamToString);
