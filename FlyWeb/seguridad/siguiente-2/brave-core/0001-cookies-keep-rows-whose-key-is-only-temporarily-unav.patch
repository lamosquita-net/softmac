++    sql::Statement smt(db.GetUniqueStatement(
++        "SELECT encrypted_value FROM cookies WHERE name = ?"));
++    smt.BindString(0, name);
++    EXPECT_TRUE(smt.Step());
++    return smt.ColumnString(0);
++  };
++  auto set_encrypted_value = [&](const char* name, std::string_view value) {
++    sql::Database db(sql::test::kTestTag);
++    ASSERT_TRUE(db.Open(temp_dir_.GetPath().Append(kCookieFilename)));
++    sql::Statement smt(db.GetUniqueStatement(
++        "UPDATE cookies SET encrypted_value = ? WHERE name = ?"));
++    smt.BindBlob(0, base::as_byte_span(value));
++    smt.BindString(1, name);
++    ASSERT_TRUE(smt.Run());
++  };
++  auto count_rows = [&](const char* name) {
++    sql::Database db(sql::test::kTestTag);
++    EXPECT_TRUE(db.Open(temp_dir_.GetPath().Append(kCookieFilename)));
++    sql::Statement smt(
++        db.GetUniqueStatement("SELECT COUNT(*) FROM cookies WHERE name = ?"));
++    smt.BindString(0, name);
++    EXPECT_TRUE(smt.Step());
++    return smt.ColumnInt(0);
++  };
++  auto names = [](const CanonicalCookieVector& cookies) {
++    std::vector<std::string> result;
++    for (const auto& cookie : cookies) {
++      result.push_back(cookie->Name());
++    }
++    std::sort(result.begin(), result.end());
++    return result;
++  };
++
++  const std::string good_value = read_encrypted_value("locked");
++  const std::string locked_value =
++      base::StrCat({kTemporarilyUnavailablePrefix, good_value});
++
++  // 1. Key missing at load, no write: the row stays and nothing else of the
