+ 
+-  void InsertOp(const InstructionOperand& op) {
+-    set_->push_back(op);
+-
+-    if (kFPAliasing == AliasingKind::kCombine && op.IsFPRegister()) {
+-      fp_reps_ |= RepresentationBit(LocationOperand::cast(op).representation());
+-    }
+-  }
