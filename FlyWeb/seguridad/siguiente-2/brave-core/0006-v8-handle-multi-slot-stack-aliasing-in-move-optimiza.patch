+index 0000000000000000000000000000000000000000..fd912919ebbb983e2f52146b2120ffd44e201490
+--- /dev/null
++++ b/test/mjsunit/regress/wasm/regress-simd-581962456.js
+@@ -0,0 +1,261 @@
