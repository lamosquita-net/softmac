+  public:
+-  explicit OperandSet(ZoneVector<InstructionOperand>* buffer)
+-      : set_(buffer), fp_reps_(0) {
++  explicit OperandSet(ZoneVector<InstructionOperand>* buffer) : set_(buffer) {
+     buffer->clear();
