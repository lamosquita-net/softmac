---
 gpu/command_buffer/common/buffer.cc | 5 ++++-
 gpu/command_buffer/common/buffer.h  | 3 ++-
 2 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/gpu/command_buffer/common/buffer.cc b/gpu/command_buffer/common/buffer.cc
index eea27da328..4101af5d92 100644
--- a/gpu/command_buffer/common/buffer.cc
+++ b/gpu/command_buffer/common/buffer.cc
@@ -7,6 +7,7 @@
 #include <stddef.h>
 #include <stdint.h>
 
+#include <limits>
 #include <ostream>
 
 #include "base/atomic_sequence_num.h"
@@ -126,7 +127,9 @@ uint32_t Buffer::GetRemainingSize(uint32_t data_offset) const {
 
 int32_t GetNextBufferId() {
   // 0 is a reserved value.
-  return g_next_buffer_id.GetNext() + 1;
+  int32_t id = g_next_buffer_id.GetNext() + 1;
+  CHECK_NE(id, std::numeric_limits<int32_t>::max());
+  return id;
 }
 
 base::trace_event::MemoryAllocatorDumpGuid GetBufferGUIDForTracing(
diff --git a/gpu/command_buffer/common/buffer.h b/gpu/command_buffer/common/buffer.h
index 4dba192b0d..0f9b326fd8 100644
--- a/gpu/command_buffer/common/buffer.h
+++ b/gpu/command_buffer/common/buffer.h
@@ -136,7 +136,8 @@ inline scoped_refptr<Buffer> MakeMemoryBuffer(uint32_t size,
 }
 
 // Generates a process unique buffer ID which can be safely used with
-// GetBufferGUIDForTracing.
+// GetBufferGUIDForTracing. The return ID will be a positive non-zero integer.
+// The process will terminate if the positive ID space is exhausted.
 GPU_COMMAND_BUFFER_COMMON_EXPORT int32_t GetNextBufferId();
 
 // Generates GUID which can be used to trace buffer using an Id.
