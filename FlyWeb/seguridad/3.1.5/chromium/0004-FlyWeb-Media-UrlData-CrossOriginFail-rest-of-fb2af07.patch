From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SEGURIDAD-PORTES-25 <noreply@anthropic.com>
Date: Wed, 18 Nov 2026 10:13:19 +0000
Subject: [PATCH 04/13] [FlyWeb] Media: UrlData::CrossOriginFail() (rest of
 fb2af07952)

With b71ea276fd, 8132e3a4c4 and dbd22daebd in place, DidFail() matches
upstream right before fb2af07952, so apply the part of that commit that
0018 of 3.1.4 left out: UrlData::CrossOriginFail(), used by DidFail()
now that set_is_cors_cross_origin() is private.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01MwmK2kzDkFd6KCGzWTjn23
---
 .../platform/media/resource_multi_buffer_data_provider.cc   | 3 +--
 third_party/blink/renderer/platform/media/url_index.cc      | 6 ++++++
 third_party/blink/renderer/platform/media/url_index.h       | 5 +++++
 3 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/third_party/blink/renderer/platform/media/resource_multi_buffer_data_provider.cc b/third_party/blink/renderer/platform/media/resource_multi_buffer_data_provider.cc
index 72eb7ad6f..e514e4626 100644
--- a/third_party/blink/renderer/platform/media/resource_multi_buffer_data_provider.cc
+++ b/third_party/blink/renderer/platform/media/resource_multi_buffer_data_provider.cc
@@ -542,8 +542,7 @@ void ResourceMultiBufferDataProvider::DidFail(const WebURLError& error) {
   if (error.reason() == net::ERR_BLOCKED_BY_ORB ||
       error.reason() == net::ERR_BLOCKED_BY_RESPONSE ||
       error.is_web_security_violation()) {
-    url_data_->set_is_cors_cross_origin(true);
-    url_data_->Fail();
+    url_data_->CrossOriginFail();
     return;  // "this" may be deleted now.
   }
 
diff --git a/third_party/blink/renderer/platform/media/url_index.cc b/third_party/blink/renderer/platform/media/url_index.cc
index 22539a17b..5a09b4a71 100644
--- a/third_party/blink/renderer/platform/media/url_index.cc
+++ b/third_party/blink/renderer/platform/media/url_index.cc
@@ -185,6 +185,12 @@ void UrlData::Fail() {
   }
 }
 
+void UrlData::CrossOriginFail() {
+  DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+  set_is_cors_cross_origin(true);
+  Fail();
+}
+
 void UrlData::OnRedirect(RedirectCB cb) {
   DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
   redirect_callbacks_.push_back(std::move(cb));
diff --git a/third_party/blink/renderer/platform/media/url_index.h b/third_party/blink/renderer/platform/media/url_index.h
index 1dc8e6096..e879175c4 100644
--- a/third_party/blink/renderer/platform/media/url_index.h
+++ b/third_party/blink/renderer/platform/media/url_index.h
@@ -182,6 +182,11 @@ class PLATFORM_EXPORT UrlData : public RefCounted<UrlData> {
   // Fail, tell all clients that a failure has occurred.
   void Fail();
 
+  // Marks this data as CORS cross-origin before calling Fail(). Used when a
+  // request fails due to cross-origin security restrictions (e.g., ORB, CORP,
+  // or CORS violations) before a response is received.
+  void CrossOriginFail();
+
   // Callback for receiving notifications when a redirect occurs.
   using RedirectCB = base::OnceCallback<void(const scoped_refptr<UrlData>&)>;
 
-- 
