+    base::File::Error result) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  if (result != base::File::FILE_OK) {
+    locks.clear();
+    std::move(callback).Run(file_system_access_error::FromFileError(result));
+    return;
+  }
