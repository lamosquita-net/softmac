diff --git a/third_party/blink/renderer/core/layout/inline/inline_layout_algorithm.cc b/third_party/blink/renderer/core/layout/inline/inline_layout_algorithm.cc
index db64ee1e16..1b340637b4 100644
--- a/third_party/blink/renderer/core/layout/inline/inline_layout_algorithm.cc
+++ b/third_party/blink/renderer/core/layout/inline/inline_layout_algorithm.cc
@@ -1730,8 +1730,12 @@ InlineLayoutAlgorithm::DoesRemainderFitInLineWithoutEllipsis(
 void InlineLayoutAlgorithm::PositionLeadingFloats(
     ExclusionSpace& exclusion_space,
     LeadingFloats& leading_floats) {
-  if (GetBreakToken() && GetBreakToken()->IsInParallelBlockFlow()) {
-    // Bail, and let the line breaker deal with any kind of parallel flow.
+  if (GetBreakToken() &&
+      (GetBreakToken()->IsInParallelBlockFlow() ||
+       (RuntimeEnabledFeatures::RubySkipLeadingFloatsEnabled() &&
+        GetBreakToken()->RubyData()))) {
+    // Bail, and let the line breaker deal with any kind of parallel flow or
+    // ruby continuation.
     return;
   }
 
@@ -1741,9 +1745,13 @@ void InlineLayoutAlgorithm::PositionLeadingFloats(
   for (; index < items.size(); ++index) {
     const InlineItem& item = *items[index];
 
-    // Abort if we've found something non-empty.
-    if (!item.IsEmptyItem())
+    // Abort if we've found something non-empty, or a ruby column (which may
+    // be handled by a sub-LineBreaker with empty LeadingFloats).
+    if (!item.IsEmptyItem() ||
+        (RuntimeEnabledFeatures::RubySkipLeadingFloatsEnabled() &&
+         item.Type() == InlineItem::kOpenRubyColumn)) {
       break;
+    }
 
     if (item.Type() != InlineItem::kFloating) {
       continue;
@@ -1771,7 +1779,7 @@ void InlineLayoutAlgorithm::PositionLeadingFloats(
       }
     }
 
-    leading_floats.Add(positioned_float, parallel_break_token);
+    leading_floats.Add(index, positioned_float, parallel_break_token);
   }
 
   leading_floats.SetHandledIndex(index);
diff --git a/third_party/blink/renderer/core/layout/inline/inline_layout_algorithm_test.cc b/third_party/blink/renderer/core/layout/inline/inline_layout_algorithm_test.cc
index 5882c2a415..bdef3cd567 100644
--- a/third_party/blink/renderer/core/layout/inline/inline_layout_algorithm_test.cc
+++ b/third_party/blink/renderer/core/layout/inline/inline_layout_algorithm_test.cc
@@ -1464,5 +1464,31 @@ TEST_F(InlineLayoutAlgorithmTest, TextBoxTrimOnInlineBox) {
   }
 }
 
+TEST_F(InlineLayoutAlgorithmTest, LeadingFloatWithRuby) {
+  SetBodyInnerHTML(R"HTML(
+    <div id="container">
+      <div id="f0" style="float: left; width: 20px; height: 20px"></div><ruby><div id="f" style="float: left; width: 50px; height: 50px"></div><rt></rt></ruby><div id="h" style="float: left; width: 100px; height: 100px"></div>text
+    </div>
+  )HTML");
+  const LayoutBox* f0 = GetLayoutBoxByElementId("f0");
+  const LayoutBox* f = GetLayoutBoxByElementId("f");
+  const LayoutBox* h = GetLayoutBoxByElementId("h");
+  ASSERT_TRUE(f0);
+  ASSERT_TRUE(f);
+  ASSERT_TRUE(h);
+  EXPECT_EQ(f0->StitchedSize(), PhysicalSize(20, 20));
+  EXPECT_EQ(f->StitchedSize(), PhysicalSize(50, 50));
+  EXPECT_EQ(h->StitchedSize(), PhysicalSize(100, 100));
+
+  // Test `f0` and `h` are placed in the `container` IFC.
+  const LayoutBlockFlow* container =
+      To<LayoutBlockFlow>(GetLayoutObjectByElementId("container"));
+  for (const LayoutBox* target : {f0, h}) {
+    InlineCursor cursor(*container);
+    cursor.MoveTo(*target);
+    EXPECT_TRUE(cursor);
+  }
+}
+
 }  // namespace
 }  // namespace blink
