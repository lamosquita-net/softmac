---
 .../renderer/core/css/css_selector_list.cc    | 20 ++++------------
 .../renderer/core/css/css_selector_list.h     | 23 +++++++++++++++++--
 2 files changed, 26 insertions(+), 17 deletions(-)

diff --git a/third_party/blink/renderer/core/css/css_selector_list.cc b/third_party/blink/renderer/core/css/css_selector_list.cc
index 9af203af2a..cb31ac3fcb 100644
--- a/third_party/blink/renderer/core/css/css_selector_list.cc
+++ b/third_party/blink/renderer/core/css/css_selector_list.cc
@@ -46,8 +46,6 @@ CSSSelectorList* CSSSelectorList::Empty() {
   if (!persistent) [[unlikely]] {
     persistent =
         MakeGarbageCollected<CSSSelectorList>(base::PassKey<CSSSelectorList>());
-    new (persistent->first_selector_) CSSSelector();
-    persistent->first_selector_[0].SetMatch(CSSSelector::kInvalidList);
     DCHECK(persistent->IsInvalidWithoutUnparsed());
     LEAK_SANITIZER_IGNORE_OBJECT(&persistent);
   }
@@ -61,15 +59,9 @@ CSSSelectorList* CSSSelectorList::Copy() const {
 
   unsigned length = ComputeLength();
   DCHECK(length);
-  CSSSelectorList* list = MakeGarbageCollected<CSSSelectorList>(
+  return MakeGarbageCollected<CSSSelectorList>(
       AdditionalBytes(sizeof(CSSSelector) * (length - 1)),
-      base::PassKey<CSSSelectorList>());
-  for (unsigned i = 0; i < length; ++i) {
-    UNSAFE_BUFFERS(new (&list->first_selector_[i])
-                       CSSSelector(first_selector_[i]));
-  }
-
-  return list;
+      base::PassKey<CSSSelectorList>(), *this, length);
 }
 
 HeapVector<CSSSelector> CSSSelectorList::Copy(
@@ -115,11 +107,9 @@ CSSSelectorList* CSSSelectorList::AdoptSelectorVector(
     return CSSSelectorList::Empty();
   }
 
-  CSSSelectorList* list = MakeGarbageCollected<CSSSelectorList>(
+  return MakeGarbageCollected<CSSSelectorList>(
       AdditionalBytes(sizeof(CSSSelector) * (selector_vector.size() - 1)),
-      base::PassKey<CSSSelectorList>());
-  AdoptSelectorVector(selector_vector, list->first_selector_);
-  return list;
+      base::PassKey<CSSSelectorList>(), selector_vector);
 }
 
 unsigned CSSSelectorList::ComputeLength() const {
@@ -193,7 +183,7 @@ void CSSSelectorList::Trace(Visitor* visitor) const {
 
   for (int i = 0;; ++i) {
     visitor->Trace(UNSAFE_BUFFERS(first_selector_[i]));
-    if (UNSAFE_BUFFERS(first_selector_[i].IsLastInSelectorList())) {
+    if (UNSAFE_BUFFERS(first_selector_[i].IsLastInSelectorListForOilpan())) {
       break;
     }
   }
diff --git a/third_party/blink/renderer/core/css/css_selector_list.h b/third_party/blink/renderer/core/css/css_selector_list.h
index aea3f73383..4eb55d43ea 100644
--- a/third_party/blink/renderer/core/css/css_selector_list.h
+++ b/third_party/blink/renderer/core/css/css_selector_list.h
@@ -75,8 +75,27 @@ class CORE_EXPORT CSSSelectorList : public GarbageCollected<CSSSelectorList> {
   // the object it points to.
   static CSSSelectorList* Empty();
 
-  // Do not call; for Empty() and AdoptSelectorVector() only.
-  explicit CSSSelectorList(base::PassKey<CSSSelectorList>) {}
+  // Do not call; for Empty() only.
+  explicit CSSSelectorList(base::PassKey<CSSSelectorList>) {
+    first_selector_[0].SetMatch(CSSSelector::kInvalidList);
+  }
+
+  // Do not call; for AdoptSelectorVector() and Copy() only. These populate
+  // the trailing selector array inside the constructor: concurrent marking
+  // may only trace an object once it is flagged as fully constructed, and
+  // that flag is what orders the writes below before a marker's Trace().
+  CSSSelectorList(base::PassKey<CSSSelectorList>,
+                  base::span<CSSSelector> selector_vector) {
+    AdoptSelectorVector(selector_vector, first_selector_);
+  }
+  CSSSelectorList(base::PassKey<CSSSelectorList>,
+                  const CSSSelectorList& other,
+                  unsigned length) {
+    for (unsigned i = 0; i < length; ++i) {
+      UNSAFE_BUFFERS(new (&first_selector_[i])
+                         CSSSelector(other.first_selector_[i]));
+    }
+  }
 
   CSSSelectorList(CSSSelectorList&& o) {
     UNSAFE_BUFFERS(
