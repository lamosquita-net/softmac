@@ -0,0 +1,92 @@
+<!DOCTYPE html>
+<meta charset="utf-8">
+<meta http-equiv="Content-Security-Policy" content="script-src 'nonce-abc' 'strict-dynamic'">
+<title>Parser-initiated option removal doesn't let parser-inserted scripts bypass 'strict-dynamic'</title>
+<link rel=help href="https://html.spec.whatwg.org/#the-option-element:stack-of-open-elements">
+<link rel=help href="https://html.spec.whatwg.org/#clone-an-option-into-a-selectedcontent">
+<link rel=help href="https://html.spec.whatwg.org/#adoption-agency-algorithm">
+<link rel=help href="https://w3c.github.io/webappsec-csp/#strict-dynamic-usage">
+<script nonce="abc" src="/resources/testharness.js"></script>
+<script nonce="abc" src="/resources/testharnessreport.js"></script>
+<script nonce="abc">
+  window.reconnectedInlineRuns = 0;
+  window.reconnectedExternalRuns = 0;
+  window.reconnectedSelectRuns = 0;
+  window.reconnectedNoncedRuns = 0;
+  window.dynamicScriptRuns = 0;
+  window.templateScriptRuns = 0;
+  window.populatedScriptRuns = 0;
+</script>
+<select id="reconnected-inline">
+  <button>
+    <selectedcontent>
+      <b><option selected><div id="moved-inline"><script>window.reconnectedInlineRuns++;</script></b></div></option>
+    </selectedcontent>
+  </button>
+</select>
+<select id="reconnected-external">
+  <button>
+    <selectedcontent>
+      <b><option selected><div id="moved-external"><script src="data:text/javascript,window.reconnectedExternalRuns++"></script></b></div></option>
+    </selectedcontent>
+  </button>
+</select>
+<select id="reconnected-selectedcontent">
+  <selectedcontent></selectedcontent>
+  <i><div><option selected>one</option></i></div>
+  <button>
+    <selectedcontent id="target-sc">
+      <b><div id="moved-reconnected-sc"><script></script><script>window.reconnectedSelectRuns++;</script></b></div>
+    </selectedcontent>
+  </button>
+</select>
+<select id="reconnected-nonced">
+  <button>
+    <selectedcontent>
+      <b><option selected><div><script nonce="abc">window.reconnectedNoncedRuns++;</script></b></div></option>
+    </selectedcontent>
+  </button>
+</select>
+<template id="script-template">
+  <script>window.templateScriptRuns++;</script>
+</template>
+<script id="empty-script"></script>
+<script nonce="abc">
+  const dynamicScript = document.createElement("script");
+  dynamicScript.textContent = "window.dynamicScriptRuns++;";
+  document.body.appendChild(dynamicScript);
+  document.body.appendChild(document.getElementById("script-template").content);
+  document.getElementById("empty-script").textContent =
+      "window.populatedScriptRuns++;";
+
+  const loadPromise = new Promise(resolve => window.addEventListener("load", resolve));
+
+  promise_test(async () => {
+    await loadPromise;
+    await new Promise(resolve => step_timeout(resolve, 0));
+    assert_equals(document.getElementById("moved-inline").parentNode,
+                  document.querySelector("#reconnected-inline selectedcontent"),
+                  "The adoption agency algorithm should have reconnected the inline script container");
+    assert_equals(document.getElementById("moved-external").parentNode,
+                  document.querySelector("#reconnected-external selectedcontent"),
+                  "The adoption agency algorithm should have reconnected the external script container");
+    assert_equals(document.getElementById("moved-reconnected-sc").parentNode,
+                  document.getElementById("target-sc"),
+                  "The adoption agency algorithm should have reconnected the nested container");
+    assert_equals(reconnectedInlineRuns, 0,
+                  "Nonce-less inline parser script reconnected via adoption agency shouldn't run");
+    assert_equals(reconnectedExternalRuns, 0,
+                  "Nonce-less external parser script reconnected via adoption agency shouldn't run");
+    assert_equals(reconnectedSelectRuns, 0,
+                  "Nonce-less inline parser script disconnected by queued selectedcontent update shouldn't run");
+    assert_equals(reconnectedNoncedRuns, 1,
+                  "Nonced parser script reconnected via adoption agency should run");
+    assert_equals(dynamicScriptRuns, 1,
+                  "Dynamically created script should still run under strict-dynamic");
+  }, "Parser-inserted scripts disconnected by selectedcontent and reconnected by the adoption agency algorithm don't bypass 'strict-dynamic'");
+
+  test(() => {
+    assert_equals(templateScriptRuns, 1);
+    assert_equals(populatedScriptRuns, 1);
+  }, "Template scripts and initially empty parser scripts populated by script still execute under strict-dynamic");
+</script>
-- 
