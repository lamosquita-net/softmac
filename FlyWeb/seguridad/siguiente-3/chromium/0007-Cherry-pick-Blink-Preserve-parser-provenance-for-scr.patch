@@ -551,6 +554,15 @@ PendingScript* ScriptLoader::PrepareScript(
 
   // <spec step="7">If el is not connected, then return.</spec>
   if (!element_->IsConnected()) {
+    // Keep `parser_inserted_` false so `ScriptRunner` handles scheduling if the
