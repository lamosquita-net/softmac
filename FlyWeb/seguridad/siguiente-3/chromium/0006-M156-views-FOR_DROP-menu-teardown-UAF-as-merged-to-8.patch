+namespace {
+
+class SelfDeletingNonForDropDelegate : public TestMenuDelegate {
+ public:
+  void set_menu_runner(std::unique_ptr<MenuRunner> runner) {
+    runner_ = std::move(runner);
+  }
+  MenuRunner* menu_runner() { return runner_.get(); }
+  void set_item_tracker(ViewTracker* tracker) { item_tracker_ = tracker; }
+
+  void OnMenuClosed(MenuItemView* menu) override {
+    TestMenuDelegate::OnMenuClosed(menu);
+    EXPECT_NE(nullptr, item_tracker_->view());
+    runner_.reset();
+    EXPECT_EQ(nullptr, item_tracker_->view());
+  }
+
+ private:
+  std::unique_ptr<MenuRunner> runner_;
+  raw_ptr<ViewTracker> item_tracker_ = nullptr;
+};
+
+}  // namespace
+
+// Regression guard for crbug.com/576555601 on M156: non-FOR_DROP menus (such as
+// AppMenu) must still destroy their MenuRunnerImpl and view tree synchronously
+// when released during OnMenuClosed, rather than deferring destruction until
+// MenuController unwinds.
+TEST_F(MenuRunnerTest, NonForDropReleaseInOnMenuClosedDestroysSynchronously) {
+  ViewTracker item_tracker;
+  SelfDeletingNonForDropDelegate delegate;
+  delegate.set_item_tracker(&item_tracker);
+  auto root = std::make_unique<TestMenuItemView>(&delegate);
+  MenuItemView* item1 = root->AppendMenuItem(TestCommandIds::kItem1, u"One");
+  item_tracker.SetView(item1);
+
+  delegate.set_menu_runner(
+      std::make_unique<MenuRunner>(std::move(root), /*run_types=*/0));
+  delegate.menu_runner()->RunMenuAt(owner(), /*button_controller=*/nullptr,
+                                    gfx::Rect(), MenuAnchorPosition::kTopLeft,
+                                    ui::mojom::MenuSourceType::kNone);
+
+  MenuController::GetActiveInstance()->Cancel(MenuController::ExitType::kAll);
+
+  EXPECT_EQ(1, delegate.on_menu_closed_called());
+  EXPECT_EQ(nullptr, delegate.menu_runner());
+  EXPECT_EQ(nullptr, item_tracker.view());
+  EXPECT_EQ(nullptr, MenuController::GetActiveInstance());
+}
+
 }  // namespace views::test
