diff --git a/third_party/blink/web_tests/external/wpt/css/css-fonts/crashtests/font-face-weight-calc-ch-crash.html b/third_party/blink/web_tests/external/wpt/css/css-fonts/crashtests/font-face-weight-calc-ch-crash.html
