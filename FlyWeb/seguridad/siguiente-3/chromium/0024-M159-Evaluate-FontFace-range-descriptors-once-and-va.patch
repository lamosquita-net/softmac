@@ -0,0 +1,33 @@
+<!DOCTYPE html>
+<meta charset="utf-8">
+<title>CSS Fonts: @font-face weight calc(1ch) and NaN must not UAF or crash</title>
+<link rel="help" href="https://drafts.csswg.org/css-fonts-4/#font-prop-desc">
+<style>
+  @font-face {
+    font-family: serif;
+    src: url('/fonts/Lato-Medium.ttf') format('truetype');
+  }
+</style>
+<script>
+  for (const weight of [
+    'calc(1ch / 1px) calc(1ch / 1px)',
+    'calc(0 / 0) calc(0 / 0)',
+    'calc(0 / 0)',
+    'calc(2000) calc(0)',
+  ]) {
+    const f1 = new FontFace('TestFamily', 'local("Arial")', {
+      stretch: '0%',
+      style: 'normal',
+      weight,
+    });
+    document.fonts.add(f1);
+    const f2 = new FontFace('TestFamily', 'local("Arial")', {
+      stretch: '0%',
+      style: 'normal',
+      weight,
+    });
+    document.fonts.add(f2);
+    document.fonts.delete(f1);
+    document.fonts.delete(f2);
+  }
+</script>
diff --git a/third_party/blink/web_tests/external/wpt/css/css-fonts/font-face-weight-calc-fallback.html b/third_party/blink/web_tests/external/wpt/css/css-fonts/font-face-weight-calc-fallback.html
new file mode 100644
index 0000000000..7eeaef79ed
--- /dev/null
+++ b/third_party/blink/web_tests/external/wpt/css/css-fonts/font-face-weight-calc-fallback.html
@@ -0,0 +1,45 @@
+<!DOCTYPE html>
+<meta charset="utf-8">
+<title>CSS Fonts: @font-face out-of-bounds or NaN calc() weight falls back to normal (400)</title>
+<link rel="help" href="https://drafts.csswg.org/css-fonts-4/#font-prop-desc">
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<script>
+  for (const [index, weight] of [
+    'calc(2000) calc(0)',
+    'calc(0 / 0) calc(0 / 0)',
+    'calc(0 / 0)',
+  ].entries()) {
+    promise_test(async (t) => {
+      const family = `TestFallbackFamily${index}`;
+      const face900 = new FontFace(family, "url('/fonts/Ahem.ttf')", {
+        weight: '900',
+      });
+      const faceFallback = new FontFace(
+        family,
+        "url('/fonts/Lato-Medium.ttf')",
+        {
+          weight,
+        }
+      );
+      document.fonts.add(face900);
+      document.fonts.add(faceFallback);
+      t.add_cleanup(() => {
+        document.fonts.delete(face900);
+        document.fonts.delete(faceFallback);
+      });
+
+      const loaded900 = await document.fonts.load(`900 16px ${family}`);
+      assert_equals(loaded900.length, 1);
+      assert_equals(loaded900[0].weight, '900', '900 should match the 900 face');
+
+      const loaded400 = await document.fonts.load(`400 16px ${family}`);
+      assert_equals(loaded400.length, 1);
+      assert_equals(
+        loaded400[0],
+        faceFallback,
+        `400 should match the fallback face for ${weight}`
+      );
+    }, `@font-face weight "${weight}" falls back to normal (400)`);
+  }
+</script>
