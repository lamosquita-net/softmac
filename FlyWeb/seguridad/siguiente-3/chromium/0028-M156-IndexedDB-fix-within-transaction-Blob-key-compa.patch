 .../instance/leveldb/backing_store.h          | 22 +++++++++----
 .../leveldb/leveldb_backing_store_unittest.cc | 31 +++++++++++++++++++
 2 files changed, 47 insertions(+), 6 deletions(-)

diff --git a/content/browser/indexed_db/instance/leveldb/backing_store.h b/content/browser/indexed_db/instance/leveldb/backing_store.h
index 10e14fed2e..39a3e5353f 100644
--- a/content/browser/indexed_db/instance/leveldb/backing_store.h
+++ b/content/browser/indexed_db/instance/leveldb/backing_store.h
@@ -235,6 +235,19 @@ class CONTENT_EXPORT BackingStore : public indexed_db::BackingStore {
     blink::mojom::IDBTransactionMode mode() const { return mode_; }
 
    private:
+    friend class BackingStore;
+
+    struct EncodedKeyComparator {
+      bool operator()(const std::string& a, const std::string& b) const {
+        return CompareKeys(a, b) < 0;
+      }
+    };
+
+    using ExternalObjectChangeMap =
+        std::map<std::string,
+                 std::unique_ptr<IndexedDBExternalObjectChangeRecord>,
+                 EncodedKeyComparator>;
+
     int64_t database_id() const { return *database_->metadata().id; }
 
     Status FindKeyInIndex(int64_t object_store_id,
@@ -277,10 +290,8 @@ class CONTENT_EXPORT BackingStore : public indexed_db::BackingStore {
 
     std::unique_ptr<TransactionalLevelDBTransaction> transaction_;
 
-    std::map<std::string, std::unique_ptr<IndexedDBExternalObjectChangeRecord>>
-        external_object_change_map_;
-    std::map<std::string, std::unique_ptr<IndexedDBExternalObjectChangeRecord>>
-        in_memory_external_object_map_;
+    ExternalObjectChangeMap external_object_change_map_;
+    ExternalObjectChangeMap in_memory_external_object_map_;
 
     // List of blob files being newly written as part of this transaction.
     // These will be added to the recovery blob journal prior to commit, then
@@ -638,8 +649,7 @@ class CONTENT_EXPORT BackingStore : public indexed_db::BackingStore {
   // backing store this is redundant but necessary for backwards compatibility.
   const std::string origin_identifier_;
 
-  std::map<std::string, std::unique_ptr<IndexedDBExternalObjectChangeRecord>>
-      in_memory_external_object_map_;
+  Transaction::ExternalObjectChangeMap in_memory_external_object_map_;
 
   bool execute_journal_cleaning_on_no_txns_ = false;
   int num_aggregated_journal_cleaning_requests_ = 0;
diff --git a/content/browser/indexed_db/instance/leveldb/leveldb_backing_store_unittest.cc b/content/browser/indexed_db/instance/leveldb/leveldb_backing_store_unittest.cc
index c52871fee3..5c378bcf27 100644
--- a/content/browser/indexed_db/instance/leveldb/leveldb_backing_store_unittest.cc
+++ b/content/browser/indexed_db/instance/leveldb/leveldb_backing_store_unittest.cc
@@ -273,6 +273,37 @@ class LevelDbBackingStoreTestWithBlobs
   bool IncludesFileSystemAccessHandles() override { return false; }
 };
 
+// Verifies the key comparator used in the external object change maps.
+// Regression test for crbug.com/589433703
+TEST_F(LevelDbBackingStoreTestWithBlobs, ExternalObjectsWithEquivalentKeys) {
+  // Two keys that should be treated as equivalent, even though they don't have
+  // the same byte-wise serialized representation.
+  const std::array<IndexedDBKey, 2> keys = {
+      IndexedDBKey(0.0, blink::mojom::IDBKeyType::Number),
+      IndexedDBKey(-0.0, blink::mojom::IDBKeyType::Number)};
+  const IndexedDBValue first("first", {CreateBlobInfo(u"first", "first")});
+  const IndexedDBValue second("second", {CreateBlobInfo(u"second", "second")});
+
+  BackingStore::Database db(*backing_store(),
+                            BackingStore::DatabaseMetadata{u"name"});
+  db.metadata().id = 1;
+  std::unique_ptr<indexed_db::BackingStore::Transaction> transaction =
+      CreateAndBeginTransaction(db,
+                                blink::mojom::IDBTransactionMode::ReadWrite);
+  ASSERT_TRUE(transaction->PutRecord(1, keys[0], first.Clone()).has_value());
+  ASSERT_TRUE(transaction->PutRecord(1, keys[1], second.Clone()).has_value());
+
+  for (const IndexedDBKey& key : keys) {
+    StatusOr<IndexedDBValue> result = transaction->GetRecord(1, key);
+    ASSERT_TRUE(result.has_value());
+    EXPECT_EQ(base::span(result->bits), base::span(second.bits));
+    ASSERT_EQ(result->external_objects.size(), 1u);
+    EXPECT_EQ(result->external_objects[0].type(),
+              second.external_objects[0].type());
+  }
+  transaction->Rollback();
+}
+
 // http://crbug.com/1131151
 // Validate that recovery journal cleanup during a transaction does
 // not delete blobs that were just written.
