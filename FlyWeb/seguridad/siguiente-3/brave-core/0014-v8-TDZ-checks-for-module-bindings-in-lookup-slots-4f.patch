+--- /dev/null
++++ b/test/inspector/debugger/evaluate-on-call-frame-module-tdz-expected.txt
+@@ -0,0 +1,28 @@
++Tests that Debugger.evaluateOnCallFrame respects the TDZ of module bindings.
++Paused in a function, bindings in TDZ:
++  exportedLet => throws ReferenceError: exportedLet is not defined
++  typeof exportedLet => throws ReferenceError: exportedLet is not defined
++  exportedConst => throws ReferenceError: exportedConst is not defined
++  ExportedClass => throws ReferenceError: ExportedClass is not defined
++  importedLet => throws ReferenceError: importedLet is not defined
++  exportedLet = 4 => throws ReferenceError: exportedLet is not defined
++  exportedConst = 4 => throws ReferenceError: exportedConst is not defined
++  importedLet = 4 => throws ReferenceError: importedLet is not defined
++  param = exportedLet => throws ReferenceError: exportedLet is not defined
++  param = importedLet, param = 5 => throws ReferenceError: importedLet is not defined
++  param => 1
++Paused at module top-level, bindings in TDZ:
++  exportedLet => throws ReferenceError: exportedLet is not defined
++  importedLet => throws ReferenceError: importedLet is not defined
++  exportedLet = 4 => throws ReferenceError: exportedLet is not defined
++  readParam() => 1
++Paused at module top-level, initialized:
++  exportedLet => 2
++  importedLet => 2
++  exportedConst => 3
++  typeof ExportedClass => function
++  exportedLet = 4 => 4
++  importedLet => 4
++  exportedConst = 4 => throws TypeError: Assignment to constant variable.
++  importedLet = 5 => throws TypeError: Assignment to constant variable.
++  readParam() => 1
diff --git a/patches/v8/test-inspector-debugger-evaluate-on-call-frame-module-tdz.js.patch b/patches/v8/test-inspector-debugger-evaluate-on-call-frame-module-tdz.js.patch
new file mode 100644
index 00000000..c92f270b
--- /dev/null
+++ b/patches/v8/test-inspector-debugger-evaluate-on-call-frame-module-tdz.js.patch
@@ -0,0 +1,103 @@
+diff --git a/test/inspector/debugger/evaluate-on-call-frame-module-tdz.js b/test/inspector/debugger/evaluate-on-call-frame-module-tdz.js
+new file mode 100644
+index 0000000000000000000000000000000000000000..1ba79b92e8a1917e3305dba43aaf90965ad127d9
+--- /dev/null
++++ b/test/inspector/debugger/evaluate-on-call-frame-module-tdz.js
+@@ -0,0 +1,97 @@
++// Copyright 2026 the V8 project authors. All rights reserved.
++// Use of this source code is governed by a BSD-style license that can be
++// found in the LICENSE file.
++
++const {session, contextGroup, Protocol} = InspectorTest.start(
++    'Tests that Debugger.evaluateOnCallFrame respects the TDZ of module ' +
++    'bindings.');
++
++const moduleName = 'evaluate-on-call-frame-module-tdz.mjs';
++
++// The module imports from itself so that it also has an import binding that
++// is still in its TDZ while the module body runs.
++const moduleSource = `
++import {exportedLet as importedLet} from '${moduleName}';
++
++function host(param) {
++  globalThis.readParam = () => param;
++  debugger;
++}
++host(1);
++debugger;
++
++export let exportedLet = 2;
++export const exportedConst = 3;
++export class ExportedClass {}
++debugger;
++`;
++
++async function evaluate(callFrameId, expression) {
++  const response =
++      await Protocol.Debugger.evaluateOnCallFrame({callFrameId, expression});
++  if (response.error) {
++    InspectorTest.log(`  ${expression} => error ${response.error.message}`);
++    return;
++  }
++  const {result, exceptionDetails} = response.result;
++  if (exceptionDetails) {
++    const [message] = exceptionDetails.exception.description.split('\n');
++    InspectorTest.log(`  ${expression} => throws ${message}`);
++  } else {
++    InspectorTest.log(`  ${expression} => ${result.value}`);
++  }
++}
++
++async function evaluateAllOnPause(title, expressions) {
++  const {params: {callFrames: [{callFrameId}]}} =
++      await Protocol.Debugger.oncePaused();
++  InspectorTest.log(title);
++  for (const expression of expressions) {
++    await evaluate(callFrameId, expression);
++  }
++  await Protocol.Debugger.resume();
++}
++
++(async function test() {
++  await Protocol.Debugger.enable();
++  contextGroup.addModule(moduleSource, moduleName);
++
++  await evaluateAllOnPause('Paused in a function, bindings in TDZ:', [
++    // Reads.
++    'exportedLet',
++    'typeof exportedLet',
++    'exportedConst',
++    'ExportedClass',
++    'importedLet',
++    // Writes.
++    'exportedLet = 4',
++    'exportedConst = 4',
++    'importedLet = 4',
++    // The value of an uninitialized binding must not reach other variables.
++    'param = exportedLet',
++    'param = importedLet, param = 5',
++    'param',
++  ]);
++
++  await evaluateAllOnPause('Paused at module top-level, bindings in TDZ:', [
++    'exportedLet',
++    'importedLet',
++    'exportedLet = 4',
++    'readParam()',
++  ]);
++
++  await evaluateAllOnPause('Paused at module top-level, initialized:', [
++    'exportedLet',
++    'importedLet',
++    'exportedConst',
++    'typeof ExportedClass',
++    'exportedLet = 4',
++    'importedLet',
++    'exportedConst = 4',
++    'importedLet = 5',
++    'readParam()',
++  ]);
++
++  await Protocol.Debugger.disable();
++  InspectorTest.completeTest();
++})();
