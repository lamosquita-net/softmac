#!/bin/bash
# mkpatch <ruta de Chromium> <fichero modificado> : escribe a stdout un parche al estilo de Brave
# (git diff --full-index, a/ b/) del original de 156.0.8078.90 al modificado. Rutas v8/... salen relativas a v8
# (van en patches/v8/).
set -e
p="$1"; mod="$(readlink -f "$2")"; orig=$(b2-cr156 "$p"); r="$p"; case "$p" in v8/*) r="${p#v8/}";; esac
t=$(mktemp -d); mkdir -p "$t/$(dirname "$r")"; cp "$orig" "$t/$r"
( cd "$t" && git init -q && git add -A && git -c user.email=x@x -c user.name=x commit -qm o && cp "$mod" "$t/$r" && git diff --full-index --src-prefix=a/ --dst-prefix=b/ )
rm -rf "$t"
