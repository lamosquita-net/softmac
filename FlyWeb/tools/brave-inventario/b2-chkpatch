#!/bin/bash
# chkpatch <fichero .patch> : comprueba que aplica (git apply --check) sobre los originales de 156.0.8078.90
set -e
pf="$1"; t=$(mktemp -d)
for p in $(grep '^diff --git' "$pf" | awk '{print substr($3,3)}'); do
  case "$pf" in */patches/v8/*) q="v8/$p";; *) q="$p";; esac
  o=$(b2-cr156 "$q") || { echo "NO_EXISTE $q"; exit 1; }; mkdir -p "$t/$(dirname "$p")"; cp "$o" "$t/$p"; done
( cd "$t" && git init -q && git apply --check "$pf" && echo "APLICA $pf" ) || echo "NO_APLICA $pf"
rm -rf "$t"
